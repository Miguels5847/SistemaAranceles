@startuml
title <b><size:20>Diagrama de Secuencia - Simulación de retención por grupo de usuarios</size></b>

skinparam participant {
    FontSize 12
    FontStyle normal
}
skinparam actor {
    FontSize 12
    FontStyle normal
}
skinparam note {
    FontSize 12
}

actor "Planificador"
participant "RetencionViewModel"
participant "SimularRetencionUseCase"
participant "ConfigRetencionRepository"
participant "SimulacionRepository"
participant "DetalleSimulacionRepository"
database "Base de Datos" as db

note over "Planificador","db"
Flujo Principal - Simulación de retención por cohorte
end note

"Planificador" -> "RetencionViewModel": Ejecuta simulación de retención
"RetencionViewModel" -> "SimularRetencionUseCase": Ejecutar(configuracionRetencionId)

"SimularRetencionUseCase" -> "ConfigRetencionRepository": ObtenerConfiguracion(id)
"ConfigRetencionRepository" -> "db": SELECT configuracion_retencion
"db" --> "ConfigRetencionRepository": Configuración (tasas, ciclos, paralelos)
"ConfigRetencionRepository" --> "SimularRetencionUseCase": ConfiguracionRetencionDto

"SimularRetencionUseCase" -> "SimulacionRepository": CrearSimulacion(configuracionId, fechaEjecucion)
"SimulacionRepository" -> "db": INSERT simulacion_retencion
"db" --> "SimulacionRepository": simulacionId

loop Por cada ciclo de retención (1 a totalCiclosRetencion)
    "SimularRetencionUseCase" -> "SimularRetencionUseCase": AplicarTasaRetencion(estudiantesActuales)

    note over "SimularRetencionUseCase"
    Est_ciclo = Est_anterior * TasaRetencion
    end note

    "SimularRetencionUseCase" -> "DetalleSimulacionRepository": GuardarDetalle(simulacionId, ciclo, estudiantes, tasa, zona=retencion)
    "DetalleSimulacionRepository" -> "db": INSERT detalle_simulacion_retencion
end

loop Por cada ciclo de graduación (ciclosRetencion+1 a totalCiclos)
    "SimularRetencionUseCase" -> "SimularRetencionUseCase": AplicarTasaGraduacion(estudiantesActuales)

    note over "SimularRetencionUseCase"
    Est_ciclo = Est_anterior * TasaGraduacion
    end note

    "SimularRetencionUseCase" -> "DetalleSimulacionRepository": GuardarDetalle(simulacionId, ciclo, estudiantes, tasa, zona=graduacion)
    "DetalleSimulacionRepository" -> "db": INSERT detalle_simulacion_retencion
end

"SimularRetencionUseCase" -> "SimularRetencionUseCase": CalcularIndicadores(retencionFinal, graduacionFinal)

"SimularRetencionUseCase" --> "RetencionViewModel": SimulacionDto (detalles + indicadores Ret% y Titu%)
"RetencionViewModel" --> "Planificador": Muestra tabla ciclo a ciclo con indicadores
@enduml