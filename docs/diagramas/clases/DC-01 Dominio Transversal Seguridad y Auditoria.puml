@startuml
top to bottom direction
scale 0.88

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam arrowColor Black
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 16
skinparam ranksep 24

title DC-01: Dominio Transversal - Seguridad y Auditoría

package "Domain" #EFF6FF {
    class Usuario {
        +int Id
        +string NombreCompleto
        +string CorreoInstitucional
        +string HashContrasena
        +string Estado
        +DateTime? UltimoAccesoEn
        +bool EstaActivo
    }

    class Rol {
        +int Id
        +string Nombre
        +string Descripcion
        +bool EstaActivo
    }

    class Permiso {
        +int Id
        +string Codigo
        +string ModuloNombre
        +string AccionNombre
        +string Descripcion
        +bool EstaActivo
    }

    class UsuarioRol {
        +int UsuarioId
        +int RolId
    }

    class RolPermiso {
        +int RolId
        +int PermisoId
    }

    class UsuarioPermisoOverride {
        +int UsuarioId
        +int PermisoId
        +bool Concedido
        +DateTime CreadoEn
        +int? CreadoPorUsuarioId
    }

    class SesionUsuario {
        +int Id
        +int UsuarioId
        +string TokenSesion
        +DateTime EmitidoEn
        +DateTime ExpiraEn
        +DateTime? RevocadoEn
    }

    class AuditoriaLog {
        +int Id
        +DateTime EventoEn
        +string ModuloNombre
        +string EntidadNombre
        +string EntidadId
        +string AccionNombre
        +string ResumenTexto
        +int? EjecutadoPorUsuarioId
    }

    Usuario -[hidden]-> Rol
    Rol -[hidden]-> Permiso
    Permiso -[hidden]-> UsuarioRol
    UsuarioRol -[hidden]-> RolPermiso
    RolPermiso -[hidden]-> UsuarioPermisoOverride
    UsuarioPermisoOverride -[hidden]-> SesionUsuario
    SesionUsuario -[hidden]-> AuditoriaLog
}

package "Application" #F0FDF4 {
    interface IRepositorioUsuario <<Interface>> {
        +ListarAsync() : List~Usuario~
        +ObtenerPorIdAsync(id: int) : Usuario?
        +ObtenerPorCorreoInstitucionalAsync(correo: string) : Usuario?
        +ExisteCorreoInstitucionalAsync(correo: string) : bool
        +AgregarAsync(usuario: Usuario) : void
        +AgregarConRolAsync(usuario: Usuario, rolId: int) : int
        +ActualizarAsync(usuario: Usuario) : void
        +EliminarAsync(id: int, eliminadoPorUsuarioId: int) : void
        +RegistrarUltimoAccesoAsync(id: int, ultimoAccesoEn: DateTime) : void
        +ObtenerRolesDelUsuarioAsync(id: int) : List~string~
    }

    interface IRepositorioSesionUsuario <<Interface>> {
        +CrearAsync(usuarioId: int, tokenSesion: string, expiraEn: DateTime) : int
        +RevocarAsync(tokenSesion: string) : void
        +RevocarTodasDelUsuarioAsync(usuarioId: int) : void
    }

    interface IRepositorioPermiso <<Interface>> {
        +ObtenerPermisosEfectivosAsync(usuarioId: int) : IReadOnlySet~string~
        +ObtenerTodosConEstadoParaUsuarioAsync(usuarioId: int) : List~PermisoConEstadoDto~
        +ObtenerPermisoIdsDeRolAsync(rolId: int) : IReadOnlySet~int~
        +GuardarOverridesAsync(usuarioId: int, overrides: IEnumerable~PermisoOverrideDto~, creadoPorUsuarioId: int) : void
    }

    interface IAuditoriaServicio <<Interface>> {
        +RegistrarAsync(moduloNombre: string, entidadNombre: string, entidadId: string, accionNombre: string, resumenTexto: string, ejecutadoPorUsuarioId: int?) : void
        +ConsultarAsync(filtros: AuditoriaFiltroDto) : AuditoriaConsultaResultadoDto
    }

    class LoginUseCase <<UseCase>> {
        -IRepositorioUsuario _repositorioUsuario
        -IRepositorioSesionUsuario _repositorioSesion
        -IRepositorioPermiso _repositorioPermiso
        -IServicioHash _servicioHash
        -IAuditoriaServicio _auditoriaServicio
        +EjecutarAsync(correo: string, contrasena: string) : SesionDto
    }

    class CerrarSesionUseCase <<UseCase>> {
        -IRepositorioSesionUsuario _repositorioSesion
        -IAuditoriaServicio _auditoriaServicio
        +EjecutarAsync(usuarioId: int, tokenSesion: string) : void
    }

    class CrearUsuarioUseCase <<UseCase>> {
        -IRepositorioUsuario _repositorioUsuario
        -IServicioHash _servicioHash
        -IAuditoriaServicio _auditoriaServicio
        +EjecutarAsync(dto: CrearUsuarioDto) : UsuarioDto
    }

    class ActualizarUsuarioUseCase <<UseCase>> {
        -IRepositorioUsuario _repositorioUsuario
        -IAuditoriaServicio _auditoriaServicio
        +EjecutarAsync(dto: ActualizarUsuarioDto) : void
    }

    class EliminarUsuarioUseCase <<UseCase>> {
        -IRepositorioUsuario _repositorioUsuario
        -IAuditoriaServicio _auditoriaServicio
        +EjecutarAsync(id: int, eliminadoPorUsuarioId: int) : void
    }

    class ListarUsuariosUseCase <<UseCase>> {
        -IRepositorioUsuario _repositorioUsuario
        +EjecutarAsync() : List~UsuarioDto~
    }

    class ObtenerUsuarioUseCase <<UseCase>> {
        -IRepositorioUsuario _repositorioUsuario
        +EjecutarAsync(id: int) : UsuarioDto
    }

    class ObtenerPermisosEfectivosUsuarioUseCase <<UseCase>> {
        -IRepositorioPermiso _repositorioPermiso
        +EjecutarAsync(usuarioId: int) : List~PermisoConEstadoDto~
    }

    class ActualizarPermisosUsuarioUseCase <<UseCase>> {
        -IRepositorioPermiso _repositorioPermiso
        +EjecutarAsync(usuarioId: int, overrides: IEnumerable~PermisoOverrideDto~, ejecutadoPorUsuarioId: int) : void
    }

    class ConsultarAuditoriaUseCase <<UseCase>> {
        -IAuditoriaServicio _auditoriaServicio
        +EjecutarAsync(filtros: AuditoriaFiltroDto) : AuditoriaConsultaResultadoDto
    }

    IRepositorioUsuario -[hidden]-> IRepositorioSesionUsuario
    IRepositorioSesionUsuario -[hidden]-> IRepositorioPermiso
    IRepositorioPermiso -[hidden]-> IAuditoriaServicio
    IAuditoriaServicio -[hidden]-> LoginUseCase
    LoginUseCase -[hidden]-> CerrarSesionUseCase
    CerrarSesionUseCase -[hidden]-> CrearUsuarioUseCase
    CrearUsuarioUseCase -[hidden]-> ActualizarUsuarioUseCase
    ActualizarUsuarioUseCase -[hidden]-> EliminarUsuarioUseCase
    EliminarUsuarioUseCase -[hidden]-> ObtenerPermisosEfectivosUsuarioUseCase
    ObtenerPermisosEfectivosUsuarioUseCase -[hidden]-> ActualizarPermisosUsuarioUseCase
}

package "Infrastructure" #FFF7ED {
    class RepositorioUsuario <<Repository>> {
        -AppDbContext _context
        +ListarAsync() : List~Usuario~
        +ObtenerPorIdAsync(id: int) : Usuario?
        +ObtenerPorCorreoInstitucionalAsync(correo: string) : Usuario?
        +AgregarConRolAsync(usuario: Usuario, rolId: int) : int
        +ActualizarAsync(usuario: Usuario) : void
        +EliminarAsync(id: int, eliminadoPorUsuarioId: int) : void
        +ObtenerRolesDelUsuarioAsync(id: int) : List~string~
    }

    class RepositorioSesionUsuario <<Repository>> {
        -AppDbContext _context
        +CrearAsync(usuarioId: int, tokenSesion: string, expiraEn: DateTime) : int
        +RevocarAsync(tokenSesion: string) : void
        +RevocarTodasDelUsuarioAsync(usuarioId: int) : void
    }

    class RepositorioPermiso <<Repository>> {
        -AppDbContext _context
        +ObtenerPermisosEfectivosAsync(usuarioId: int) : IReadOnlySet~string~
        +ObtenerTodosConEstadoParaUsuarioAsync(usuarioId: int) : List~PermisoConEstadoDto~
        +GuardarOverridesAsync(usuarioId: int, overrides: IEnumerable~PermisoOverrideDto~, creadoPorUsuarioId: int) : void
    }

    class ServicioAuditoria <<Service>> {
        -IRepositorioAuditoriaLog _repositorioAuditoria
        +RegistrarAsync(moduloNombre: string, entidadNombre: string, entidadId: string, accionNombre: string, resumenTexto: string, ejecutadoPorUsuarioId: int?) : void
        +ConsultarAsync(filtros: AuditoriaFiltroDto) : AuditoriaConsultaResultadoDto
    }

    RepositorioUsuario -[hidden]-> RepositorioSesionUsuario
    RepositorioSesionUsuario -[hidden]-> RepositorioPermiso
    RepositorioPermiso -[hidden]-> ServicioAuditoria
}

package "Presentation" #FDF4FF {
    class LoginViewModel <<ViewModel>> {
        +string Correo
        +string Contrasena
        +string MensajeError
        +ICommand LoginCommand
        +ICommand LogoutCommand
        +EjecutarLoginAsync() : void
    }

    class UsuariosViewModel <<ViewModel>> {
        +ObservableCollection~UsuarioDto~ Usuarios
        +UsuarioDto? UsuarioSeleccionado
        +ICommand CrearCommand
        +ICommand EditarCommand
        +ICommand EliminarCommand
        +CargarUsuariosAsync() : void
    }

    class EditarUsuarioViewModel <<ViewModel>> {
        +ICommand GuardarCommand
        +ICommand CancelarCommand
        +ObservableCollection~PermisoConEstadoDto~ Permisos
        +GuardarAsync() : void
    }

    class AuditoriaViewModel <<ViewModel>> {
        +ICommand ConsultarCommand
        +CargarRegistrosAsync() : void
    }

    LoginViewModel -[hidden]-> UsuariosViewModel
    UsuariosViewModel -[hidden]-> EditarUsuarioViewModel
    EditarUsuarioViewModel -[hidden]-> AuditoriaViewModel
}

Domain -[hidden]-> Application
Application -[hidden]-> Infrastructure
Infrastructure -[hidden]-> Presentation

' Relaciones de dominio
Usuario "1" --> "0..*" UsuarioRol : tiene
Rol "1" --> "0..*" UsuarioRol : tiene
Rol "1" --> "0..*" RolPermiso : tiene
Permiso "1" --> "0..*" RolPermiso : tiene
Usuario "1" --> "0..*" UsuarioPermisoOverride : override
Permiso "1" --> "0..*" UsuarioPermisoOverride : override
Usuario "1" --> "0..*" SesionUsuario : tiene
Usuario "1" --> "0..*" AuditoriaLog : genera

' Implementaciones
RepositorioUsuario ..|> IRepositorioUsuario : implementa
RepositorioSesionUsuario ..|> IRepositorioSesionUsuario : implementa
RepositorioPermiso ..|> IRepositorioPermiso : implementa
ServicioAuditoria ..|> IAuditoriaServicio : implementa

' Dependencias de use cases
LoginUseCase --> IRepositorioUsuario : usa
LoginUseCase --> IRepositorioSesionUsuario : usa
LoginUseCase --> IRepositorioPermiso : usa
LoginUseCase --> IAuditoriaServicio : usa
CerrarSesionUseCase --> IRepositorioSesionUsuario : usa
CerrarSesionUseCase --> IAuditoriaServicio : usa
CrearUsuarioUseCase --> IRepositorioUsuario : usa
CrearUsuarioUseCase --> IAuditoriaServicio : usa
ActualizarUsuarioUseCase --> IRepositorioUsuario : usa
ActualizarUsuarioUseCase --> IAuditoriaServicio : usa
EliminarUsuarioUseCase --> IRepositorioUsuario : usa
EliminarUsuarioUseCase --> IAuditoriaServicio : usa
ListarUsuariosUseCase --> IRepositorioUsuario : usa
ObtenerUsuarioUseCase --> IRepositorioUsuario : usa
ObtenerPermisosEfectivosUsuarioUseCase --> IRepositorioPermiso : usa
ActualizarPermisosUsuarioUseCase --> IRepositorioPermiso : usa
ConsultarAuditoriaUseCase --> IAuditoriaServicio : usa

' Dependencias de presentación
LoginViewModel --> LoginUseCase : invoca
LoginViewModel --> CerrarSesionUseCase : invoca
UsuariosViewModel --> ListarUsuariosUseCase : invoca
UsuariosViewModel --> EliminarUsuarioUseCase : invoca
UsuariosViewModel --> CrearUsuarioUseCase : invoca
EditarUsuarioViewModel --> ActualizarUsuarioUseCase : invoca
EditarUsuarioViewModel --> ObtenerPermisosEfectivosUsuarioUseCase : invoca
EditarUsuarioViewModel --> ActualizarPermisosUsuarioUseCase : invoca
AuditoriaViewModel --> ConsultarAuditoriaUseCase : invoca
@enduml