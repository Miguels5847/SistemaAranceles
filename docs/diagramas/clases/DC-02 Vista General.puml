@startuml
top to bottom direction
scale 0.88

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam arrowColor Black
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 20
skinparam ranksep 30

title DC-02 Vista General: Dominio Académico - Retención, Estudiantes, Inflación

package "Domain" #EFF6FF {
    class Carrera
    class EscenarioProyeccion
    class PeriodoAcademico
    class InflacionAnual
    class InflacionProyectada
    class ConfiguracionRetencion
    class CriterioReferenciaRetencion
    class SimulacionRetencion
    class DetalleSimulacionRetencion
    class ProyeccionEstudiantes
    class DetalleProyeccionEstudiantes
    class ConfiguracionCargaDocente
    class ProyeccionRequerimientoDocente

    Carrera -[hidden]-> EscenarioProyeccion
    EscenarioProyeccion -[hidden]-> PeriodoAcademico
    PeriodoAcademico -[hidden]-> InflacionAnual
    InflacionAnual -[hidden]-> InflacionProyectada
    InflacionProyectada -[hidden]-> ConfiguracionRetencion
    ConfiguracionRetencion -[hidden]-> CriterioReferenciaRetencion
    CriterioReferenciaRetencion -[hidden]-> SimulacionRetencion
    SimulacionRetencion -[hidden]-> DetalleSimulacionRetencion
    DetalleSimulacionRetencion -[hidden]-> ProyeccionEstudiantes
    ProyeccionEstudiantes -[hidden]-> DetalleProyeccionEstudiantes
    DetalleProyeccionEstudiantes -[hidden]-> ConfiguracionCargaDocente
    ConfiguracionCargaDocente -[hidden]-> ProyeccionRequerimientoDocente
}

package "Application" #F0FDF4 {
    interface ICarreraRepository <<Interface>>
    interface IEscenarioRepository <<Interface>>
    interface IRepositorioInflacionAnual <<Interface>>
    interface IRetencionRepository <<Interface>>
    interface ISimulacionRetencionRepository <<Interface>>
    interface IProyeccionEstudiantesRepository <<Interface>>
    interface IRequerimientoDocenteRepository <<Interface>>
    class ProyectarInflacionUseCase <<UseCase>>
    class SimularRetencionUseCase <<UseCase>>
    class ProyectarEstudiantesUseCase <<UseCase>>

    ICarreraRepository -[hidden]-> IRepositorioInflacionAnual
    IRepositorioInflacionAnual -[hidden]-> IRetencionRepository
    IRetencionRepository -[hidden]-> IProyeccionEstudiantesRepository
    IProyeccionEstudiantesRepository -[hidden]-> ProyectarInflacionUseCase
    ProyectarInflacionUseCase -[hidden]-> SimularRetencionUseCase
    SimularRetencionUseCase -[hidden]-> ProyectarEstudiantesUseCase
}

package "Infrastructure" #FFF7ED {
    class CarreraRepository <<Repository>>
    class RepositorioInflacionAnual <<Repository>>
    class RetencionRepository <<Repository>>
    class SimulacionRetencionRepository <<Repository>>
    class ProyeccionEstudiantesRepository <<Repository>>
    class RequerimientoDocenteRepository <<Repository>>

    CarreraRepository -[hidden]-> RepositorioInflacionAnual
    RepositorioInflacionAnual -[hidden]-> RetencionRepository
    RetencionRepository -[hidden]-> SimulacionRetencionRepository
    SimulacionRetencionRepository -[hidden]-> ProyeccionEstudiantesRepository
    ProyeccionEstudiantesRepository -[hidden]-> RequerimientoDocenteRepository
}

package "Presentation" #FDF4FF {
    class InflacionViewModel <<ViewModel>>
    class RetencionViewModel <<ViewModel>>
    class EstudiantesViewModel <<ViewModel>>

    InflacionViewModel -[hidden]-> RetencionViewModel
    RetencionViewModel -[hidden]-> EstudiantesViewModel
}

Domain -[hidden]-> Application
Application -[hidden]-> Infrastructure
Infrastructure -[hidden]-> Presentation

' Relaciones de dominio
Carrera "1" --> "0..*" EscenarioProyeccion : tiene
EscenarioProyeccion "1" --> "0..*" InflacionProyectada : genera
EscenarioProyeccion "1" --> "0..*" ConfiguracionRetencion : tiene
EscenarioProyeccion "1" --> "0..*" ProyeccionEstudiantes : tiene
ConfiguracionRetencion "1" --> "0..*" SimulacionRetencion : origina
SimulacionRetencion "1" --> "0..*" DetalleSimulacionRetencion : contiene
ProyeccionEstudiantes "1" --> "0..*" DetalleProyeccionEstudiantes : contiene
ProyeccionEstudiantes "1" --> "1" ConfiguracionCargaDocente : tiene
ConfiguracionCargaDocente "1" --> "0..*" ProyeccionRequerimientoDocente : genera

' Implementaciones
CarreraRepository ..|> ICarreraRepository : implementa
RepositorioInflacionAnual ..|> IRepositorioInflacionAnual : implementa
RetencionRepository ..|> IRetencionRepository : implementa
SimulacionRetencionRepository ..|> ISimulacionRetencionRepository : implementa
ProyeccionEstudiantesRepository ..|> IProyeccionEstudiantesRepository : implementa
RequerimientoDocenteRepository ..|> IRequerimientoDocenteRepository : implementa

' Dependencias de casos de uso
ProyectarInflacionUseCase --> IRepositorioInflacionAnual : usa
SimularRetencionUseCase --> IRetencionRepository : usa
SimularRetencionUseCase --> ISimulacionRetencionRepository : usa
ProyectarEstudiantesUseCase --> IProyeccionEstudiantesRepository : usa
ProyectarEstudiantesUseCase --> IRequerimientoDocenteRepository : usa

' Dependencias de presentación
InflacionViewModel --> ProyectarInflacionUseCase : invoca
RetencionViewModel --> SimularRetencionUseCase : invoca
EstudiantesViewModel --> ProyectarEstudiantesUseCase : invoca
@enduml