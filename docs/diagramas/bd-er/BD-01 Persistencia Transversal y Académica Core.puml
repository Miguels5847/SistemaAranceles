erDiagram
    usuario {
        int id PK
        text nombre_completo
        text correo_institucional
        text hash_contrasena
        text estado
        bool esta_activo
        timestamp ultimo_acceso_en
    }
    rol {
        int id PK
        text nombre
        text descripcion
        bool esta_activo
    }
    permiso {
        int id PK
        text codigo
        text modulo_nombre
        text accion_nombre
        bool esta_activo
    }
    usuario_rol {
        int usuario_id FK
        int rol_id FK
    }
    rol_permiso {
        int rol_id FK
        int permiso_id FK
    }
    usuario_permiso_override {
        int id PK
        int usuario_id FK
        int permiso_id FK
        bool concedido
        text motivo
        timestamp creado_en
    }
    sesion_usuario {
        int id PK
        int usuario_id FK
        text token_sesion
        timestamp emitido_en
        timestamp expira_en
        timestamp revocado_en
    }
    auditoria_log {
        int id PK
        int ejecutado_por_usuario_id FK
        timestamp evento_en
        text modulo_nombre
        text entidad_nombre
        text entidad_id
        text accion_nombre
        text resumen_texto
        text valores_anteriores_json
        text valores_nuevos_json
    }
    carrera {
        int id PK
        text codigo
        text nombre
        text facultad_nombre
        int total_ciclos
        bool esta_activo
    }
    escenario_proyeccion {
        int id PK
        int carrera_id FK
        text nombre
        bool es_predeterminado
        bool esta_activo
    }
    periodo_academico {
        int id PK
        int anio
        int numero_periodo
        text etiqueta_periodo
        bool esta_activo
    }

    usuario ||--o{ usuario_rol : ""
    rol ||--o{ usuario_rol : ""
    rol ||--o{ rol_permiso : ""
    permiso ||--o{ rol_permiso : ""
    usuario ||--o{ usuario_permiso_override : ""
    permiso ||--o{ usuario_permiso_override : ""
    usuario ||--o{ sesion_usuario : ""
    usuario ||--o{ auditoria_log : "ejecutado_por"
    carrera ||--o{ escenario_proyeccion : ""

