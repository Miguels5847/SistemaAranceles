@startuml
top to bottom direction
scale 0.88

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam arrowColor Black
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 20
skinparam ranksep 30

title DC-02 Vista General: Dominio Académico - Retención, Estudiantes, Inflación

package "Domain" #EFF6FF {
    class Carrera
    class EscenarioProyeccion
    class InflacionAnual
    class InflacionProyectada
    class ConfiguracionRetencion
    class CriterioReferenciaRetencion
    class SimulacionRetencion
    class DetalleSimulacionRetencion
    class ProyeccionEstudiantes
    class DetalleProyeccionEstudiantes
    class OverrideHorasPeriodo

    Carrera -[hidden]-> EscenarioProyeccion
    EscenarioProyeccion -[hidden]-> InflacionAnual
    InflacionAnual -[hidden]-> InflacionProyectada
    InflacionProyectada -[hidden]-> ConfiguracionRetencion
    ConfiguracionRetencion -[hidden]-> CriterioReferenciaRetencion
    CriterioReferenciaRetencion -[hidden]-> SimulacionRetencion
    SimulacionRetencion -[hidden]-> DetalleSimulacionRetencion
    DetalleSimulacionRetencion -[hidden]-> ProyeccionEstudiantes
    ProyeccionEstudiantes -[hidden]-> DetalleProyeccionEstudiantes
    DetalleProyeccionEstudiantes -[hidden]-> OverrideHorasPeriodo
}

package "Application" #F0FDF4 {
    interface IRepositorioCarrera <<Interface>>
    interface IRepositorioInflacionAnual <<Interface>>
    interface IRepositorioConfiguracionRetencion <<Interface>>
    interface IRepositorioSimulacionRetencion <<Interface>>
    interface IRepositorioProyeccionEstudiantes <<Interface>>
    interface IRepositorioOverrideHorasPeriodo <<Interface>>
    class ProyectarInflacionUseCase <<UseCase>>
    class SimularRetencionUseCase <<UseCase>>
    class ConsolidadorProyeccionEstudiantes <<Service>>

    IRepositorioCarrera -[hidden]-> IRepositorioInflacionAnual
    IRepositorioInflacionAnual -[hidden]-> IRepositorioConfiguracionRetencion
    IRepositorioConfiguracionRetencion -[hidden]-> IRepositorioProyeccionEstudiantes
    IRepositorioProyeccionEstudiantes -[hidden]-> IRepositorioOverrideHorasPeriodo
    IRepositorioOverrideHorasPeriodo -[hidden]-> ProyectarInflacionUseCase
    ProyectarInflacionUseCase -[hidden]-> SimularRetencionUseCase
    SimularRetencionUseCase -[hidden]-> ConsolidadorProyeccionEstudiantes
}

package "Infrastructure" #FFF7ED {
    class RepositorioCarrera <<Repository>>
    class RepositorioInflacionAnual <<Repository>>
    class RepositorioConfiguracionRetencion <<Repository>>
    class RepositorioSimulacionRetencion <<Repository>>
    class RepositorioProyeccionEstudiantes <<Repository>>
    class RepositorioOverrideHorasPeriodo <<Repository>>

    RepositorioCarrera -[hidden]-> RepositorioInflacionAnual
    RepositorioInflacionAnual -[hidden]-> RepositorioConfiguracionRetencion
    RepositorioConfiguracionRetencion -[hidden]-> RepositorioSimulacionRetencion
    RepositorioSimulacionRetencion -[hidden]-> RepositorioProyeccionEstudiantes
    RepositorioProyeccionEstudiantes -[hidden]-> RepositorioOverrideHorasPeriodo
}

package "Presentation" #FDF4FF {
    class InflacionViewModel <<ViewModel>>
    class ConfiguracionRetencionViewModel <<ViewModel>>
    class SimulacionRetencionViewModel <<ViewModel>>
    class EstudiantesViewModel <<ViewModel>>

    InflacionViewModel -[hidden]-> ConfiguracionRetencionViewModel
    ConfiguracionRetencionViewModel -[hidden]-> SimulacionRetencionViewModel
    SimulacionRetencionViewModel -[hidden]-> EstudiantesViewModel
}

Domain -[hidden]-> Application
Application -[hidden]-> Infrastructure
Infrastructure -[hidden]-> Presentation

' Relaciones de dominio
Carrera "1" --> "0..*" EscenarioProyeccion : tiene
EscenarioProyeccion "1" --> "0..*" InflacionProyectada : genera
EscenarioProyeccion "1" --> "0..*" ConfiguracionRetencion : tiene
EscenarioProyeccion "1" --> "0..*" ProyeccionEstudiantes : tiene
ConfiguracionRetencion "1" --> "0..*" SimulacionRetencion : origina
SimulacionRetencion "1" --> "0..*" DetalleSimulacionRetencion : contiene
ProyeccionEstudiantes "1" --> "0..*" DetalleProyeccionEstudiantes : contiene
ProyeccionEstudiantes "1" --> "0..*" OverrideHorasPeriodo : ajusta

' Implementaciones
RepositorioCarrera ..|> IRepositorioCarrera : implementa
RepositorioInflacionAnual ..|> IRepositorioInflacionAnual : implementa
RepositorioConfiguracionRetencion ..|> IRepositorioConfiguracionRetencion : implementa
RepositorioSimulacionRetencion ..|> IRepositorioSimulacionRetencion : implementa
RepositorioProyeccionEstudiantes ..|> IRepositorioProyeccionEstudiantes : implementa
RepositorioOverrideHorasPeriodo ..|> IRepositorioOverrideHorasPeriodo : implementa

' Dependencias de casos de uso
ProyectarInflacionUseCase --> IRepositorioInflacionAnual : usa
SimularRetencionUseCase --> IRepositorioConfiguracionRetencion : usa
SimularRetencionUseCase --> IRepositorioSimulacionRetencion : usa
ConsolidadorProyeccionEstudiantes --> IRepositorioProyeccionEstudiantes : usa
ConsolidadorProyeccionEstudiantes --> IRepositorioOverrideHorasPeriodo : usa

' Nota: el requerimiento docente NO es una entidad persistida; lo calcula
' ConsolidadorProyeccionEstudiantes (desglose PhD/Mgs/Medio Tiempo/Parcial)
' y se materializa como ProyeccionCargoFacultad en el dominio operativo (DC-03).

' Dependencias de presentación
InflacionViewModel --> ProyectarInflacionUseCase : invoca
SimulacionRetencionViewModel --> SimularRetencionUseCase : invoca
EstudiantesViewModel --> ConsolidadorProyeccionEstudiantes : invoca
@enduml
