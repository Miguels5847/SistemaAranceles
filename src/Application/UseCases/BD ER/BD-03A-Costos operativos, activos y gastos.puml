erDiagram
    %% ── EF CORE MANAGED (tienen entidad C# + migración) ──────────────────────
    carrera {
        int id PK
        text codigo
        text nombre
        int total_ciclos
    }
    escenario_proyeccion {
        int id PK
        int carrera_id FK
        text nombre
    }
    periodo_academico {
        int id PK
        int anio
        int numero_periodo
        text etiqueta_periodo
        date fecha_inicio
        date fecha_fin
    }

    cargo_facultad {
        int id PK
        int carrera_id FK
        text nombre_cargo
        text tipo_cargo
        numeric sueldo_base_mensual
        bool es_cargo_docente
    }
    proyeccion_cargo_facultad {
        int id PK
        int cargo_facultad_id FK
        int periodo_academico_id FK
        numeric cantidad_personas
        numeric factor_ponderacion
        numeric factor_inflacion
        numeric costo_total_semestre
    }

    cargo_planta_central {
        int id PK
        text nombre_cargo
        numeric sueldo_mensual_total
    }
    proyeccion_cargo_planta_central {
        int id PK
        int cargo_planta_central_id FK
        int carrera_id FK
        int periodo_academico_id FK
        numeric proporcion_asignacion
        numeric costo_total_semestre
    }

    item_material_insumo {
        int id PK
        int carrera_id FK
        text nombre_item
        text categoria_nombre
        text unidad_nombre
        numeric cantidad_base
        numeric precio_unitario
        bool es_cantidad_fija
    }
    proyeccion_material_insumo {
        int id PK
        int item_material_insumo_id FK
        int periodo_academico_id FK
        numeric cantidad_proyectada
        numeric factor_inflacion
        numeric costo_total_proyectado
    }

    configuracion_arancel {
        int id PK
        int carrera_id FK
        int escenario_proyeccion_id FK
        numeric valor_arancel
        numeric valor_matricula
        text tipo_origen
    }

    presupuesto_institucional {
        int id PK
        text tipo_presupuesto
        numeric valor_anual_base
        bool ajustable_por_inflacion
    }

    %% ── NO IMPLEMENTADAS en EF Core (sin entidad C# ni migración) ─────────────
    %% Nota: las tablas siguientes están diseñadas en diagramas DC-03.2 y DC-04.1
    %% pero carecen de entidad C# y DbSet en ContextoAplicacion. Pendiente KAN.

    categoria_activo {
        int id PK
        text nombre
        int vida_util_anios
        numeric valor_residual_porcentaje
    }
    activo_fijo {
        int id PK
        int escenario_proyeccion_id FK
        int categoria_activo_id FK
        text tipo_origen
        numeric cantidad
        numeric valor_unitario
        int periodo_academico_id FK
    }
    activo_diferido {
        int id PK
        int escenario_proyeccion_id FK
        text nombre_rubro
        numeric valor
        numeric tasa_amortizacion_anual
    }
    servicio_basico_mantenimiento {
        int id PK
        text tipo_rubro
        text nombre_rubro
        numeric costo_anual_universidad
    }
    configuracion_capital_trabajo {
        int id PK
        int escenario_proyeccion_id FK
        int meses_capital_trabajo
        numeric porcentaje_imprevistos
        int total_estudiantes_universidad
    }
    costo_gasto_periodo {
        int id PK
        int escenario_proyeccion_id FK
        int periodo_academico_id FK
        numeric total_sueldos_facultad
        numeric total_depreciacion
        numeric total_con_imprevistos
        numeric arancel_propuesto
    }

