erDiagram
    carrera {
        int id PK
        text codigo
        text nombre
        int total_ciclos
    }

    escenario_proyeccion {
        int id PK
        int carrera_id FK
        text nombre
    }

    periodo_academico {
        int id PK
        int anio
        int numero_periodo
    }

    configuracion_tmr {
        int id PK
        int escenario_proyeccion_id FK
        numeric tasa_bancaria_porcentaje
        numeric premio_riesgo_porcentaje
        numeric inflacion_promedio_porcentaje
        numeric tmr_calculada_porcentaje
        text metodo_calculo
    }

    configuracion_financiamiento {
        int id PK
        int escenario_proyeccion_id FK
        numeric porcentaje_recursos_propios
        numeric porcentaje_credito
        numeric monto_propio
        numeric monto_credito
        numeric tasa_interes_anual
        int plazo_anios
    }

    amortizacion_cuota {
        int id PK
        int configuracion_financiamiento_id FK
        int numero_cuota
        numeric saldo_capital
        numeric amortizacion_capital
        numeric interes_cuota
        numeric interes_acumulado
        numeric cuota_total
    }

    resultado_analisis_financiero {
        int id PK
        int escenario_proyeccion_id FK
        numeric tir_porcentaje
        numeric van_valor
        numeric punto_equilibrio_estudiantes
        numeric periodo_recuperacion_anios
        bool es_viable
    }

    balance_proyectado {
        int id PK
        int escenario_proyeccion_id FK
        int anio
        numeric caja_bancos
        numeric inventario_materiales
        numeric activos_fijos_brutos
        numeric depreciacion_acumulada
        numeric activos_fijos_netos
        numeric total_activo
        numeric prestamos_por_pagar
        numeric intereses_por_pagar
        numeric total_pasivo
        numeric capital_propio
        numeric utilidad_acumulada
        numeric total_patrimonio
        numeric total_pasivo_patrimonio
        bool cuadra_balance
    }

    resumen_proyeccion_financiera {
        int id PK
        int carrera_id FK
        int escenario_proyeccion_id FK
        int periodo_academico_id FK
        numeric ingreso_total
        numeric costo_total
        numeric gasto_total
        numeric resultado_operacional
        numeric resultado_neto_total
        numeric flujo_caja_operacional
        numeric flujo_caja_inversion
        numeric flujo_caja_financiamiento
        numeric flujo_caja_neto
        numeric arancel_promedio
        numeric estudiantes_totales
        numeric punto_equilibrio
    }

    escenario_proyeccion ||--o{ configuracion_tmr : ""
    escenario_proyeccion ||--o{ configuracion_financiamiento : ""
