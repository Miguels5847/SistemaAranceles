@startuml
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

skinparam actor {
    BorderColor Black
}

left to right direction

actor "Administrador" as admin
actor "Sistema" as sistema

rectangle "Sistema de Cálculo de Aranceles" {
    usecase "Consultar log\nde auditoría" as UC04b
    usecase "Registrar acción\ncrítica automáticamente" as UC04a
    usecase "Capturar datos\nde la acción" as UC04c
    usecase "Filtrar registros" as UC04d
    usecase "Paginar resultados" as UC04e

    admin --> UC04b
    sistema --> UC04a

    UC04b ..> UC04d : <<include>>
    UC04b ..> UC04e : <<extend>>

    UC04a ..> UC04c : <<include>>
}

note bottom of UC04a
    RF-US-04: Registrar log
    de acciones críticas.
    Inmutable e inalterable.
end note
@enduml