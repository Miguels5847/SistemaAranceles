@startuml
top to bottom direction
scale 0.88

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam arrowColor Black
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 16
skinparam ranksep 24

title DC-01.3: RBAC y Permisos\n(ver DC-01.1 para autenticación · DC-01.2 para gestión de usuarios)

package "Domain" #EFF6FF {
    class Usuario {
        +int Id
        +string NombreCompleto
        ' ver DC-01.2 para atributos completos
    }
    class Rol {
        +int Id
        +string Nombre
        +string Descripcion
        +bool EstaActivo
    }
    class Permiso {
        +int Id
        +string Codigo
        +string ModuloNombre
        +string AccionNombre
        +string Descripcion
        +bool EstaActivo
    }
    class UsuarioRol {
        +int UsuarioId
        +int RolId
    }
    class RolPermiso {
        +int RolId
        +int PermisoId
    }
    class UsuarioPermisoOverride {
        +int UsuarioId
        +int PermisoId
        +bool Concedido
        +DateTime CreadoEn
        +int? CreadoPorUsuarioId
    }

    note bottom of UsuarioPermisoOverride
        Concedido=true → fuerza permiso aunque el rol no lo tenga
        Concedido=false → revoca permiso aunque el rol lo tenga
    end note

    Usuario -[hidden]-> Rol
    Rol -[hidden]-> Permiso
    Permiso -[hidden]-> UsuarioRol
    UsuarioRol -[hidden]-> RolPermiso
    RolPermiso -[hidden]-> UsuarioPermisoOverride
}

package "Application" #F0FDF4 {
    interface IRepositorioPermiso <<Interface>> {
        +ObtenerPermisosEfectivosAsync(usuarioId: int) : IReadOnlySet~string~
        +ObtenerTodosConEstadoParaUsuarioAsync(usuarioId: int) : List~PermisoConEstadoDto~
        +ObtenerPermisoIdsDeRolAsync(rolId: int) : IReadOnlySet~int~
        +GuardarOverridesAsync(usuarioId: int, overrides: IEnumerable~PermisoOverrideDto~, creadoPorUsuarioId: int) : void
    }

    class ObtenerPermisosEfectivosUsuarioUseCase <<UseCase>> {
        -IRepositorioPermiso _repositorioPermiso
        +EjecutarAsync(usuarioId: int) : List~PermisoConEstadoDto~
    }
    class ActualizarPermisosUsuarioUseCase <<UseCase>> {
        -IRepositorioPermiso _repositorioPermiso
        +EjecutarAsync(usuarioId: int, overrides: IEnumerable~PermisoOverrideDto~, ejecutadoPorUsuarioId: int) : void
    }

    IRepositorioPermiso -[hidden]-> ObtenerPermisosEfectivosUsuarioUseCase
    ObtenerPermisosEfectivosUsuarioUseCase -[hidden]-> ActualizarPermisosUsuarioUseCase
}

package "Infrastructure" #FFF7ED {
    class RepositorioPermiso <<Repository>> {
        -AppDbContext _context
        +ObtenerPermisosEfectivosAsync(usuarioId: int) : IReadOnlySet~string~
        +ObtenerTodosConEstadoParaUsuarioAsync(usuarioId: int) : List~PermisoConEstadoDto~
        +ObtenerPermisoIdsDeRolAsync(rolId: int) : IReadOnlySet~int~
        +GuardarOverridesAsync(usuarioId: int, overrides: IEnumerable~PermisoOverrideDto~, creadoPorUsuarioId: int) : void
    }

    note right of RepositorioPermiso
        ObtenerPermisosEfectivosAsync aplica:
        permisos_rol MINUS overrides_revocados
        UNION overrides_concedidos
    end note
}

package "Presentation" #FDF4FF {
    class EditarUsuarioViewModel <<ViewModel>> {
        +ObservableCollection~PermisoConEstadoDto~ Permisos
        +ICommand GuardarPermisosCommand
        +CargarPermisosAsync(usuarioId: int) : void
        +GuardarAsync() : void
    }
}

Domain -[hidden]-> Application
Application -[hidden]-> Infrastructure
Infrastructure -[hidden]-> Presentation

' Dominio
Usuario "1" --> "0..*" UsuarioRol : tiene
Rol "1" --> "0..*" UsuarioRol : tiene
Rol "1" --> "0..*" RolPermiso : tiene
Permiso "1" --> "0..*" RolPermiso : tiene
Usuario "1" --> "0..*" UsuarioPermisoOverride : override
Permiso "1" --> "0..*" UsuarioPermisoOverride : override

' Implementaciones
RepositorioPermiso ..|> IRepositorioPermiso : implementa

' Use cases
ObtenerPermisosEfectivosUsuarioUseCase --> IRepositorioPermiso : usa
ActualizarPermisosUsuarioUseCase --> IRepositorioPermiso : usa

' Presentación
EditarUsuarioViewModel --> ObtenerPermisosEfectivosUsuarioUseCase : invoca
EditarUsuarioViewModel --> ActualizarPermisosUsuarioUseCase : invoca
@enduml
