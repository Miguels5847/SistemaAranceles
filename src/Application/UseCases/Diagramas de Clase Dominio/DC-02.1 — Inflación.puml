@startuml DC-02.1-Inflacion
top to bottom direction
scale 0.85

skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam arrowColor Black
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 20

title DC-02.1: Inflación

package "Domain" #EFF6FF {
    class InflacionAnual {
        +int Id
        +int Anio
        +decimal PorcentajeInflacion
        +string FuenteNombre
        +string TipoFuente
    }
    class InflacionProyectada {
        +int Id
        +int EscenarioProyeccionId
        +int Anio
        +decimal PorcentajeInflacion
        +string MetodoProyeccion
        +bool EsAjusteManual
    }
    class Carrera {
        +int Id
        +string Codigo
        +string Nombre
        +string FacultadNombre
        +int TotalCiclos
        +bool EstaActivo
    }
    class EscenarioProyeccion {
        +int Id
        +int CarreraId
        +string Nombre
        +string Descripcion
        +bool EsPredeterminado
        +bool EstaActivo
    }

    InflacionAnual -[hidden]-> InflacionProyectada
    Carrera -[hidden]-> EscenarioProyeccion
}

package "Application" #F0FDF4 {
    interface IRepositorioInflacionAnual <<Interface>> {
        +ListarAsync() : List~InflacionAnual~
        +ObtenerPorAnioAsync(anio: int) : InflacionAnual?
        +AgregarAsync(entidad, usuarioId) : void
        +ActualizarAsync(entidad, usuarioId) : void
        +EliminarPorIdAsync(id: int) : void
        +LimpiarTodoAsync() : (int anuales, int proyectadas)
    }
    interface IRepositorioInflacionProyectada <<Interface>> {
        +ListarPorEscenarioAsync(escenarioId: int) : List~InflacionProyectada~
        +ObtenerPorAnioYEscenarioAsync(anio, escId) : InflacionProyectada?
        +AgregarAsync(entidad) : void
        +EliminarTodoAsync() : int
    }
    interface ICarreraRepository <<Interface>> {
        +ObtenerPorIdAsync(id: int) : Carrera?
        +ListarAsync() : List~Carrera~
        +AgregarAsync(entidad, usuarioId) : void
        +ActualizarAsync(entidad, usuarioId) : void
        +EliminarAsync(id: int, usuarioId) : void
    }
    interface IEscenarioRepository <<Interface>> {
        +ObtenerPorCarreraAsync(carreraId: int) : List~EscenarioProyeccion~
        +ObtenerPorIdAsync(id: int) : EscenarioProyeccion?
        +AgregarAsync(entidad, usuarioId) : void
        +ActualizarAsync(entidad, usuarioId) : void
        +EliminarAsync(id: int, usuarioId) : void
    }

    class CrearInflacionAnualUseCase <<UseCase>> {
        +EjecutarAsync(dto, usuarioId) : void
    }
    class ActualizarInflacionAnualUseCase <<UseCase>> {
        +EjecutarAsync(dto, usuarioId) : void
    }
    class EliminarInflacionAnualUseCase <<UseCase>> {
        +EjecutarAsync(id, usuarioId) : void
    }
    class ListarInflacionAnualUseCase <<UseCase>> {
        +EjecutarAsync() : List~InflacionAnualDto~
    }
    class ProyectarInflacionUseCase <<UseCase>> {
        +EjecutarAsync(solicitud: ProyeccionInflacionSolicitudDto, usuarioId) : ProyeccionInflacionResultadoDto
    }
    class ObtenerInflacionProyectadaParaDependientesUseCase <<UseCase>> {
        +EjecutarAsync(anioDesde, anioHasta) : List~InflacionProyectadaDto~
    }
    class ImportarInflacionBceArchivoUseCase <<UseCase>> {
        +EjecutarAsync(solicitud: ImportacionBceArchivoSolicitudDto, usuarioId) : ImportacionInflacionResultadoDto
    }
    class LimpiarInflacionUseCase <<UseCase>> {
        +EjecutarAsync(usuarioId) : LimpiarInflacionResultadoDto
    }

    IRepositorioInflacionAnual -[hidden]-> IRepositorioInflacionProyectada
    ICarreraRepository -[hidden]-> IEscenarioRepository
    CrearInflacionAnualUseCase -[hidden]-> ActualizarInflacionAnualUseCase
    ActualizarInflacionAnualUseCase -[hidden]-> EliminarInflacionAnualUseCase
    EliminarInflacionAnualUseCase -[hidden]-> ListarInflacionAnualUseCase
    ListarInflacionAnualUseCase -[hidden]-> ProyectarInflacionUseCase
    ProyectarInflacionUseCase -[hidden]-> ObtenerInflacionProyectadaParaDependientesUseCase
    ObtenerInflacionProyectadaParaDependientesUseCase -[hidden]-> ImportarInflacionBceArchivoUseCase
    ImportarInflacionBceArchivoUseCase -[hidden]-> LimpiarInflacionUseCase
}

package "Infrastructure" #FFF7ED {
    class RepositorioInflacionAnual <<Repository>> {
        -AppDbContext _context
        +ListarAsync() : List~InflacionAnual~
        +ObtenerPorAnioAsync(anio: int) : InflacionAnual?
        +AgregarAsync(entidad, usuarioId) : void
        +ActualizarAsync(entidad, usuarioId) : void
        +EliminarPorIdAsync(id: int) : void
        +LimpiarTodoAsync() : (int, int)
    }
    class RepositorioInflacionProyectada <<Repository>> {
        -AppDbContext _context
        +ListarPorEscenarioAsync(escenarioId) : List~InflacionProyectada~
        +ObtenerPorAnioYEscenarioAsync(anio, escId) : InflacionProyectada?
        +AgregarAsync(entidad) : void
        +EliminarTodoAsync() : int
    }

    RepositorioInflacionAnual -[hidden]-> RepositorioInflacionProyectada
}

package "Presentation" #FDF4FF {
    class InflacionViewModel <<ViewModel>> {
        +ICommand ProyectarCommand
        +ICommand CrearCommand
        +ICommand ActualizarCommand
        +ICommand EliminarCommand
        +ICommand ImportarBceArchivoCommand
        +ICommand LimpiarCommand
        +CargarListaAsync() : void
    }
}

Domain -[hidden]-> Application
Application -[hidden]-> Infrastructure
Infrastructure -[hidden]-> Presentation

' Relaciones de dominio
Carrera "1" --> "0..*" EscenarioProyeccion : tiene
EscenarioProyeccion "1" --> "0..*" InflacionProyectada : genera

' Implementaciones
RepositorioInflacionAnual ..|> IRepositorioInflacionAnual : implementa
RepositorioInflacionProyectada ..|> IRepositorioInflacionProyectada : implementa

' Dependencias use cases → repositorios
CrearInflacionAnualUseCase --> IRepositorioInflacionAnual : usa
ActualizarInflacionAnualUseCase --> IRepositorioInflacionAnual : usa
EliminarInflacionAnualUseCase --> IRepositorioInflacionAnual : usa
ListarInflacionAnualUseCase --> IRepositorioInflacionAnual : usa
ProyectarInflacionUseCase --> IRepositorioInflacionAnual : usa
ObtenerInflacionProyectadaParaDependientesUseCase --> IRepositorioInflacionProyectada : usa
ImportarInflacionBceArchivoUseCase --> IRepositorioInflacionAnual : usa
LimpiarInflacionUseCase --> IRepositorioInflacionAnual : usa

' Dependencias presentación
InflacionViewModel --> CrearInflacionAnualUseCase : invoca
InflacionViewModel --> ActualizarInflacionAnualUseCase : invoca
InflacionViewModel --> EliminarInflacionAnualUseCase : invoca
InflacionViewModel --> ListarInflacionAnualUseCase : invoca
InflacionViewModel --> ProyectarInflacionUseCase : invoca
InflacionViewModel --> ImportarInflacionBceArchivoUseCase : invoca
InflacionViewModel --> LimpiarInflacionUseCase : invoca
@enduml
