@startuml
top to bottom direction
scale 0.88

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam arrowColor Black
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 16
skinparam ranksep 24

title DC-02.3: Estudiantes y Docentes

package "Domain" #EFF6FF {
    class EscenarioProyeccion {
        +int Id
        +int CarreraId
        +string Nombre
        +bool EsPredeterminado
        +bool EstaActivo
    }
    class PeriodoAcademico {
        +int Id
        +int Anio
        +int NumeroPeriodo
        +string EtiquetaPeriodo
        +DateTime FechaInicio
        +DateTime FechaFin
    }
    class ProyeccionEstudiantes {
        +int Id
        +int CarreraId
        +int EscenarioProyeccionId
        +int AnioBase
        +int SemanasPorSemestre
    }
    class DetalleProyeccionEstudiantes {
        +int Id
        +int ProyeccionEstudiantesId
        +int PeriodoAcademicoId
        +int NumeroCiclo
        +int CantidadParalelos
        +decimal TotalEstudiantes
    }
    class ConfiguracionCargaDocente {
        +int Id
        +int ProyeccionEstudiantesId
        +decimal HorasDocenciaEstandar
        +decimal HorasTecnicoEstandar
        +decimal ProporcionPhd
        +decimal ProporcionMgs
    }
    class ProyeccionRequerimientoDocente {
        +int Id
        +int ConfiguracionCargaDocenteId
        +int PeriodoAcademicoId
        +decimal TotalDocentes
        +decimal DocentesPhd
        +decimal DocentesMgs
        +decimal DocentesParcial
        +decimal DocentesTecnico
    }

    EscenarioProyeccion -[hidden]-> PeriodoAcademico
    PeriodoAcademico -[hidden]-> ProyeccionEstudiantes
    ProyeccionEstudiantes -[hidden]-> DetalleProyeccionEstudiantes
    DetalleProyeccionEstudiantes -[hidden]-> ConfiguracionCargaDocente
    ConfiguracionCargaDocente -[hidden]-> ProyeccionRequerimientoDocente
}

package "Application" #F0FDF4 {
    interface IRetencionRepository <<Interface>> {
        +ObtenerConfiguracion(carreraId: int, escenarioId: int) : ConfiguracionRetencion
    }
    interface IProyeccionEstudiantesRepository <<Interface>> {
        +Crear(proyeccion: ProyeccionEstudiantes) : int
        +GuardarDetalle(detalle: DetalleProyeccionEstudiantes) : void
        +ObtenerPorEscenario(escenarioId: int) : ProyeccionEstudiantes
    }
    interface IRequerimientoDocenteRepository <<Interface>> {
        +Guardar(requerimiento: ProyeccionRequerimientoDocente) : void
        +ObtenerPorEscenario(escenarioId: int) : List~ProyeccionRequerimientoDocente~
    }
    class ProyectarEstudiantesUseCase <<UseCase>> {
        -IRetencionRepository _retencionRepo
        -IProyeccionEstudiantesRepository _proyeccionRepo
        -IRequerimientoDocenteRepository _docenteRepo
        +Ejecutar(carreraId: int, escenarioId: int) : ProyeccionDto
    }

    IRetencionRepository -[hidden]-> IProyeccionEstudiantesRepository
    IProyeccionEstudiantesRepository -[hidden]-> IRequerimientoDocenteRepository
    IRequerimientoDocenteRepository -[hidden]-> ProyectarEstudiantesUseCase
}

package "Infrastructure" #FFF7ED {
    class ProyeccionEstudiantesRepository <<Repository>> {
        -AppDbContext _context
        +Crear(proyeccion: ProyeccionEstudiantes) : int
        +GuardarDetalle(detalle: DetalleProyeccionEstudiantes) : void
        +ObtenerPorEscenario(escenarioId: int) : ProyeccionEstudiantes
    }
    class RequerimientoDocenteRepository <<Repository>> {
        -AppDbContext _context
        +Guardar(requerimiento: ProyeccionRequerimientoDocente) : void
        +ObtenerPorEscenario(escenarioId: int) : List~ProyeccionRequerimientoDocente~
    }

    ProyeccionEstudiantesRepository -[hidden]-> RequerimientoDocenteRepository
}

package "Presentation" #FDF4FF {
    class EstudiantesViewModel <<ViewModel>> {
        +ICommand GenerarProyeccionCommand
        +ICommand ExportarCommand
        +CargarProyeccion() : void
    }
}

Domain -[hidden]-> Application
Application -[hidden]-> Infrastructure
Infrastructure -[hidden]-> Presentation

' Relaciones de dominio
EscenarioProyeccion "1" --> "0..*" ProyeccionEstudiantes : tiene
ProyeccionEstudiantes "1" --> "0..*" DetalleProyeccionEstudiantes : contiene
ProyeccionEstudiantes "1" --> "1" ConfiguracionCargaDocente : tiene
ConfiguracionCargaDocente "1" --> "0..*" ProyeccionRequerimientoDocente : genera
PeriodoAcademico "1" --> "0..*" DetalleProyeccionEstudiantes : agrupa
PeriodoAcademico "1" --> "0..*" ProyeccionRequerimientoDocente : agrupa

' Implementaciones
ProyeccionEstudiantesRepository ..|> IProyeccionEstudiantesRepository : implementa
RequerimientoDocenteRepository ..|> IRequerimientoDocenteRepository : implementa

' Dependencias de casos de uso
ProyectarEstudiantesUseCase --> IRetencionRepository : usa
ProyectarEstudiantesUseCase --> IProyeccionEstudiantesRepository : usa
ProyectarEstudiantesUseCase --> IRequerimientoDocenteRepository : usa

' Dependencias de presentación
EstudiantesViewModel --> ProyectarEstudiantesUseCase : invoca

@enduml