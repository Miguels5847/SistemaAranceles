@startuml CU-FB-04

skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

skinparam actor {
    BorderColor Black
}

left to right direction

actor "Administrador" as admin
actor "Planificador\nAcadémico" as planif
actor "Consultor" as consul

rectangle "Sistema de Cálculo de Aranceles" {
    usecase "Exportar módulo\nindividual" as UC04a
    usecase "Exportar todo\nconsolidado" as UC04b
    usecase "Generar XLSX\ncon fórmulas" as UC04c
    usecase "Generar PDF\nde impresión" as UC04d

    admin --> UC04a
    admin --> UC04b
    planif --> UC04a
    consul --> UC04a

    UC04a ..> UC04c : <<extend>>
    UC04a ..> UC04d : <<extend>>
    UC04b ..> UC04c : <<extend>>
    UC04b ..> UC04d : <<extend>>
}

note bottom of UC04a
    RF-FB-04: Exportación
    transversal XLSX/PDF
    individual o consolidada.
end note

@enduml