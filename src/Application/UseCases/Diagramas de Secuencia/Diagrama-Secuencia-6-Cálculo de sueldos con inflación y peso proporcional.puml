@startuml
title <b><size:20>Diagrama de Secuencia - Cálculo de sueldos con inflación y peso proporcional</size></b>

skinparam participant {
    FontSize 12
    FontStyle normal
}
skinparam actor {
    FontSize 12
    FontStyle normal
}
skinparam note {
    FontSize 12
}

actor "Planificador"
participant "SueldosViewModel"
participant "ProyectarSueldosUseCase"
participant "CargoFacultadRepository"
participant "IRepositorioInflacionAnual"
participant "ProyeccionCargoRepository"
participant "ProyeccionPlantaCentralRepository"
database "Base de Datos" as db

note over "Planificador","db"
Flujo Principal - Proyección de sueldos con inflación
end note

"Planificador" -> "SueldosViewModel": Solicita proyección de sueldos
"SueldosViewModel" -> "ProyectarSueldosUseCase": Ejecutar(carreraId, escenarioId)

"ProyectarSueldosUseCase" -> "CargoFacultadRepository": ObtenerCargos(carreraId)
"CargoFacultadRepository" -> "db": SELECT cargo_facultad WHERE carrera_id
"db" --> "CargoFacultadRepository": Lista de cargos con sueldos base
"CargoFacultadRepository" --> "ProyectarSueldosUseCase": Cargos

"ProyectarSueldosUseCase" -> "IRepositorioInflacionAnual": ListarAsync()
"IRepositorioInflacionAnual" -> "db": SELECT inflacion_anual ORDER BY anio
"db" --> "IRepositorioInflacionAnual": Inflación anual/proyectada
"IRepositorioInflacionAnual" --> "ProyectarSueldosUseCase": Factores de inflación

loop Por cada cargo y período
    "ProyectarSueldosUseCase" -> "ProyectarSueldosUseCase": CalcularFactorInflacionAcumulado(anio)
    "ProyectarSueldosUseCase" -> "ProyectarSueldosUseCase": CalcularBeneficiosSociales(sueldoBase)

    note over "ProyectarSueldosUseCase"
    Décimo3=1mes, Décimo4=fijo, FondoReserva=8.33%
    end note

    "ProyectarSueldosUseCase" -> "ProyectarSueldosUseCase": AplicarPesoProporcion(cargo, totalDocentes)

    note over "ProyectarSueldosUseCase"
    Si inflacion negativa se usa 0 para proteger sueldo
    end note

    "ProyectarSueldosUseCase" -> "ProyeccionCargoRepository": GuardarProyeccion(cargoId, periodoId, costo)
    "ProyeccionCargoRepository" -> "db": INSERT proyeccion_cargo_facultad
end

"ProyectarSueldosUseCase" -> "ProyeccionPlantaCentralRepository": ProyectarPlantaCentral(carreraId, escenarioId)

note over "ProyectarSueldosUseCase","ProyeccionPlantaCentralRepository"
Costo = SueldoTotal * (EstCarrera/EstUniversidad)
end note

"ProyeccionPlantaCentralRepository" -> "db": INSERT proyeccion_cargo_planta_central

"ProyectarSueldosUseCase" --> "SueldosViewModel": ProyeccionSueldosDto
"SueldosViewModel" --> "Planificador": Muestra tabla de costos por cargo y período
@enduml