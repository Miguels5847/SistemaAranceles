@startuml CU-ES-03

skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

skinparam actor {
    BorderColor Black
}

left to right direction

actor "Administrador" as admin
actor "Planificador\nAcadémico" as pa
actor "Consultor" as consultor

rectangle "Sistema de Cálculo de Aranceles" {
    usecase "Calcular docentes\nrequeridos por período" as UC03a
    usecase "Desglozar docentes\npor tipo (PhD/Mgs/Parcial)" as UC03b
    usecase "Calcular técnicos\ndocentes" as UC03c
    usecase "Configurar parámetros\nglobales de docentes" as UC03d
    usecase "Aplicar redondeo\ny regla mínimo Mgs." as UC03e
    usecase "Mostrar tabla\nde docentes" as UC03f
    usecase "Registrar auditoría\n(CU-US-04)" as UCAUD

    admin --> UC03d
    pa --> UC03a
    UC03f <-- consultor

    ' Ancla invisible: jala a pa hacia la izquierda junto a admin
    pa -[hidden]-> UC03d

    UC03a ..> UC03b : <<include>>
    UC03a ..> UC03c : <<include>>
    UC03a ..> UC03e : <<include>>
    UC03a ..> UC03f : <<include>>
    UC03a ..> UCAUD : <<include>>
    UC03d ..> UC03a : <<extend>>
    UC03d ..> UCAUD : <<include>>
}

note bottom of UC03a
    RF-ES-03: Calcular docentes
    requeridos y desglosar por
    tipo PhD, Mgs., Parcial y
    Técnico por período/año.
end note

@enduml