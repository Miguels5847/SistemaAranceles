<Application x:Class="SistemaAranceles.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SistemaAranceles.Presentation.Converters"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:UtcToEcuadorDateTimeConverter x:Key="UtcToEcuadorDateTimeConverter"/>
            <conv:ModoArancelDisplayConverter x:Key="ModoArancelDisplayConverter"/>

            <!-- KAN-47: las tablas no se redimensionan por el usuario (arrastrar bordes
                 deformaba columnas/filas y "dañaba" la lectura de los datos).
                 KAN-49: líneas de cuadrícula suaves (el default de WPF es negro). -->
            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="CanUserResizeColumns" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E3E6F0"/>
                <Setter Property="VerticalGridLinesBrush" Value="#EDEFF7"/>
                <Setter Property="BorderBrush" Value="#D5D9E8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
