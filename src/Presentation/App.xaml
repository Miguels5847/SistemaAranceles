<Application x:Class="SistemaAranceles.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SistemaAranceles.Presentation.Converters"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:UtcToEcuadorDateTimeConverter x:Key="UtcToEcuadorDateTimeConverter"/>
            <conv:ModoArancelDisplayConverter x:Key="ModoArancelDisplayConverter"/>
            <conv:NombreIconoMaterialConverter x:Key="NombreIconoMaterialConverter"/>

            <!-- KAN-47: las tablas no se redimensionan por el usuario (arrastrar bordes
                 deformaba columnas/filas y "dañaba" la lectura de los datos).
                 KAN-49: líneas de cuadrícula suaves (el default de WPF es negro). -->
            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="CanUserResizeColumns" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E3E6F0"/>
                <Setter Property="VerticalGridLinesBrush" Value="#EDEFF7"/>
                <Setter Property="BorderBrush" Value="#D5D9E8"/>
            </Style>

            <!-- KAN-49: barras de scroll de TODA la app. El estilo de MahApps las dejaba de ~6px y
                 solo crecían al pasar justo encima (casi imposibles de apuntar). Template propio:
                 14px siempre visibles, pista suave y pulgar redondeado en la paleta índigo de la
                 app (#C5CAE9/#7986CB), que oscurece al pasar el mouse y al arrastrar. -->
            <Style TargetType="ScrollBar">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Width" Value="14"/>
                <Setter Property="MinWidth" Value="14"/>
                <Setter Property="Background" Value="#EDEFF7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="7">
                                <Track x:Name="PART_Track"
                                       Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton x:Name="BtnAntes"
                                                      Command="{x:Static ScrollBar.PageUpCommand}"
                                                      Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Pulgar" Background="#BFC7E3" CornerRadius="5" Margin="2"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Pulgar" Property="Background" Value="#8F9CCB"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Pulgar" Property="Background" Value="#5C6BC0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton x:Name="BtnDespues"
                                                      Command="{x:Static ScrollBar.PageDownCommand}"
                                                      Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                    <Setter TargetName="BtnAntes" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                    <Setter TargetName="BtnDespues" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="14"/>
                        <Setter Property="MinHeight" Value="14"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
