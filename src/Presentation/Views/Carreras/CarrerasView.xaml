<UserControl x:Class="SistemaAranceles.Presentation.Views.Carreras.CarrerasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Gestión de Carreras"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#1A237E"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,10">
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C62828"
                       FontSize="12"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeExito}"
                       Foreground="#2E7D32"
                       FontSize="12"
                       Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <TextBlock Text="Carreras registradas"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <Button Content="Refrescar"
                                Command="{Binding CargarCommand}"
                                Margin="12,0,0,0"
                                Padding="8,4"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Carreras}"
                              SelectedItem="{Binding CarreraSeleccionada, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FE">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#263238"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EEF2FF"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0E7FF"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#263238"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0E7FF"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding Codigo}"
                                                Width="Auto"/>
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Facultad"
                                                Binding="{Binding FacultadNombre}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Ciclos"
                                                Binding="{Binding TotalCiclos}"
                                                Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Background="#FCFDFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding TituloFormulario}"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,8">
                        <TextBlock Text="Código"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Margin="0,0,0,8">
                        <TextBlock Text="Nombre"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="0,0,0,8">
                        <TextBlock Text="Facultad"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <TextBox Text="{Binding FacultadNombre, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Margin="0,0,0,8">
                        <TextBlock Text="Total ciclos"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <TextBox Text="{Binding TotalCiclos, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Nuevo"
                                Command="{Binding NuevoCommand}"
                                Padding="8,5"
                                Margin="0,0,6,0"/>
                        <Button Content="Editar selección"
                                Command="{Binding SeleccionarParaEditarCommand}"
                                Padding="8,5"
                                Margin="0,0,6,0"/>
                        <Button Content="Eliminar selección"
                                Command="{Binding EliminarSeleccionadaCommand}"
                                Padding="8,5"
                                Margin="0,0,6,0"
                                Background="#C62828"
                                Foreground="White"/>
                        <Button Content="Guardar"
                                Command="{Binding GuardarCommand}"
                                Padding="10,5"
                                Background="#1A237E"
                                Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
