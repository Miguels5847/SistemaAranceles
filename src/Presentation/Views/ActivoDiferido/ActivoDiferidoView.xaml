<UserControl x:Class="SistemaAranceles.Presentation.Views.ActivoDiferido.ActivoDiferidoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:SistemaAranceles.Presentation.Behaviors"
             Height="Auto" Width="Auto">

    <UserControl.Resources>
        <Style x:Key="BtnAccion" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="BtnEliminar" TargetType="Button" BasedOn="{StaticResource BtnAccion}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#263238"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Activos Diferidos — Amortización"
                   FontSize="18" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{Binding MensajeExito}" beh:AutoOcultarMensaje.Habilitado="True" Foreground="#2E7D32" FontWeight="SemiBold"
                       Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeError}" Foreground="#C62828" FontWeight="SemiBold"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <TabControl Grid.Row="2">

            <!-- TAB A: Registro de activos diferidos -->
            <TabItem Header="A. Activos Diferidos">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Permisos y gastos diferidos" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="+ Nuevo" Margin="12,0,4,0" Padding="8,3"
                                Command="{Binding AbrirNuevoCommand}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Activos}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserResizeColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FF" BorderBrush="#C5CAE9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Permiso / Rubro" Binding="{Binding NombreRubro}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Valor Total" Binding="{Binding ValorDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Tasa" Binding="{Binding TasaDisplay}" Width="70"/>
                            <DataGridTextColumn Header="Cuota Anual" Binding="{Binding CuotaAnualDisplay}" Width="120"/>
                            <DataGridTemplateColumn Header="Acciones" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Editar" Style="{StaticResource BtnAccion}"
                                                    Command="{Binding DataContext.AbrirEditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Eliminar" Style="{StaticResource BtnEliminar}"
                                                    Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Formulario inline -->
                    <Border Grid.Row="2" BorderBrush="#1A237E" BorderThickness="1" CornerRadius="4"
                            Margin="0,8,0,0" Padding="10,8"
                            Visibility="{Binding FormVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Rubro / Permiso" FontSize="11"/>
                                <TextBox Text="{Binding FormNombre, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Valor (USD)" FontSize="11"/>
                                <TextBox Text="{Binding FormValor, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="Tasa %" FontSize="11"/>
                                <TextBox Text="{Binding FormTasa, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Guardar" Padding="8,3" Margin="0,0,6,0"
                                            Background="#1A237E" Foreground="White"
                                            Command="{Binding GuardarCommand}"/>
                                    <Button Content="Cancelar" Padding="8,3"
                                            Command="{Binding CancelarFormCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB B: Tabla de amortización -->
            <TabItem Header="B. Tabla de Amortización">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontSize="12" Foreground="#546E7A" Margin="0,0,0,6"
                               Text="Amortización lineal al 20% anual durante 5 años (tasa configurable por rubro)."/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding TablaAmortizacion.FilasConTotales}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserResizeColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FF" BorderBrush="#C5CAE9">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#263238"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EEF2FF"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0E7FF"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding EsTotal}" Value="True">
                                        <Setter Property="Background" Value="#E8EAF6"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rubro" Binding="{Binding NombreRubro}" Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="Valor Total" Binding="{Binding ValorTotalDisplay}" Width="120"/>
                            <DataGridTextColumn Header="Tasa" Binding="{Binding TasaDisplay}" Width="70"/>
                            <DataGridTextColumn Header="Año 1" Binding="{Binding CuotasPorAnio[0], StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="Año 2" Binding="{Binding CuotasPorAnio[1], StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="Año 3" Binding="{Binding CuotasPorAnio[2], StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="Año 4" Binding="{Binding CuotasPorAnio[3], StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="Año 5" Binding="{Binding CuotasPorAnio[4], StringFormat=N2}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
