<UserControl x:Class="SistemaAranceles.Presentation.Views.Estudiantes.EstudiantesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaAranceles.Presentation.Views.Estudiantes">
    <Grid Margin="16">
        <!-- DESPUÉS (correcto) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Título -->
            <RowDefinition Height="Auto"/>   <!-- 1: Mensajes -->
            <RowDefinition Height="Auto" MinHeight="280"/>  <!-- 2: Lista + Formulario (fix botón eliminar) -->
            <RowDefinition Height="Auto"/>   <!-- 3: Indicador cargando detalle -->
            <RowDefinition Height="*"/>      <!-- 4: Tablas consolidadas -->
        </Grid.RowDefinitions>

        <!-- ══ Título ══════════════════════════════════════════════════════════ -->
        <TextBlock Grid.Row="0"
                   Text="Proyección de Estudiantes por Período"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#1A237E"
                   Margin="0,0,0,8"/>

        <!-- ══ Mensajes ════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,8">
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C62828"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeExito}"
                       Foreground="#2E7D32"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <!-- ══ CUERPO: Lista izquierda + Formulario derecho ════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Panel izquierdo: proyecciones ──────────────────────────── -->
            <Border Grid.Column="0"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <TextBlock Text="Proyecciones generadas"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <Button Content="Refrescar"
                                Command="{Binding CargarCommand}"
                                Margin="12,0,0,0"
                                Padding="8,4"/>
                        <TextBlock Text="Cargando..."
                                   Margin="12,0,0,0"
                                   FontStyle="Italic"
                                   Foreground="#546E7A"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Proyecciones}"
                              SelectedItem="{Binding ProyeccionSeleccionada, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FE">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Carrera"      Binding="{Binding CarreraCodigo}"    Width="Auto"/>
                            <DataGridTextColumn Header="Nombre carrera" Binding="{Binding CarreraNombre}" Width="*"/>
                            <DataGridTextColumn Header="Escenario"    Binding="{Binding EscenarioNombre}" Width="*"/>
                            <DataGridTextColumn Header="Año base"     Binding="{Binding AnioBase}"        Width="Auto"/>
                            <DataGridTextColumn Header="Semanas/sem." Binding="{Binding SemanasPorSemestre}" Width="Auto"/>
                            <DataGridTextColumn Header="Generado"     Binding="{Binding CreadoEnTexto}"   Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ── Panel derecho: formulario de generación ────────────────── -->
            <Border Grid.Column="2"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Background="#FCFDFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 0: Título -->
                        <RowDefinition Height="Auto"/>  <!-- 1: Carrera -->
                        <RowDefinition Height="Auto"/>  <!-- 2: Escenario -->
                        <RowDefinition Height="Auto"/>  <!-- 3: Simulación -->
                        <RowDefinition Height="Auto"/>  <!-- 4: Semanas -->
                        <RowDefinition Height="Auto"/>  <!-- 5: ProgressBar -->
                        <RowDefinition Height="*"/>     <!-- 6: spacer -->
                        <RowDefinition Height="Auto"/>  <!-- 7: Botones -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Generar proyección"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,8">
                        <TextBlock Text="Carrera"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <ComboBox ItemsSource="{Binding Carreras}"
                                  SelectedItem="{Binding CarreraSeleccionada, Mode=TwoWay}"
                                  DisplayMemberPath="Descripcion"
                                  IsEnabled="{Binding EstaGenerando, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Margin="0,0,0,8">
                        <TextBlock Text="Escenario de proyección"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <ComboBox ItemsSource="{Binding Escenarios}"
                                  SelectedItem="{Binding EscenarioSeleccionado, Mode=TwoWay}"
                                  DisplayMemberPath="Descripcion"
                                  IsEnabled="{Binding EstaGenerando, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="0,0,0,8">
                        <TextBlock Text="Simulación de retención base"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <ComboBox ItemsSource="{Binding Simulaciones}"
                                  SelectedItem="{Binding SimulacionSeleccionada, Mode=TwoWay}"
                                  DisplayMemberPath="Descripcion"
                                  IsEnabled="{Binding EstaGenerando, Converter={StaticResource InverseBoolConverter}}"/>
                        <TextBlock Text="Seleccione carrera y escenario para ver simulaciones."
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="#90A4AE"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Margin="0,0,0,8">
                        <TextBlock Text="Semanas por semestre"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <TextBox Text="{Binding SemanasPorSemestre, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding EstaGenerando, Converter={StaticResource InverseBoolConverter}}"/>
                        <TextBlock Text="Valor estándar: 16 semanas."
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="#90A4AE"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5"
                                Margin="0,4,0,8"
                                Visibility="{Binding EstaGenerando, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"/>
                        <TextBlock Text="Generando proyección..."
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="#546E7A"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Row 6 = spacer (*) — vacío a propósito -->

                    <StackPanel Grid.Row="7" Orientation="Vertical" VerticalAlignment="Bottom">
                        <Button Content="Generar proyección"
                                Command="{Binding GenerarCommand}"
                                Padding="10,8"
                                Background="#1A237E"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Margin="0,0,0,6"
                                IsEnabled="{Binding EstaGenerando, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Eliminar seleccionada"
                                Command="{Binding EliminarCommand}"
                                Padding="10,6"
                                Background="#C62828"
                                Foreground="White"
                                IsEnabled="{Binding EstaEliminando, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ Row 3: indicador de carga del detalle ═══════════════════════════ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,6,0,0"
                    Visibility="{Binding EstaCargandoDetalle, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True"
                         Width="120"
                         Height="4"
                         VerticalAlignment="Center"/>
            <TextBlock Text="Cargando análisis consolidado..."
                       FontSize="11"
                       FontStyle="Italic"
                       Foreground="#546E7A"
                       Margin="8,0,0,0"/>
        </StackPanel>

        <!-- ══ Row 4: 5 Tablas consolidadas ════════════════════════════════════ -->
        <Border Grid.Row="4"
                Margin="0,8,0,0"
                Visibility="{Binding TieneDetalleConsolidado, Converter={StaticResource BoolToVisibilityConverter}}">
            <TabControl Background="White"
                        BorderBrush="#C5CAE9">

                <!-- ╔══════════════════════════════════════════════════════╗ -->
                <!-- ║  TAB 1 — Matrícula por período (tipo Excel)         ║ -->
                <!-- ╚══════════════════════════════════════════════════════╝ -->
                <TabItem Header="1. Matrícula por período">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Distribución por período y paralelos"
                                   FontWeight="Bold" FontSize="12" Foreground="#1A237E"
                                   Margin="0,0,0,6"/>

                        <!-- DataGrid con columnas dinámicas generadas desde code-behind -->
                        <DataGrid x:Name="dgMatriculaPeriodo"
                                  Grid.Row="1"
                                  ItemsSource="{Binding DetalleConsolidado.MatriculaPorPeriodo}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  AlternatingRowBackground="#F8F9FE"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  MaxHeight="320">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Background" Value="#E8EAF6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ciclo}" Value="Total Nº de Estudiantes">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Background" Value="#E8EAF6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ╔══════════════════════════════════════════════════════╗ -->
                <!-- ║  TAB 2 — Docentes por año                           ║ -->
                <!-- ╚══════════════════════════════════════════════════════╝ -->
                <TabItem Header="2. Docentes por año">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIPO DOCENTE" FontWeight="Bold" FontSize="11" Foreground="#455A64"/>
                            <TextBlock Grid.Column="1" Text="{Binding DetalleConsolidado.LabelAnio1}" FontWeight="Bold" FontSize="11" Foreground="#1A237E" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding DetalleConsolidado.LabelAnio2}" FontWeight="Bold" FontSize="11" Foreground="#1A237E" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding DetalleConsolidado.LabelAnio3}" FontWeight="Bold" FontSize="11" Foreground="#1A237E" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding DetalleConsolidado.LabelAnio4}" FontWeight="Bold" FontSize="11" Foreground="#1A237E" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="TOTAL" FontWeight="Bold" FontSize="11" Foreground="#455A64" HorizontalAlignment="Center"/>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DetalleConsolidado.DocentesPorAnio}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="None"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8F9FE"
                                  MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Tipo}"
                                                    Width="140"/>
                                <DataGridTextColumn Binding="{Binding Anio1, StringFormat=N2}"
                                                    Width="*"/>
                                <DataGridTextColumn Binding="{Binding Anio2, StringFormat=N2}"
                                                    Width="*"/>
                                <DataGridTextColumn Binding="{Binding Anio3, StringFormat=N2}"
                                                    Width="*"/>
                                <DataGridTextColumn Binding="{Binding Anio4, StringFormat=N2}"
                                                    Width="*"/>
                                <DataGridTextColumn Binding="{Binding Total, StringFormat=N2}"
                                                    Width="80"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tipo}"
                                                     Value="TOTAL Docentes">
                                            <Setter Property="FontWeight"
                                                    Value="Bold"/>
                                            <Setter Property="Background"
                                                    Value="#E8EAF6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ╔══════════════════════════════════════════════════════╗ -->
                <!-- ║  TAB 3 — Horas totales                              ║ -->
                <!-- ╚══════════════════════════════════════════════════════╝ -->
                <TabItem Header="3. Horas totales">
                    <StackPanel Margin="16,12">
                        <TextBlock Text="Totales acumulados (8 períodos)"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#1A237E"
                                   Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Horas docencia (Σ fila 16)" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding DetalleConsolidado.TotalHorasDocencia, StringFormat=N0}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1A237E"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Horas práctica (Σ fila 20)" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding DetalleConsolidado.TotalHorasPractica, StringFormat=N0}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1A237E"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Background="#E8EAF6"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTAL COMBINADO" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DetalleConsolidado.TotalHorasCombinado, StringFormat=N0}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#1A237E"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Text="Constantes de negocio"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#455A64"
                                   Margin="0,18,0,6"/>
                        <TextBlock Text="Horas docente TC / semana = 18  ·  Horas técnico / semana = 40  ·  Semanas / semestre = configurado en proyección"
                                   FontSize="11"
                                   Foreground="#78909C"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Distribución docente: TC Mgs 60%  ·  TC PhD 24% (40% de Mgs)  ·  T. Parcial 16%"
                                   FontSize="11"
                                   Foreground="#78909C"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </TabItem>

                <!-- ╔══════════════════════════════════════════════════════╗ -->
                <!-- ║  TAB 4 — Indicadores clave                          ║ -->
                <!-- ╚══════════════════════════════════════════════════════╝ -->
                <TabItem Header="4. Indicadores">
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Matrícula" FontWeight="Bold" FontSize="12" Foreground="#1A237E" Margin="0,0,0,6"/>

                            <Border Background="#E3F2FD"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Matrícula período 1"
                                               FontSize="10"
                                               Foreground="#546E7A"/>
                                    <TextBlock Text="{Binding DetalleConsolidado.Indicadores.MatriculaPeriodo1, StringFormat=N2}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1565C0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#E3F2FD"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Matrícula período final"
                                               FontSize="10"
                                               Foreground="#546E7A"/>
                                    <TextBlock Text="{Binding DetalleConsolidado.Indicadores.MatriculaPeriodoFinal, StringFormat=N2}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1565C0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#E8EAF6"
                                    CornerRadius="4"
                                    Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="Crecimiento P1→Pfinal (×)"
                                               FontSize="10"
                                               Foreground="#546E7A"/>
                                    <TextBlock Text="{Binding DetalleConsolidado.Indicadores.CrecimientoMatricula, StringFormat=N2}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#283593"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Titulación y retención"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="#1A237E"
                                       Margin="0,0,0,6"/>

                            <Border Background="#E8F5E9"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Ingresados ABR (ciclo 1, períodos ABR)"
                                               FontSize="10"
                                               Foreground="#546E7A"/>
                                    <TextBlock Text="{Binding DetalleConsolidado.Indicadores.TotalIngresados, StringFormat=N2}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#2E7D32"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#E8F5E9"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock FontSize="10"
                                               Foreground="#546E7A">
                                        <Run Text="Titulados esperados ("/>
                                        <Run Text="{Binding DetalleConsolidado.Indicadores.TasaGraduacionMeta, StringFormat=N0}"/>
                                        <Run Text="%)"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DetalleConsolidado.Indicadores.TituladosEsperados, StringFormat=N2}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#2E7D32"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFF8E1"
                                    CornerRadius="4"
                                    Padding="10,6">
                                <StackPanel>
                                    <TextBlock FontSize="10"
                                               Foreground="#546E7A">
                                        <Run Text="Meta retención / ciclo: "/>
                                        <Run Text="{Binding DetalleConsolidado.Indicadores.TasaRetencionMeta, StringFormat=N0}"/>
                                        <Run Text="%"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10"
                                               Foreground="#546E7A"
                                               Margin="0,4,0,0">
                                        <Run Text="Meta titulación global: "/>
                                        <Run Text="{Binding DetalleConsolidado.Indicadores.TasaGraduacionMeta, StringFormat=N0}"/>
                                        <Run Text="%"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ╔══════════════════════════════════════════════════════╗ -->
                <!-- ║  TAB 5 — Tabla consumible por período               ║ -->
                <!-- ╚══════════════════════════════════════════════════════╝ -->
                <TabItem Header="5. Consumo por período">
                    <DataGrid Margin="8"
                              ItemsSource="{Binding DetalleConsolidado.TablaPeriodos}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FE"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Per."       Binding="{Binding Periodo}"                    Width="40"/>
                            <DataGridTextColumn Header="Año"        Binding="{Binding Anio}"                       Width="55"/>
                            <DataGridTextColumn Header="Sem."       Binding="{Binding Semestre}"                   Width="45"/>
                            <DataGridTextColumn Header="Docentes"   Binding="{Binding Docentes, StringFormat=N2}"  Width="80"/>
                            <DataGridTextColumn Header="Técnicos"   Binding="{Binding Tecnicos, StringFormat=N3}"  Width="80"/>
                            <DataGridTextColumn Header="H. Docencia" Binding="{Binding HorasDocencia, StringFormat=N0}" Width="*"/>
                            <DataGridTextColumn Header="H. Práctica" Binding="{Binding HorasPractica, StringFormat=N0}" Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                                <Setter Property="Background"
                                        Value="#E8EAF6"/>
                                <Setter Property="Padding"
                                        Value="6,4"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                    </DataGrid>
                </TabItem>

            </TabControl>
        </Border>

    </Grid>
</UserControl>
