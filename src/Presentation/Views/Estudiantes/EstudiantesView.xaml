<UserControl x:Class="SistemaAranceles.Presentation.Views.Estudiantes.EstudiantesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Proyección de Estudiantes por Período"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#1A237E"
                   Margin="0,0,0,10"/>

        <!-- Mensajes -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C62828"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeExito}"
                       Foreground="#2E7D32"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Cuerpo principal -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════ PANEL IZQUIERDO: Lista de proyecciones ════ -->
            <Border Grid.Column="0"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <TextBlock Text="Proyecciones generadas"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <Button Content="Refrescar"
                                Command="{Binding CargarCommand}"
                                Margin="12,0,0,0"
                                Padding="8,4"/>
                        <TextBlock Text="Cargando..."
                                   Margin="12,0,0,0"
                                   FontStyle="Italic"
                                   Foreground="#546E7A"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Proyecciones}"
                              SelectedItem="{Binding ProyeccionSeleccionada, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FE">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Carrera"
                                                Binding="{Binding CarreraCodigo}"
                                                Width="Auto"/>
                            <DataGridTextColumn Header="Nombre carrera"
                                                Binding="{Binding CarreraNombre}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Escenario"
                                                Binding="{Binding EscenarioNombre}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Año base"
                                                Binding="{Binding AnioBase}"
                                                Width="Auto"/>
                            <DataGridTextColumn Header="Semanas/sem."
                                                Binding="{Binding SemanasPorSemestre}"
                                                Width="Auto"/>
                            <DataGridTextColumn Header="Generado"
                                                Binding="{Binding CreadoEnTexto}"
                                                Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ════ PANEL DERECHO: Formulario de generación ════ -->
            <Border Grid.Column="2"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Background="#FCFDFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título formulario -->
                    <TextBlock Grid.Row="0"
                               Text="Generar proyección"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,12"/>

                    <!-- Carrera -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="Carrera"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <ComboBox ItemsSource="{Binding Carreras}"
                                  SelectedItem="{Binding CarreraSeleccionada, Mode=TwoWay}"
                                  DisplayMemberPath="Descripcion"
                                  IsEnabled="{Binding EstaGenerando, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>

                    <!-- Escenario -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="Escenario de proyección"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <ComboBox ItemsSource="{Binding Escenarios}"
                                  SelectedItem="{Binding EscenarioSeleccionado, Mode=TwoWay}"
                                  DisplayMemberPath="Descripcion"
                                  IsEnabled="{Binding EstaGenerando, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>

                    <!-- Simulación -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,8">
                        <TextBlock Text="Simulación de retención base"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <ComboBox ItemsSource="{Binding Simulaciones}"
                                  SelectedItem="{Binding SimulacionSeleccionada, Mode=TwoWay}"
                                  DisplayMemberPath="Descripcion"
                                  IsEnabled="{Binding EstaGenerando, Converter={StaticResource InverseBoolConverter}}"/>
                        <TextBlock Text="Seleccione carrera y escenario para ver simulaciones."
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="#90A4AE"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Semanas por semestre -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,8">
                        <TextBlock Text="Semanas por semestre"
                                   FontSize="11"
                                   Foreground="#546E7A"/>
                        <TextBox Text="{Binding SemanasPorSemestre, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding EstaGenerando, Converter={StaticResource InverseBoolConverter}}"/>
                        <TextBlock Text="Valor estándar: 16 semanas."
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="#90A4AE"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Indicador de progreso -->
                    <StackPanel Grid.Row="5"
                                Margin="0,4,0,8"
                                Visibility="{Binding EstaGenerando, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressBar IsIndeterminate="True" Height="4"/>
                        <TextBlock Text="Generando proyección..."
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="#546E7A"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Botones -->
                    <StackPanel Grid.Row="7"
                                Orientation="Vertical"
                                VerticalAlignment="Bottom">
                        <Button Content="Generar proyección"
                                Command="{Binding GenerarCommand}"
                                Padding="10,8"
                                Background="#1A237E"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Margin="0,0,0,6"
                                IsEnabled="{Binding EstaGenerando, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Eliminar seleccionada"
                                Command="{Binding EliminarCommand}"
                                Padding="10,6"
                                Background="#C62828"
                                Foreground="White"
                                IsEnabled="{Binding EstaEliminando, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
