<UserControl x:Class="SistemaAranceles.Presentation.Views.PlantaCentral.AportePlantaCentralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Aporte de la carrera a Planta Central"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#1A237E"
                       Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1"
                       Text="{Binding MensajeError}"
                       Foreground="#C62828"
                       FontWeight="SemiBold"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"
                       Margin="0,0,0,4"/>

            <!-- Selectores -->
            <Border Grid.Row="2"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Carrera" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding Carreras}"
                                  SelectedItem="{Binding CarreraSeleccionada}"
                                  DisplayMemberPath="Nombre"
                                  Padding="4,2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                        <TextBlock Text="Escenario" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding Escenarios}"
                                  SelectedItem="{Binding EscenarioSeleccionado}"
                                  DisplayMemberPath="Nombre"
                                  Padding="4,2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Bottom">
                        <Button Content="Calcular aporte"
                                Padding="12,4"
                                Background="#1A237E"
                                Foreground="White"
                                Command="{Binding CalcularCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Resumen institucional -->
            <Border Grid.Row="3"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="#F8F9FF"
                    Padding="10,8"
                    Margin="0,0,0,8"
                    Visibility="{Binding TieneResultado, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Periodo institucional vigente" FontSize="11" Foreground="#555"/>
                        <TextBlock Text="{Binding PeriodoInstitucionalVigente}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Total mensual planta central" FontSize="11" Foreground="#555"/>
                        <TextBlock Text="{Binding TotalMensualPlantaCentral, StringFormat=C2}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Estudiantes universidad" FontSize="11" Foreground="#555"/>
                        <TextBlock Text="{Binding EstudiantesUniversidad, StringFormat=N0}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tarjetas resumen carrera -->
            <Border Grid.Row="4"
                    BorderBrush="#1A237E"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0,0,0,8"
                    Visibility="{Binding TieneResultado, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Aporte mensual promedio" FontSize="11" Foreground="#555"/>
                        <TextBlock Text="{Binding AporteMensualPromedio, StringFormat=C2}" FontWeight="Bold" FontSize="16" Foreground="#1A237E"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Aporte acumulado" FontSize="11" Foreground="#555"/>
                        <TextBlock Text="{Binding AporteAcumulado, StringFormat=C2}" FontWeight="Bold" FontSize="16" Foreground="#1A237E"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Aporte promedio anual" FontSize="11" Foreground="#555"/>
                        <TextBlock Text="{Binding AportePromedioAnual, StringFormat=C2}" FontWeight="Bold" FontSize="16" Foreground="#1A237E"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="% promedio sobre total anual" FontSize="11" Foreground="#555"/>
                        <TextBlock Text="{Binding PorcentajePromedio, StringFormat=P2}" FontWeight="Bold" FontSize="16" Foreground="#1A237E"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="5"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="#F8F9FF"
                    Padding="8,6"
                    Margin="0,0,0,6"
                    Visibility="{Binding TieneResultado, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding TextoAyudaCalculo}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="#3949AB"/>
            </Border>

            <!-- Tabla horizontal resumida -->
            <DataGrid x:Name="dgTablaAporte"
                      Grid.Row="6"
                      ItemsSource="{Binding TablaResumenAporte}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      RowHeaderWidth="0"
                      MinHeight="170"
                      FontSize="12"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      AlternatingRowBackground="White"
                      BorderBrush="#C5CAE9"
                      Visibility="{Binding TieneResultado, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Background" Value="#E8EAF6"/>
                        <Setter Property="Foreground" Value="#1A237E"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="34"/>
                        <Setter Property="Foreground" Value="#1A237E"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EsFilaPrincipal}" Value="True">
                                <Setter Property="Background" Value="#63CEF0"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EsFilaAporte}" Value="True">
                                <Setter Property="Background" Value="#F8F9FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EsFilaTotal}" Value="True">
                                <Setter Property="Background" Value="#E8EAF6"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#C5CAE9"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EsFilaPrincipal}" Value="True">
                                <Setter Property="Background" Value="#63CEF0"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EsFilaAporte}" Value="True">
                                <Setter Property="Background" Value="#F8F9FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EsFilaTotal}" Value="True">
                                <Setter Property="Background" Value="#E8EAF6"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>

            <TextBlock Grid.Row="7"
                       Text="{Binding TextoInterpretativo}"
                       TextWrapping="Wrap"
                       FontStyle="Italic"
                       Foreground="#1A237E"
                       Margin="0,10,0,0"
                       Visibility="{Binding TieneResultado, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
