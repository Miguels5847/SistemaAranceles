<UserControl x:Class="SistemaAranceles.Presentation.Views.CargosFacultad.CargosFacultadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding TituloModulo}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1A237E"/>
            <TextBlock Text="Vista autogenerada por carrera y período. Los datos provienen de Capital de Trabajo, Estudiantes e Inflación."
                       FontSize="12"
                       Foreground="#546E7A"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C62828"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeExito}"
                       Foreground="#2E7D32"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="#C5CAE9"
                BorderThickness="1"
                CornerRadius="10"
                Background="#FDFEFF"
                Padding="10"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Carrera" FontSize="11" Foreground="#546E7A"/>
                    <ComboBox ItemsSource="{Binding Carreras}"
                              SelectedItem="{Binding CarreraSeleccionada, Mode=TwoWay}"
                              DisplayMemberPath="Nombre"
                              MinWidth="240"
                              Padding="6,4"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Período" FontSize="11" Foreground="#546E7A"/>
                    <ComboBox ItemsSource="{Binding Periodos}"
                              SelectedItem="{Binding PeriodoSeleccionado, Mode=TwoWay}"
                              DisplayMemberPath="DisplayText"
                              MinWidth="220"
                              Padding="6,4"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                    <Button Content="Generar / Recalcular"
                            Command="{Binding GenerarCommand}"
                            Padding="12,6"
                            Background="#3949AB"
                            Foreground="White"
                            BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#C5CAE9"
                BorderThickness="1"
                CornerRadius="10"
                Background="#FCFDFF"
                Padding="10"
                Margin="0,0,0,8">
            <UniformGrid Rows="1" Columns="4">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Estudiantes UA" FontSize="11" Foreground="#546E7A"/>
                    <TextBlock Text="{Binding EstudiantesUA, StringFormat={}{0:N0}}"
                               FontSize="16" FontWeight="SemiBold" Foreground="#1A237E"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Estudiantes carrera" FontSize="11" Foreground="#546E7A"/>
                    <TextBlock Text="{Binding EstudiantesCarrera, StringFormat={}{0:N2}}"
                               FontSize="16" FontWeight="SemiBold" Foreground="#1A237E"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Inflación período" FontSize="11" Foreground="#546E7A"/>
                    <TextBlock Text="{Binding TextoInflacionPeriodo}"
                               FontSize="16" FontWeight="SemiBold" Foreground="#1A237E"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Inflación acumulada" FontSize="11" Foreground="#546E7A"/>
                    <TextBlock Text="{Binding TextoInflacionAcumulada}"
                               FontSize="16" FontWeight="SemiBold" Foreground="#1A237E"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Border Grid.Row="4"
                BorderBrush="#C5CAE9"
                BorderThickness="1"
                CornerRadius="10"
                Background="White"
                Padding="10">
            <DataGrid ItemsSource="{Binding Filas}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F8F9FF"
                      BorderBrush="#C5CAE9">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PESO"
                                        Binding="{Binding Peso, StringFormat={}{0:N4}}"
                                        Width="80"/>
                    <DataGridTextColumn Header="Nº PERSONAS"
                                        Binding="{Binding NumeroPersonas, StringFormat={}{0:N2}}"
                                        Width="100"/>
                    <DataGridTextColumn Header="CARGO"
                                        Binding="{Binding NombreCargo}"
                                        Width="*"
                                        MinWidth="180"/>
                    <DataGridTextColumn Header="SUELDO MENSUAL"
                                        Binding="{Binding SueldoMensual, StringFormat={}{0:N2}}"
                                        Width="120"/>
                    <DataGridTextColumn Header="DÉCIMO XIII"
                                        Binding="{Binding DecimoTerceroSemestral, StringFormat={}{0:N2}}"
                                        Width="100"/>
                    <DataGridTextColumn Header="DÉCIMO IV"
                                        Binding="{Binding DecimoCuartoSemestral, StringFormat={}{0:N2}}"
                                        Width="100"/>
                    <DataGridTextColumn Header="VACACIONES"
                                        Binding="{Binding VacacionesSemestral, StringFormat={}{0:N2}}"
                                        Width="100"/>
                    <DataGridTextColumn Header="FONDO RESERVA"
                                        Binding="{Binding FondoReservaMensual, StringFormat={}{0:N2}}"
                                        Width="120"/>
                    <DataGridTextColumn Header="APORTE PATRONAL"
                                        Binding="{Binding AportePatronalMensual, StringFormat={}{0:N2}}"
                                        Width="130"/>
                    <DataGridTextColumn Header="TOTAL"
                                        Binding="{Binding TotalSemestre, StringFormat={}{0:N2}}"
                                        Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="5"
                BorderBrush="#1A237E"
                BorderThickness="1"
                CornerRadius="8"
                Background="#EEF3FF"
                Padding="12,8"
                Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="TOTAL DEL PERÍODO:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1A237E"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="{Binding TotalSemestrePeriodo, StringFormat={}{0:N2}}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1A237E"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
