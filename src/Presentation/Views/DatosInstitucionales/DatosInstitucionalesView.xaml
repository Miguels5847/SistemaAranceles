<UserControl x:Class="SistemaAranceles.Presentation.Views.DatosInstitucionales.DatosInstitucionalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SistemaAranceles.Presentation.Converters">
        <UserControl.Resources>
                <conv:DecimalStringConverter x:Key="DecimalStringConverter"/>
        </UserControl.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="12">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Datos Institucionales"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1A237E"
                                   Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding UltimaActualizacionTexto}"
                                   Foreground="#555"
                                   FontStyle="Italic"
                                   Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding MensajeError}"
                                   Foreground="#C62828"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"
                                   Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="3"
                                   Text="{Binding MensajeExito}"
                                   Foreground="#2E7D32"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"
                                   Margin="0,0,0,4"/>

                        <!-- Inputs Poblacion -->
                        <Border Grid.Row="4"
                                BorderBrush="#C5CAE9"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8"
                                Margin="0,0,0,8">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.ColumnSpan="4"
                                                   Text="Poblacion institucional y periodo"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1A237E"
                                                   Margin="0,0,0,6"/>

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="Periodo"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding Periodo, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="N. estudiantes universidad"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding NumeroEstudiantesUniversidad, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="N. docentes universidad"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding NumeroDocentesUniversidad, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="3">
                                                <TextBlock Text="N. personas planta central"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding NumeroPersonasPlantaCentral, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>
                                </Grid>
                        </Border>

                        <!-- Inputs Rubros monetarios -->
                        <Border Grid.Row="5"
                                BorderBrush="#C5CAE9"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8"
                                Margin="0,0,0,8">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.ColumnSpan="4"
                                                   Text="Planta central: totales mensuales (USD)"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1A237E"
                                                   Margin="0,0,0,6"/>

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,0,6,4">
                                                <TextBlock Text="Sueldo basico"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding SueldoBasico, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="0,0,6,4">
                                                <TextBlock Text="Funcional"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding Funcional, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="0,0,6,4">
                                                <TextBlock Text="Fondo de reserva"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding FondoReserva, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="3"
                                                    Margin="0,0,0,4">
                                                <TextBlock Text="Beneficio XIV"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding BeneficioXiv, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="0"
                                                    Margin="0,0,6,4">
                                                <TextBlock Text="Beneficio XIII"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding BeneficioXiii, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="1"
                                                    Margin="0,0,6,4">
                                                <TextBlock Text="Aporte patronal"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding AportePatronal, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="2"
                                                    Margin="0,0,6,4">
                                                <TextBlock Text="Varios"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding Varios, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="0,4,6,4">
                                                <TextBlock Text="Meses capital de trabajo"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding MesesCapitalTrabajo, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="0,4,6,4">
                                                <TextBlock Text="% imprevistos inversion"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding PorcentajeImprevistosInversion, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         Padding="4,2"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4"
                                                    Grid.ColumnSpan="4"
                                                    Margin="0,8,0,0">
                                                <TextBlock Text="Notas / fuente documental"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding FuenteNotas, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CamposEditables}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Height="50"
                                                         Padding="4,2"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="5"
                                                    Grid.ColumnSpan="4"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,10,0,0">
                                                <Button Content="Editar"
                                                        Padding="10,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding HabilitarEdicionCommand}"
                                                        IsEnabled="{Binding PuedeEditar}"/>
                                                <Button Content="Cancelar"
                                                        Padding="10,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding CancelarEdicionCommand}"
                                                        Visibility="{Binding EdicionActiva, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="Recargar"
                                                        Padding="10,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding CargarCommand}"/>
                                                <Button Content="Guardar"
                                                        Padding="14,4"
                                                        Background="#1A237E"
                                                        Foreground="White"
                                                        IsEnabled="{Binding CamposEditables}"
                                                        Command="{Binding GuardarCommand}"/>
                                        </StackPanel>
                                </Grid>
                        </Border>

                        <!-- KAN-35: Parámetros Demanda e Ingresos -->
                        <Border Grid.Row="6"
                                BorderBrush="#7986CB"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8"
                                Margin="0,0,0,8">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                                                   Text="Parámetros Demanda e Ingresos (Épica 9)"
                                                   FontWeight="SemiBold" Foreground="#1A237E"
                                                   Margin="0,0,0,6"/>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,4">
                                                <TextBlock Text="% Matrícula default" FontSize="11"/>
                                                <TextBox Text="{Binding PorcentajeMatriculaDefault, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}" Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,6,4">
                                                <TextBlock Text="% Becas institucionales" FontSize="11"/>
                                                <TextBox Text="{Binding PorcentajeBecasInstitucionales, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}" Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,6,4">
                                                <TextBlock Text="Semestres / año" FontSize="11"/>
                                                <TextBox Text="{Binding SemestresPorAnio, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CamposEditables}" Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,4">
                                                <TextBlock Text="Meses operativos / ciclo" FontSize="11"/>
                                                <TextBox Text="{Binding MesesOperativosCiclo, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CamposEditables}" Padding="4,2"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,6,4">
                                                <TextBlock Text="Presup. Capacitación (USD/año)" FontSize="11"/>
                                                <TextBox Text="{Binding PresupuestoAnualCapacitacion, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}" Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,6,4">
                                                <TextBlock Text="Presup. Internacionalización (USD/año)" FontSize="11"/>
                                                <TextBox Text="{Binding PresupuestoAnualInternacionalizacion, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}" Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,6,4">
                                                <TextBlock Text="Presup. Marketing (USD/año)" FontSize="11"/>
                                                <TextBox Text="{Binding PresupuestoAnualMarketing, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}" Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,0,4">
                                                <TextBlock Text="Póliza Seguro Estudiantil (USD/año)" FontSize="11"/>
                                                <TextBox Text="{Binding PolizaSeguroEstudiantilAnual, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalStringConverter}}"
                                                         IsEnabled="{Binding CamposEditables}" Padding="4,2"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="4"
                                                   Text="La inflación se toma automáticamente del módulo Inflación. El año base se infiere del primer período de la proyección."
                                                   FontSize="11" Foreground="#546E7A" FontStyle="Italic"
                                                   TextWrapping="Wrap" Margin="0,2,0,6"/>

                                        <Border Grid.Row="4" Grid.ColumnSpan="4"
                                                BorderBrush="#C5CAE9" BorderThickness="1" CornerRadius="4"
                                                Background="#F8F9FF" Padding="10,8" Margin="0,2,0,0">
                                                <Grid>
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                                                   Text="Seguro estudiantil calculado (solo lectura)"
                                                                   FontWeight="SemiBold" Foreground="#1A237E" Margin="0,0,0,6"/>

                                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                                                <TextBlock Text="Póliza anual" FontSize="11" Foreground="#555"/>
                                                                <TextBlock Text="{Binding PolizaSeguroAnualDisplay}" FontWeight="SemiBold" FontSize="14"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                                                <TextBlock Text="Semestres/año" FontSize="11" Foreground="#555"/>
                                                                <TextBlock Text="{Binding SemestresPorAnio}" FontWeight="SemiBold" FontSize="14"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                                                <TextBlock Text="Valor por semestre" FontSize="11" Foreground="#555"/>
                                                                <TextBlock Text="{Binding PolizaSeguroSemestralDisplay}" FontWeight="SemiBold" FontSize="14"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,6,0,0">
                                                                <TextBlock Text="Semestre 1" FontSize="11" Foreground="#555"/>
                                                                <TextBlock Text="{Binding SeguroSemestre1Display}" FontWeight="SemiBold" FontSize="14"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6,0,0">
                                                                <TextBlock Text="Semestre 2" FontSize="11" Foreground="#555"/>
                                                                <TextBlock Text="{Binding SeguroSemestre2Display}" FontWeight="SemiBold" FontSize="14"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="3"
                                                                   Text="El seguro por estudiante se calcula como valor por semestre dividido para N. estudiantes universidad."
                                                                   FontSize="11" Foreground="#546E7A" FontStyle="Italic"
                                                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                </Grid>
                                        </Border>
                                </Grid>
                        </Border>

                        <!-- Metricas calculadas -->
                        <Border Grid.Row="7"
                                BorderBrush="#C5CAE9"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#F8F9FF"
                                Padding="10,8">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.ColumnSpan="4"
                                                   Text="Metricas calculadas"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1A237E"
                                                   Margin="0,0,0,6"/>

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0">
                                                <TextBlock Text="Masa salarial mensual"
                                                           FontSize="11"
                                                           Foreground="#555"/>
                                                <TextBlock Text="{Binding MasaSalarialMensual, StringFormat=C2}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="1">
                                                <TextBlock Text="Total anual planta central"
                                                           FontSize="11"
                                                           Foreground="#555"/>
                                                <TextBlock Text="{Binding TotalAnualPlantaCentral, StringFormat=C2}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"/>
                                        </StackPanel>
                                        <!-- Removed Admin por docente and Costo PC por estudiante per request -->
                                </Grid>
                        </Border>
                </Grid>
        </ScrollViewer>
</UserControl>
