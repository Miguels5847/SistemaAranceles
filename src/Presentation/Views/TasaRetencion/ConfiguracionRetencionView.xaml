<UserControl x:Class="SistemaAranceles.Presentation.Views.TasaRetencion.ConfiguracionRetencionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Tasa de Retencion y Tasa de Graduacion"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1A237E"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Foreground="#3949AB"
                         Margin="0,0,0,4"
                         Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C62828"
                       FontSize="12"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeExito}"
                       Foreground="#2E7D32"
                       FontSize="12"
                       Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                    Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#C5CAE9"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        Background="White"
                        Margin="0,0,0,8">
                    <DataGrid ItemsSource="{Binding Configuraciones}"
                              SelectedItem="{Binding ConfiguracionSeleccionada, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FE">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                            Value="True">
                                        <Setter Property="Background"
                                                Value="#E8EAF6"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected"
                                            Value="True">
                                        <Setter Property="Background"
                                                Value="#C5CAE9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Carrera"
                                    Binding="{Binding CarreraNombre}"
                                    Width="*"/>
                            <DataGridTextColumn Header="Codigo"
                                    Binding="{Binding CarreraCodigo}"
                                    Width="Auto"/>
                            <DataGridTextColumn Header="Escenario"
                                    Binding="{Binding EscenarioNombre}"
                                    Width="*"/>
                            <DataGridTextColumn Header="Ciclos"
                                    Binding="{Binding TotalCiclos}"
                                    Width="Auto"/>
                            <DataGridTextColumn Header="Ret %"
                                    Binding="{Binding TasaRetencionPorcentaje, StringFormat={}{0:N2}}"
                                    Width="Auto"/>
                            <DataGridTextColumn Header="Grad %"
                                    Binding="{Binding TasaGraduacionPorcentaje, StringFormat={}{0:N2}}"
                                    Width="Auto"/>
                            <DataGridTextColumn Header="Meta Ret. %"
                                    Binding="{Binding MetaRetencionPorcentaje, StringFormat={}{0:N2}}"
                                    Width="Auto"/>
                            <DataGridTextColumn Header="Meta Grad. %"
                                    Binding="{Binding MetaGraduacionPorcentaje, StringFormat={}{0:N2}}"
                                    Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="1"
                        BorderBrush="#C5CAE9"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Background="#F0F4FF">
                    <StackPanel>
                        <TextBlock Text="Descripcion de escenarios de proyeccion"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#1A237E"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                    Margin="0,0,8,0">
                                <TextBlock Text="Historico"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#283593"
                                           Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#37474F"
                                           Text="Escenario base. Ingrese los valores reales de la carrera tomados del Excel institucional. Este escenario sirve como referencia para los demás."/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                    Margin="0,0,8,0">
                                <TextBlock Text="Optimista"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#2E7D32"
                                           Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#37474F"
                                           Text="Escenario derivado del histórico. Sube la retención 5% y la graduación 8%, y aumenta los estudiantes un 20%. Proyecta mayores ingresos por mejor permanencia y titulación."/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pesimista"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#C62828"
                                           Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#37474F"
                                           Text="Escenario derivado del histórico. Baja la retención 10% y la graduación 15%, y reduce los estudiantes un 20%. Proyecta menor ingreso y exige mayor provisión presupuestaria."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding TituloFormulario}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#283593"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Carrera"
                                FontSize="11"
                                Foreground="#546E7A"/>
                        <ComboBox ItemsSource="{Binding Carreras}"
                                  SelectedItem="{Binding CarreraSeleccionada, Mode=TwoWay}"
                                  DisplayMemberPath="Descripcion"
                                  Margin="0,0,0,8"/>

                        <TextBlock Text="Escenario"
                                FontSize="11"
                                Foreground="#546E7A"/>
                        <ComboBox ItemsSource="{Binding Escenarios}"
                                  SelectedItem="{Binding EscenarioSeleccionado, Mode=TwoWay}"
                                  DisplayMemberPath="Descripcion"/>
                        <TextBlock Text="{Binding TextoInformativoEscenario}"
                                   Margin="0,8,0,8"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="Gray"/>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Total ciclos"
                                    FontSize="11"
                                    Foreground="#546E7A"/>
                            <TextBox Text="{Binding TotalCiclos, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                    Margin="0,0,4,0">
                                <TextBlock Text="Tasa retencion %"
                                        FontSize="11"
                                        Foreground="#546E7A"/>
                                <TextBox Text="{Binding TasaRetencion, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                    Margin="4,0,0,0">
                                <TextBlock Text="Tasa graduacion %"
                                        FontSize="11"
                                        Foreground="#546E7A"/>
                                <TextBox Text="{Binding TasaGraduacion, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Periodo 1"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#546E7A"
                                   Margin="0,4,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                    Margin="0,0,4,0">
                                <TextBlock Text="Paralelos Periodo 1"
                                        FontSize="11"
                                        Foreground="#546E7A"/>
                                <TextBox Text="{Binding ParalelosPeriodo1, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                    Margin="4,0,0,0">
                                <TextBlock Text="Estudiantes Periodo 1"
                                        FontSize="11"
                                        Foreground="#546E7A"/>
                                <TextBox Text="{Binding EstudiantesPeriodo1, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Periodo 2"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#546E7A"
                                   Margin="0,4,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                    Margin="0,0,4,0">
                                <TextBlock Text="Paralelos Periodo 2"
                                        FontSize="11"
                                        Foreground="#546E7A"/>
                                <TextBox Text="{Binding ParalelosPeriodo2, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                    Margin="4,0,0,0">
                                <TextBlock Text="Estudiantes Periodo 2"
                                        FontSize="11"
                                        Foreground="#546E7A"/>
                                <TextBox Text="{Binding EstudiantesPeriodo2, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,4,0,8"/>
                        <TextBlock Text="Metas de referencia (opcional)"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#283593"
                                   Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                    Margin="0,0,4,0">
                                <TextBlock Text="Meta Retencion %"
                                        FontSize="11"
                                        Foreground="#546E7A"/>
                                <TextBox Text="{Binding MetaRetencion, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                    Margin="4,0,0,0">
                                <TextBlock Text="Meta Graduacion %"
                                        FontSize="11"
                                        Foreground="#546E7A"/>
                                <TextBox Text="{Binding MetaGraduacion, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">
                            <Button Content="Nuevo"
                                    Command="{Binding NuevoCommand}"
                                    Padding="10,6"
                                    Margin="0,0,6,0"/>
                            <Button Content="Editar seleccionado"
                                    Command="{Binding SeleccionarParaEditarCommand}"
                                    Padding="10,6"
                                    Margin="0,0,6,0"/>
                            <Button Content="Guardar"
                                    Command="{Binding GuardarCommand}"
                                    Background="#1A237E"
                                    Foreground="White"
                                    Padding="10,6"
                                    Margin="0,0,6,0"/>
                            <Button Content="Eliminar"
                                    Command="{Binding EliminarSeleccionadoCommand}"
                                    Background="#C62828"
                                    Foreground="White"
                                    Padding="10,6"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
