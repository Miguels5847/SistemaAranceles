<UserControl x:Class="SistemaAranceles.Presentation.Views.Catalogos.CatalogoCargosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto"
             Width="Auto">
        <UserControl.Resources>
                <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="#263238"/>
                        <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EEF2FF"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0E7FF"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>
                <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#263238"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>
        </UserControl.Resources>

        <Grid Margin="8">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra de acciones -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,6">
                        <TextBlock Text="Gastos de Servicio y Administración"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="+ Nuevo"
                                Margin="12,0,4,0"
                                Padding="8,3"
                                Command="{Binding AbrirNuevoCommand}"/>
                        <!-- Importar Ejemplo removed per module requirement -->
                </StackPanel>

                <!-- Mensaje error -->
                <TextBlock Grid.Row="1"
                           Text="{Binding MensajeError}"
                           Foreground="#C62828"
                           FontWeight="SemiBold"
                           Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"
                           Margin="0,0,0,4"/>

                <!-- Tabla -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Cargos}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectedItem="{Binding CargoSeleccionado}"
                          CanUserResizeColumns="False"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F9FF"
                          BorderBrush="#C5CAE9">
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre"
                                                    Binding="{Binding NombreCargo}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Cantidad"
                                                    Binding="{Binding CantidadDefault, StringFormat={}{0:N2}}"
                                                    Width="75"/>
                                <DataGridTextColumn Header="Sueldo Base"
                                                    Binding="{Binding SueldoBaseMensual, StringFormat=C}"
                                                    Width="110"/>
                                <DataGridCheckBoxColumn Header="Docente"
                                                        Binding="{Binding EsCargoDocente, Mode=OneWay}"
                                                        Width="65"/>
                                <DataGridTemplateColumn Header="Acciones"
                                                        Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                                <Button Content="Editar"
                                                                        Padding="5,2"
                                                                        Margin="0,0,4,0"
                                                                        Command="{Binding DataContext.AbrirEditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Content="Eliminar"
                                                                        Padding="5,2"
                                                                        Foreground="White"
                                                                        Background="#C62828"
                                                                        Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                        CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                        </DataGrid.Columns>
                </DataGrid>

                <!-- Formulario Agregar/Editar -->
                <Border Grid.Row="3"
                        BorderBrush="#1A237E"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,8,0,0"
                        Padding="10,8"
                        Visibility="{Binding FormVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.ColumnSpan="5"
                                            Grid.Row="0"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,6">
                                        <TextBlock Text="Nuevo Cargo"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1A237E"
                                                   Visibility="{Binding EsEdicion, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        <TextBlock Text="Editar Cargo"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1A237E"
                                                   Visibility="{Binding EsEdicion, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="0"
                                            Grid.Row="1"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="Nombre"
                                                   FontSize="11"/>
                                        <TextBox Text="{Binding FormNombreCargo, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="4,2"/>
                                </StackPanel>
                                <!-- 'Tipo' removed per module requirement -->
                                <StackPanel Grid.Column="2"
                                            Grid.Row="1"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="Cantidad"
                                                   FontSize="11"/>
                                        <TextBox Text="{Binding FormCantidad, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="4,2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3"
                                            Grid.Row="1"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="Sueldo Base (USD)"
                                                   FontSize="11"/>
                                        <TextBox Text="{Binding FormSueldo, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="4,2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4"
                                            Grid.Row="1">
                                        <CheckBox Content="Es Docente"
                                                  IsChecked="{Binding FormEsDocente}"
                                                  Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                                <Button Content="Guardar"
                                                        Padding="8,3"
                                                        Margin="0,0,6,0"
                                                        Background="#1A237E"
                                                        Foreground="White"
                                                        Command="{Binding GuardarCommand}"/>
                                                <Button Content="Cancelar"
                                                        Padding="8,3"
                                                        Command="{Binding CancelarFormCommand}"/>
                                        </StackPanel>
                                </StackPanel>
                        </Grid>
                </Border>
        </Grid>
</UserControl>
