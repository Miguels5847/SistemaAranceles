<UserControl x:Class="SistemaAranceles.Presentation.Views.Catalogos.CatalogoCargosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaAranceles.Presentation.ViewModels.Catalogos"
             Height="Auto"
        Width="Auto">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                Margin="0,0,0,8">
            <TextBlock Text="Catálogo de Cargos"
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>
            <Button Content="Importar Hoja 6 (Ejemplo)"
                    Margin="12,0,0,0"
                    Padding="8,4"
                    Click="Importar_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                ItemsSource="{Binding Cargos}"
                AutoGenerateColumns="False"
                IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre"
                        Binding="{Binding NombreCargo}"
                        Width="*"/>
                <DataGridTextColumn Header="Tipo"
                        Binding="{Binding TipoCargo}"
                        Width="150"/>
                <DataGridTextColumn Header="Sueldo base"
                        Binding="{Binding SueldoBaseMensual, StringFormat={}{0:N2}}"
                        Width="140"/>
                <DataGridCheckBoxColumn Header="Es docente"
                        Binding="{Binding EsCargoDocente}"
                        Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
