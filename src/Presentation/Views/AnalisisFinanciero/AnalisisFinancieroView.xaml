<UserControl x:Class="SistemaAranceles.Presentation.Views.AnalisisFinanciero.AnalisisFinancieroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EstadoPgRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsTotal}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#F1F8E9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PeriodoRecuperacionRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource EstadoPgRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsPeriodoRecuperacion}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#DCEDC8"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PuntoEquilibrioRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource EstadoPgRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsCalculable}" Value="False">
                    <Setter Property="Foreground" Value="#B71C1C"/>
                    <Setter Property="Background" Value="#FFF5F5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AnalisisDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsTotal}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding EsPeriodoRecuperacion}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                    <Setter Property="Background" Value="#DCEDC8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding EsCalculable}" Value="False">
                    <Setter Property="Foreground" Value="#B71C1C"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1B5E20"/>
                    <Setter Property="Background" Value="#E8F5E9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#1B5E20"/>
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="BorderBrush" Value="#A5D6A7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelResumen" TargetType="Border">
            <Setter Property="Background" Value="#F7FAF7"/>
            <Setter Property="BorderBrush" Value="#C8E6C9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="DashboardIndicadorCard" TargetType="Border" BasedOn="{StaticResource PanelResumen}">
            <Setter Property="MinHeight" Value="116"/>
            <Setter Property="Width" Value="220"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsViable}" Value="True">
                    <Setter Property="Background" Value="#F1F8E9"/>
                    <Setter Property="BorderBrush" Value="#81C784"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding EsViable}" Value="False">
                    <Setter Property="Background" Value="#FFF5F5"/>
                    <Setter Property="BorderBrush" Value="#EF9A9A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardSemaforoStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#C62828"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsViable}" Value="True">
                    <Setter Property="Fill" Value="#2E7D32"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardRecomendacionRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource EstadoPgRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Prioridad}" Value="Alta">
                    <Setter Property="Foreground" Value="#B71C1C"/>
                    <Setter Property="Background" Value="#FFF5F5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Análisis Financiero"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1B5E20"/>
            <TextBlock Text="Pérdidas y Ganancias, Flujo de Fondos e indicadores financieros"
                       FontSize="12"
                       Foreground="#546E7A"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D8DCE8"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Carrera" FontSize="11" Foreground="#546E7A"/>
                    <ComboBox ItemsSource="{Binding Carreras}"
                              SelectedItem="{Binding CarreraSeleccionada, Mode=TwoWay}"
                              DisplayMemberPath="Nombre"
                              MinWidth="220"
                              Padding="4,2"
                              IsEnabled="{Binding EstaCargando, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Escenario" FontSize="11" Foreground="#546E7A"/>
                    <ComboBox ItemsSource="{Binding Escenarios}"
                              SelectedItem="{Binding EscenarioSeleccionado, Mode=TwoWay}"
                              DisplayMemberPath="NombreDisplay"
                              MinWidth="220"
                              Padding="4,2"
                              IsEnabled="{Binding EstaCargando, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="Refrescar"
                        Padding="10,4"
                        VerticalAlignment="Bottom"
                        Command="{Binding RefrescarCommand}"
                        IsEnabled="{Binding EstaCargando, Converter={StaticResource InverseBoolConverter}}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="{Binding MensajeExito}"
                       Foreground="#2E7D32"
                       FontWeight="SemiBold"
                       Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C62828"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <TabControl Grid.Row="3"
                    IsEnabled="{Binding EstaCargando, Converter={StaticResource InverseBoolConverter}}">
            <TabItem Header="1. Pérdidas y Ganancias">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Ingresos netos" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding EstadoPerdidasGanancias.TotalIngresosDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Costos y gastos" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding EstadoPerdidasGanancias.TotalCostosYGastosDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Utilidad o pérdida" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding EstadoPerdidasGanancias.TotalUtilidadPerdidaEjercicioDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Participación / impuesto" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="{Binding EstadoPerdidasGanancias.PorcentajeParticipacionDisplay, Mode=OneWay, FallbackValue='15%'}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding EstadoPerdidasGanancias.PorcentajeImpuestoRentaDisplay, Mode=OneWay, FallbackValue='25%'}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid x:Name="PerdidasGananciasGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding FilasPerdidasGanancias}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowStyle="{StaticResource EstadoPgRowStyle}"
                              CellStyle="{StaticResource AnalisisDataGridCellStyle}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7FAF7"
                              BorderBrush="#C8E6C9"/>
                </Grid>
            </TabItem>

            <TabItem Header="2. Flujo de Fondos">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Inversión inicial" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding FlujoFondos.TotalInversionInicialDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Recuperación capital trabajo" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding FlujoFondos.TotalRecuperacionCapitalTrabajoDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Flujo neto total" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding FlujoFondos.TotalFlujoNetoDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Flujo acumulado final" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding FlujoFondos.FlujoAcumuladoFinalDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid x:Name="FlujoFondosGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding FilasFlujoFondos}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowStyle="{StaticResource EstadoPgRowStyle}"
                              CellStyle="{StaticResource AnalisisDataGridCellStyle}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7FAF7"
                              BorderBrush="#C8E6C9"/>
                </Grid>
            </TabItem>

            <TabItem Header="3. TIR / VAN / TMR">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="TMR" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding IndicadoresFinancieros.TmrDisplay, FallbackValue='0.00 %'}"
                                           FontWeight="Bold" FontSize="16" Foreground="#1B5E20"/>
                                <TextBlock Text="{Binding IndicadoresFinancieros.FuenteTmrDisplay, FallbackValue=''}"
                                           FontSize="10" Foreground="#546E7A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="VAN" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding IndicadoresFinancieros.VanDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold" FontSize="16" Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="TIR" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding IndicadoresFinancieros.TirDisplay, FallbackValue='No calculable'}"
                                           FontWeight="Bold" FontSize="16" Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Estado de viabilidad" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding IndicadoresFinancieros.EstadoViabilidad, FallbackValue='Sin datos'}"
                                           FontWeight="Bold" FontSize="16" Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="1" Style="{StaticResource PanelResumen}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Cálculo de la TMR" FontWeight="SemiBold" Foreground="#1B5E20" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding IndicadoresFinancieros.TmrFormulaDisplay, FallbackValue=''}"
                                       TextWrapping="Wrap" Foreground="#37474F"/>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#546E7A" TextWrapping="Wrap">
                                <Run Text="Inflación promedio tomada del módulo Inflación (años "/>
                                <Run Text="{Binding IndicadoresFinancieros.RangoInflacionDisplay, Mode=OneWay, FallbackValue='-'}"/>
                                <Run Text="). VAN descontado con TMR = "/>
                                <Run Text="{Binding IndicadoresFinancieros.TmrDisplay, Mode=OneWay, FallbackValue='0.00 %'}"/>
                                <Run Text="."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding DetalleVanFinanciero}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowStyle="{StaticResource EstadoPgRowStyle}"
                              CellStyle="{StaticResource AnalisisDataGridCellStyle}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7FAF7"
                              BorderBrush="#C8E6C9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Período" Binding="{Binding EtiquetaPeriodo}" Width="*"/>
                            <DataGridTextColumn Header="Flujo neto" Binding="{Binding FlujoNetoDisplay}" Width="170"/>
                            <DataGridTextColumn Header="Factor descuento" Binding="{Binding FactorDescuentoDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Valor presente" Binding="{Binding ValorPresenteDisplay}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="4. Periodo de Recuperación">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Estado" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding PeriodoRecuperacion.Estado, FallbackValue='Sin datos'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Periodo exacto" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding PeriodoRecuperacion.PeriodoRecuperacion, FallbackValue='Pendiente'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Tiempo de recuperación" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding PeriodoRecuperacion.TiempoRecuperacionDisplay, FallbackValue='Pendiente'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                                <TextBlock Text="{Binding PeriodoRecuperacion.TotalMesesDisplay, FallbackValue=''}"
                                           FontSize="10"
                                           Foreground="#546E7A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Flujo acumulado final" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding PeriodoRecuperacion.FlujoAcumuladoFinalDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DetallePeriodoRecuperacion}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowStyle="{StaticResource PeriodoRecuperacionRowStyle}"
                              CellStyle="{StaticResource AnalisisDataGridCellStyle}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7FAF7"
                              BorderBrush="#C8E6C9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Periodo" Binding="{Binding EtiquetaPeriodo}" Width="*"/>
                            <DataGridTextColumn Header="Flujo neto" Binding="{Binding FlujoNetoDisplay}" Width="170"/>
                            <DataGridTextColumn Header="Flujo acumulado" Binding="{Binding FlujoAcumuladoDisplay}" Width="170"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="5. Punto de Equilibrio">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Estado" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding PuntoEquilibrio.EstadoGeneral, FallbackValue='Sin datos'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="PE estudiantes promedio" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding PuntoEquilibrio.PuntoEquilibrioEstudiantesPromedioDisplay, FallbackValue='No calculable'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="PE monetario total" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding PuntoEquilibrio.PuntoEquilibrioMonetarioTotalDisplay, FallbackValue='No calculable'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Margen promedio" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding PuntoEquilibrio.MargenPromedioContribucionDisplay, FallbackValue='No calculable'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DetallePuntoEquilibrio}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowStyle="{StaticResource PuntoEquilibrioRowStyle}"
                              CellStyle="{StaticResource AnalisisDataGridCellStyle}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7FAF7"
                              BorderBrush="#C8E6C9"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Período" Binding="{Binding EtiquetaPeriodo}" Width="120"/>
                            <DataGridTextColumn Header="Estudiantes" Binding="{Binding EstudiantesDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Ingresos" Binding="{Binding IngresosDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Costos variables" Binding="{Binding CostosVariablesDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Costos fijos" Binding="{Binding CostosFijosDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Ingreso prom. estudiante" Binding="{Binding IngresoPromedioEstudianteDisplay}" Width="170"/>
                            <DataGridTextColumn Header="Costo variable estudiante" Binding="{Binding CostoVariablePorEstudianteDisplay}" Width="180"/>
                            <DataGridTextColumn Header="Margen contribución" Binding="{Binding MargenContribucionDisplay}" Width="160"/>
                            <DataGridTextColumn Header="PE estudiantes" Binding="{Binding PuntoEquilibrioEstudiantesDisplay}" Width="140"/>
                            <DataGridTextColumn Header="PE monetario" Binding="{Binding PuntoEquilibrioMonetarioDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="6. Arancel Óptimo">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Arancel óptimo" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding ArancelOptimoBiseccion.ArancelOptimoDisplay, FallbackValue='No calculable'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                                <TextBlock Text="{Binding ArancelOptimoBiseccion.Estado, FallbackValue='Sin datos'}"
                                           FontSize="10"
                                           Foreground="#546E7A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Matrícula óptima" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding ArancelOptimoBiseccion.MatriculaOptimaDisplay, FallbackValue='No calculable'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                                <TextBlock Text="{Binding ArancelOptimoBiseccion.TotalPorSemestreDisplay, FallbackValue='No calculable'}"
                                           FontSize="10"
                                           Foreground="#546E7A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="VAN objetivo" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding ArancelOptimoBiseccion.VanDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                                <TextBlock Text="{Binding ArancelOptimoBiseccion.ToleranciaDisplay, FallbackValue='± $ 1.00'}"
                                           FontSize="10"
                                           Foreground="#546E7A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="TIR / TMR" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock FontWeight="Bold" FontSize="16" Foreground="#1B5E20">
                                    <Run Text="{Binding ArancelOptimoBiseccion.TirDisplay, Mode=OneWay, FallbackValue='No calculable'}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding ArancelOptimoBiseccion.TmrDisplay, Mode=OneWay, FallbackValue='0.00 %'}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding ArancelOptimoBiseccion.FuenteTmrDisplay, FallbackValue=''}"
                                           FontSize="10"
                                           Foreground="#546E7A"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="1" Style="{StaticResource PanelResumen}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bisección VAN = 0" FontWeight="SemiBold" Foreground="#1B5E20"/>
                                <TextBlock FontSize="11" Foreground="#546E7A" TextWrapping="Wrap">
                                    <Run Text="Rango "/>
                                    <Run Text="{Binding ArancelOptimoBiseccion.RangoArancelDisplay, Mode=OneWay, FallbackValue='$ 500.00 - $ 5,000.00'}"/>
                                    <Run Text=", iteraciones "/>
                                    <Run Text="{Binding ArancelOptimoBiseccion.IteracionesUsadas, Mode=OneWay, FallbackValue='0'}"/>
                                    <Run Text=". VAN en mínimo "/>
                                    <Run Text="{Binding ArancelOptimoBiseccion.VanArancelMinimoDisplay, Mode=OneWay, FallbackValue='$ 0.00'}"/>
                                    <Run Text=", VAN en máximo "/>
                                    <Run Text="{Binding ArancelOptimoBiseccion.VanArancelMaximoDisplay, Mode=OneWay, FallbackValue='$ 0.00'}"/>
                                    <Run Text=", máximo evaluado "/>
                                    <Run Text="{Binding ArancelOptimoBiseccion.ArancelMaximoEvaluadoDisplay, Mode=OneWay, FallbackValue='$ 5,000.00'}"/>
                                    <Run Text=", expansiones "/>
                                    <Run Text="{Binding ArancelOptimoBiseccion.ExpansionesRango, Mode=OneWay, FallbackValue='0'}"/>
                                    <Run Text=", mejor arancel "/>
                                    <Run Text="{Binding ArancelOptimoBiseccion.MejorArancelEncontradoDisplay, Mode=OneWay, FallbackValue='Sin datos'}"/>
                                    <Run Text=", mejor VAN "/>
                                    <Run Text="{Binding ArancelOptimoBiseccion.MejorVanEncontradoDisplay, Mode=OneWay, FallbackValue='$ 0.00'}"/>
                                    <Run Text=", estado "/>
                                    <Run Text="{Binding ArancelOptimoBiseccion.EstadoConvergencia, Mode=OneWay, FallbackValue='Sin datos'}"/>
                                    <Run Text="."/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Usar arancel óptimo"
                                    Padding="10,4"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding UsarArancelOptimoCommand}"
                                    IsEnabled="{Binding PuedeUsarArancelOptimo}"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding DetalleArancelOptimo}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowStyle="{StaticResource EstadoPgRowStyle}"
                              CellStyle="{StaticResource AnalisisDataGridCellStyle}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7FAF7"
                              BorderBrush="#C8E6C9"
                              Margin="0,0,0,8"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Período" Binding="{Binding EtiquetaPeriodo}" Width="130"/>
                            <DataGridTextColumn Header="Estudiantes" Binding="{Binding EstudiantesDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Ingresos" Binding="{Binding IngresosDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Becas" Binding="{Binding BecasInstitucionalesDisplay}" Width="140"/>
                            <DataGridTextColumn Header="Costos y gastos" Binding="{Binding CostosYGastosDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Utilidad / pérdida" Binding="{Binding UtilidadPerdidaEjercicioDisplay}" Width="160"/>
                            <DataGridTextColumn Header="Flujo neto" Binding="{Binding FlujoNetoDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Flujo acumulado" Binding="{Binding FlujoAcumuladoDisplay}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding IteracionesArancelOptimo}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowStyle="{StaticResource EstadoPgRowStyle}"
                              CellStyle="{StaticResource AnalisisDataGridCellStyle}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7FAF7"
                              BorderBrush="#C8E6C9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Numero}" Width="60"/>
                            <DataGridTextColumn Header="Arancel mínimo" Binding="{Binding ArancelMinimoDisplay}" Width="160"/>
                            <DataGridTextColumn Header="Arancel máximo" Binding="{Binding ArancelMaximoDisplay}" Width="160"/>
                            <DataGridTextColumn Header="Arancel medio" Binding="{Binding ArancelMedioDisplay}" Width="160"/>
                            <DataGridTextColumn Header="VAN" Binding="{Binding VanDisplay}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="7. Dashboard Financiero">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,8">
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Estado general" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding DashboardFinanciero.EstadoGeneral, FallbackValue='Sin datos'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                                <TextBlock Text="{Binding DashboardFinanciero.ViabilidadDisplay, FallbackValue='0/0 indicadores'}"
                                           FontSize="10"
                                           Foreground="#546E7A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="VAN" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding DashboardFinanciero.VanDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                                <TextBlock Text="{Binding DashboardFinanciero.PorcentajeViabilidadDisplay, FallbackValue='0.00 %'}"
                                           FontSize="10"
                                           Foreground="#546E7A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="TIR / TMR" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock FontWeight="Bold" FontSize="16" Foreground="#1B5E20">
                                    <Run Text="{Binding DashboardFinanciero.TirDisplay, Mode=OneWay, FallbackValue='No calculable'}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding DashboardFinanciero.TmrDisplay, Mode=OneWay, FallbackValue='0.00 %'}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding DashboardFinanciero.FechaCalculoDisplay, FallbackValue=''}"
                                           FontSize="10"
                                           Foreground="#546E7A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Flujo acumulado final" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding DashboardFinanciero.FlujoAcumuladoFinalDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                                <TextBlock Text="{Binding DashboardFinanciero.UtilidadPerdidaDisplay, FallbackValue='$ 0.00'}"
                                           FontSize="10"
                                           Foreground="#546E7A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Arancel óptimo" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding DashboardFinanciero.ArancelOptimoDisplay, FallbackValue='No calculable'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#1B5E20"/>
                                <Button Grid.Row="2"
                                        Content="Exportar CSV"
                                        Margin="0,6,0,0"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ExportarDashboardCommand}"
                                        IsEnabled="{Binding PuedeExportarDashboard}"
                                        Visibility="{Binding PuedeVerExportarDashboard, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding IndicadoresDashboard}"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DashboardIndicadorCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <Ellipse Style="{StaticResource DashboardSemaforoStyle}"
                                                     DockPanel.Dock="Left"
                                                     Margin="0,3,6,0"/>
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#263238"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding ValorDisplay}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#1B5E20"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Estado}"
                                                   FontSize="11"
                                                   Foreground="#546E7A"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding Detalle}"
                                                   FontSize="11"
                                                   Foreground="#37474F"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding IndicadoresDashboard}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowStyle="{StaticResource EstadoPgRowStyle}"
                                  CellStyle="{StaticResource AnalisisDataGridCellStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F7FAF7"
                                  BorderBrush="#C8E6C9"
                                  Margin="0,0,8,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Indicador" Binding="{Binding Nombre}" Width="150"/>
                                <DataGridTextColumn Header="Valor" Binding="{Binding ValorDisplay}" Width="160"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="220"/>
                                <DataGridTextColumn Header="Módulo" Binding="{Binding Modulo}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Grid.Column="1"
                                  ItemsSource="{Binding RecomendacionesDashboard}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowStyle="{StaticResource DashboardRecomendacionRowStyle}"
                                  CellStyle="{StaticResource AnalisisDataGridCellStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F7FAF7"
                                  BorderBrush="#C8E6C9">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Prioridad" Binding="{Binding Prioridad}" Width="90"/>
                                <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="120"/>
                                <DataGridTextColumn Header="Recomendación" Binding="{Binding Mensaje}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="8. CES / INF CES">
                <TextBlock Text="Pendiente"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#546E7A"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3"
                Background="#B3FFFFFF"
                Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="220"
                             Height="6"
                             Foreground="#2E7D32"/>
                <TextBlock Text="Calculando análisis financiero..."
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#1B5E20"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
