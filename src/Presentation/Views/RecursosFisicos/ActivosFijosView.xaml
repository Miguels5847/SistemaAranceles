<UserControl x:Class="SistemaAranceles.Presentation.Views.RecursosFisicos.ActivosFijosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <UserControl.Resources>
        <Style x:Key="MatrixCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D0D7EA"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinWidth" Value="95"/>
        </Style>
        <Style x:Key="MatrixHeader" TargetType="Border" BasedOn="{StaticResource MatrixCell}">
            <Setter Property="Background" Value="#E8EAF6"/>
        </Style>
        <Style x:Key="MatrixGroupHeader" TargetType="Border" BasedOn="{StaticResource MatrixCell}">
            <Setter Property="Background" Value="#EEF1FB"/>
            <Setter Property="Padding" Value="6,6"/>
        </Style>
        <Style x:Key="MatrixDataCell" TargetType="Border" BasedOn="{StaticResource MatrixCell}">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsPeriodoInicial}" Value="True">
                    <Setter Property="Background" Value="#EEF1FB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MatrixValueTextBox" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsPeriodoInicial}" Value="True">
                    <Setter Property="Foreground" Value="#1A237E"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Valor inicial proveniente de Activos Fijos. No editable."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding EsSoloLectura}" Value="True">
                    <Setter Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MatrixMoneyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsPeriodoInicial}" Value="True">
                    <Setter Property="Foreground" Value="#1A237E"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Monto inicial proveniente de Activos Fijos."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Recursos y Depreciación" FontSize="22" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Carrera" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="320" ItemsSource="{Binding Carreras}" SelectedItem="{Binding CarreraSeleccionada, Mode=TwoWay}" DisplayMemberPath="Etiqueta"/>
            <TextBlock Text="Escenario" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <ComboBox Width="220" ItemsSource="{Binding Escenarios}" SelectedItem="{Binding EscenarioSeleccionado, Mode=TwoWay}" DisplayMemberPath="Nombre" mah:TextBoxHelper.Watermark="Selecciona el escenario…"/>
            <Button Content="Refrescar" Command="{Binding CargarCommand}" Margin="12,0,0,0" Padding="8,4"/>
            <Button Content="Generar activos por defecto" Command="{Binding GenerarActivosPorDefectoCommand}" Margin="8,0,0,0" Padding="8,4"/>
            <Button Content="Cargar inversiones" Command="{Binding CargarMatrizInversionesCommand}" Margin="8,0,0,0" Padding="8,4"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding MensajeError}" Foreground="#C62828" FontSize="12" Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeExito}" Foreground="#2E7D32" FontSize="12" Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeInfo}" Foreground="#1A237E" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding MensajeInfo, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeInversiones}" Foreground="#3949AB" FontSize="12" Visibility="{Binding MensajeInversiones, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeDepreciacion}" Foreground="#3949AB" FontSize="12" Visibility="{Binding MensajeDepreciacion, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <TabControl Grid.Row="3" IsEnabled="{Binding PuedeTrabajar}">
            <TabItem Header="Activos Fijos">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#C5CAE9" BorderThickness="1" CornerRadius="8" Padding="10" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Activos registrados" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Activos}" SelectedItem="{Binding ActivoSeleccionado, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F9FE">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Foreground" Value="#263238"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF2FF"/><Setter Property="Foreground" Value="#1A237E"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E0E7FF"/><Setter Property="Foreground" Value="#1A237E"/></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#263238"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E0E7FF"/><Setter Property="Foreground" Value="#1A237E"/></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                                    <DataGridTextColumn Header="Categoría" Binding="{Binding CategoriaNombre}" Width="Auto"/>
                                    <DataGridTextColumn Header="Tipo cálc." Binding="{Binding TipoCalculoNombre}" Width="Auto"/>
                                    <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="Auto"/>
                                    <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadMedida}" Width="Auto"/>
                                    <DataGridTextColumn Header="V. Unitario" Binding="{Binding ValorUnitarioDisplay}" Width="Auto"/>
                                    <DataGridTextColumn Header="V. Total" Binding="{Binding ValorTotalDisplay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Vida útil" Binding="{Binding VidaUtilAnios}" Width="Auto"/>
                                    <DataGridTextColumn Header="Residual" Binding="{Binding PorcentajeResidualDisplay}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Margin="0,8,0,0" Background="#EEF1FB" CornerRadius="6" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Totales por categoría" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding TotalesPorCategoria}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding CategoriaNombre}" FontSize="11"/>
                                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Text="{Binding SubtotalValorTotal, StringFormat=C2}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="TOTAL GENERAL" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="#1A237E" Text="{Binding TotalGeneralDisplay}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#C5CAE9" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FCFDFF">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding TituloFormulario}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="1" Margin="0,0,0,8"><TextBlock Text="Descripción" FontSize="11" Foreground="#546E7A"/><TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock Text="Categoría" FontSize="11" Foreground="#546E7A"/>
                                <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaForm, Mode=TwoWay}" DisplayMemberPath="Etiqueta"/>
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding CategoriaEsNueva, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Nombre de nueva categoría (referencial, no se agrega al listado)" FontSize="11" Foreground="#546E7A"/>
                                    <TextBox Text="{Binding CategoriaNuevaNombre, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                <TextBlock Text="Tipo de cálculo de cantidad" FontSize="11" Foreground="#546E7A"/>
                                <ComboBox ItemsSource="{Binding TiposCalculo}" SelectedItem="{Binding TipoCalculoForm, Mode=TwoWay}" DisplayMemberPath="Etiqueta"/>
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding CantidadEsManual, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Cantidad" FontSize="11" Foreground="#546E7A"/><TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Margin="0,0,0,8"><TextBlock Text="Unidad de medida" FontSize="11" Foreground="#546E7A"/><TextBox Text="{Binding UnidadMedida, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Row="5" Margin="0,0,0,8"><TextBlock Text="Valor unitario" FontSize="11" Foreground="#546E7A"/><TextBox Text="{Binding ValorUnitario, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Row="6" Margin="0,0,0,8"><TextBlock Text="Vida útil (años)" FontSize="11" Foreground="#546E7A"/><TextBox Text="{Binding VidaUtilAnios, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="% Valor residual" FontSize="11" Foreground="#546E7A" Margin="0,6,0,0"/><TextBox Text="{Binding PorcentajeResidual, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Nuevo" Command="{Binding NuevoCommand}" Padding="8,5" Margin="0,0,6,0"/>
                                <Button Content="Editar selección" Command="{Binding SeleccionarParaEditarCommand}" Padding="8,5" Margin="0,0,6,0"/>
                                <Button Content="Eliminar selección" Command="{Binding EliminarSeleccionadoCommand}" Padding="8,5" Margin="0,0,6,0" Background="#C62828" Foreground="White"/>
                                <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="10,5" Background="#1A237E" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Proyección en Unidades">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Cargar / Recalcular" Command="{Binding CargarMatrizInversionesCommand}" Padding="10,5" Margin="0,0,8,0"/>
                            <Button Content="Guardar celdas manuales" Command="{Binding GuardarInversionesFuturasCommand}" Padding="10,5" Background="#1A237E" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Proyección de necesidades en unidades. El primer período viene de Activos Fijos y no se edita." VerticalAlignment="Center" Foreground="#546E7A"/>
                    </DockPanel>
                    <Border Grid.Row="1" BorderBrush="#C5CAE9" BorderThickness="1" CornerRadius="8" Background="White">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource MatrixHeader}" MinWidth="260"><TextBlock Text="Descripción" FontWeight="Bold"/></Border>
                                    <Border Style="{StaticResource MatrixHeader}" MinWidth="120"><TextBlock Text="Tipo" FontWeight="Bold"/></Border>
                                    <ItemsControl ItemsSource="{Binding PeriodosInversion}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixHeader}"><TextBlock Text="{Binding Etiqueta}" FontWeight="Bold" HorizontalAlignment="Center"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding FilasInversion}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel><Border Style="{StaticResource MatrixCell}" MinWidth="260"><TextBlock Text="{Binding Descripcion}"/></Border><Border Style="{StaticResource MatrixCell}" MinWidth="120"><TextBlock Text="{Binding TipoCalculoNombre}"/></Border><ItemsControl ItemsSource="{Binding Celdas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixDataCell}"><TextBox Style="{StaticResource MatrixValueTextBox}" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EsSoloLectura}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Proyección Monetaria">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8"><Button Content="Cargar / Recalcular" Command="{Binding CargarMatrizInversionesCommand}" Padding="10,5" DockPanel.Dock="Right"/><TextBlock Text="Proyección de necesidades en unidades monetarias. Se calcula con cantidad × valor unitario × inflación aplicada al período." VerticalAlignment="Center" Foreground="#546E7A"/></DockPanel>
                    <Border Grid.Row="1" BorderBrush="#C5CAE9" BorderThickness="1" CornerRadius="8" Background="White">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel><Border Style="{StaticResource MatrixHeader}" MinWidth="260"><TextBlock Text="Descripción" FontWeight="Bold"/></Border><Border Style="{StaticResource MatrixHeader}" MinWidth="120"><TextBlock Text="V. Unitario" FontWeight="Bold"/></Border><ItemsControl ItemsSource="{Binding PeriodosInversion}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixHeader}"><TextBlock Text="{Binding Etiqueta}" FontWeight="Bold" HorizontalAlignment="Center"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel><ItemsControl ItemsSource="{Binding FilasInversion}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel><Border Style="{StaticResource MatrixCell}" MinWidth="260"><TextBlock Text="{Binding Descripcion}"/></Border><Border Style="{StaticResource MatrixCell}" MinWidth="120"><TextBlock Text="{Binding ValorUnitarioDisplay}" HorizontalAlignment="Right"/></Border><ItemsControl ItemsSource="{Binding Celdas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixDataCell}"><TextBlock Style="{StaticResource MatrixMoneyText}" Text="{Binding MontoDisplay}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><DockPanel Background="#E8EAF6"><Border Style="{StaticResource MatrixCell}" MinWidth="380"><TextBlock Text="INVERSIONES NECESARIAS" FontWeight="Bold" Foreground="#1A237E"/></Border><ItemsControl ItemsSource="{Binding TotalesInversion}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixCell}"><TextBlock Text="{Binding TotalDisplay}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1A237E"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></StackPanel></ScrollViewer>
                    </Border>
                    <TextBlock Grid.Row="2" Text="La fila Inversiones Necesarias queda lista para ser consumida por Inversión Inicial." FontStyle="Italic" Foreground="#1A237E" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Depreciación">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="Cargar / Recalcular depreciación" Command="{Binding CargarMatrizDepreciacionCommand}" Padding="10,5" DockPanel.Dock="Right"/>
                        <TextBlock Text="Depreciación calculada automáticamente desde Activos Fijos y Proyección Monetaria. No requiere guardado." VerticalAlignment="Center" Foreground="#546E7A"/>
                    </DockPanel>
                    <Border Grid.Row="1" BorderBrush="#C5CAE9" BorderThickness="1" CornerRadius="8" Background="White">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Depreciación por período" FontWeight="Bold" FontSize="14" Margin="8,8,8,4" Foreground="#1A237E"/>
                                <DockPanel>
                                    <Border Style="{StaticResource MatrixHeader}" MinWidth="260"><TextBlock Text="Descripción" FontWeight="Bold"/></Border>
                                    <Border Style="{StaticResource MatrixHeader}" MinWidth="100"><TextBlock Text="Valor" FontWeight="Bold"/></Border>
                                    <Border Style="{StaticResource MatrixHeader}" MinWidth="100"><TextBlock Text="Valor residual" FontWeight="Bold"/></Border>
                                    <Border Style="{StaticResource MatrixHeader}" MinWidth="70"><TextBlock Text="Tiempo" FontWeight="Bold"/></Border>
                                    <ItemsControl ItemsSource="{Binding PeriodosDepreciacion}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixHeader}"><TextBlock Text="{Binding Etiqueta}" FontWeight="Bold" HorizontalAlignment="Center"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding CategoriasDepreciacion}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <DockPanel Background="#EEF1FB">
                                                    <Border Style="{StaticResource MatrixGroupHeader}" MinWidth="530"><TextBlock Text="{Binding Nombre}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1A237E"/></Border>
                                                    <ItemsControl ItemsSource="{Binding Totales}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixGroupHeader}"><TextBlock Text="{Binding DepreciacionPeriodoDisplay}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1A237E"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Filas}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel><Border Style="{StaticResource MatrixCell}" MinWidth="260"><TextBlock Text="{Binding Descripcion}"/></Border><Border Style="{StaticResource MatrixCell}" MinWidth="100"><TextBlock Text="{Binding ValorInicialDisplay}" HorizontalAlignment="Right"/></Border><Border Style="{StaticResource MatrixCell}" MinWidth="100"><TextBlock Text="{Binding ValorResidualDisplay}" HorizontalAlignment="Right"/></Border><Border Style="{StaticResource MatrixCell}" MinWidth="70"><TextBlock Text="{Binding VidaUtilAnios}" HorizontalAlignment="Center"/></Border><ItemsControl ItemsSource="{Binding Celdas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixCell}"><TextBlock Text="{Binding DepreciacionPeriodoDisplay}" HorizontalAlignment="Right"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Background="#E8EAF6"><Border Style="{StaticResource MatrixCell}" MinWidth="530"><TextBlock Text="TOTAL DEPRECIACIÓN" FontWeight="Bold" Foreground="#1A237E"/></Border><ItemsControl ItemsSource="{Binding TotalesDepreciacion}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixCell}"><TextBlock Text="{Binding DepreciacionPeriodoDisplay}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1A237E"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel>

                                <TextBlock Text="Depreciación acumulada" FontWeight="Bold" FontSize="14" Margin="8,18,8,4" Foreground="#1A237E"/>
                                <DockPanel>
                                    <Border Style="{StaticResource MatrixHeader}" MinWidth="260"><TextBlock Text="Descripción" FontWeight="Bold"/></Border>
                                    <ItemsControl ItemsSource="{Binding PeriodosDepreciacion}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixHeader}"><TextBlock Text="{Binding Etiqueta}" FontWeight="Bold" HorizontalAlignment="Center"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding CategoriasDepreciacion}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <DockPanel Background="#EEF1FB">
                                                    <Border Style="{StaticResource MatrixGroupHeader}" MinWidth="260"><TextBlock Text="{Binding Nombre}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1A237E"/></Border>
                                                    <ItemsControl ItemsSource="{Binding Totales}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixGroupHeader}"><TextBlock Text="{Binding DepreciacionAcumuladaDisplay}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1A237E"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Filas}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel><Border Style="{StaticResource MatrixCell}" MinWidth="260"><TextBlock Text="{Binding Descripcion}"/></Border><ItemsControl ItemsSource="{Binding Celdas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixCell}"><TextBlock Text="{Binding DepreciacionAcumuladaDisplay}" HorizontalAlignment="Right"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Background="#E8EAF6"><Border Style="{StaticResource MatrixCell}" MinWidth="260"><TextBlock Text="TOTAL ACUMULADO" FontWeight="Bold" Foreground="#1A237E"/></Border><ItemsControl ItemsSource="{Binding TotalesDepreciacion}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MatrixCell}"><TextBlock Text="{Binding DepreciacionAcumuladaDisplay}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1A237E"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
