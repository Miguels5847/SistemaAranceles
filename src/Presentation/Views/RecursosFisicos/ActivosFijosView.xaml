<UserControl x:Class="SistemaAranceles.Presentation.Views.RecursosFisicos.ActivosFijosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Recursos y Depreciación — Activos Fijos"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#1A237E"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Carrera"
                       FontSize="11"
                       Foreground="#546E7A"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox Width="320"
                      ItemsSource="{Binding Carreras}"
                      SelectedItem="{Binding CarreraSeleccionada, Mode=TwoWay}"
                      DisplayMemberPath="Etiqueta"/>
            <TextBlock Text="Escenario"
                       FontSize="11"
                       Foreground="#546E7A"
                       VerticalAlignment="Center"
                       Margin="16,0,8,0"/>
            <ComboBox Width="220"
                      ItemsSource="{Binding Escenarios}"
                      SelectedItem="{Binding EscenarioSeleccionado, Mode=TwoWay}"
                      DisplayMemberPath="Nombre"/>
            <Button Content="Refrescar"
                    Command="{Binding CargarCommand}"
                    Margin="12,0,0,0"
                    Padding="8,4"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C62828"
                       FontSize="12"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeExito}"
                       Foreground="#2E7D32"
                       FontSize="12"
                       Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Activos registrados"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Activos}"
                              SelectedItem="{Binding ActivoSeleccionado, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FE">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#263238"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EEF2FF"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0E7FF"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#263238"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0E7FF"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding CategoriaNombre}" Width="Auto"/>
                            <DataGridTextColumn Header="Tipo cálc." Binding="{Binding TipoCalculoNombre}" Width="Auto"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="Auto"/>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadMedida}" Width="Auto"/>
                            <DataGridTextColumn Header="V. Unitario" Binding="{Binding ValorUnitarioDisplay}" Width="Auto"/>
                            <DataGridTextColumn Header="V. Total" Binding="{Binding ValorTotalDisplay}" Width="Auto"/>
                            <DataGridTextColumn Header="Vida útil" Binding="{Binding VidaUtilAnios}" Width="Auto"/>
                            <DataGridTextColumn Header="Residual" Binding="{Binding PorcentajeResidualDisplay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Margin="0,8,0,0"
                            Background="#EEF1FB"
                            CornerRadius="6"
                            Padding="8">
                        <StackPanel>
                            <TextBlock Text="Totales por categoría" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding TotalesPorCategoria}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding CategoriaNombre}" FontSize="11"/>
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11"
                                                       Text="{Binding SubtotalValorTotal, StringFormat=C2}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="TOTAL GENERAL" FontWeight="Bold" FontSize="12"/>
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12"
                                           Foreground="#1A237E" Text="{Binding TotalGeneralDisplay}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Background="#FCFDFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding TituloFormulario}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="Descripción" FontSize="11" Foreground="#546E7A"/>
                        <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="Categoría" FontSize="11" Foreground="#546E7A"/>
                        <ComboBox ItemsSource="{Binding Categorias}"
                                  SelectedItem="{Binding CategoriaForm, Mode=TwoWay}"
                                  DisplayMemberPath="Etiqueta"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,8">
                        <TextBlock Text="Tipo de cálculo de cantidad" FontSize="11" Foreground="#546E7A"/>
                        <ComboBox ItemsSource="{Binding TiposCalculo}"
                                  SelectedItem="{Binding TipoCalculoForm, Mode=TwoWay}"
                                  DisplayMemberPath="Etiqueta"/>

                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding CantidadEsManual, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Cantidad" FontSize="11" Foreground="#546E7A"/>
                            <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding UsaFactor, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Factor multiplicador (× estudiantes/docentes)" FontSize="11" Foreground="#546E7A"/>
                            <TextBox Text="{Binding FactorMultiplicador, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding UsaOffset, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Offset (cantidad fija adicional, semestre inicial)" FontSize="11" Foreground="#546E7A"/>
                            <TextBox Text="{Binding OffsetCantidad, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,8">
                        <TextBlock Text="Unidad de medida" FontSize="11" Foreground="#546E7A"/>
                        <TextBox Text="{Binding UnidadMedida, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,0,0,8">
                        <TextBlock Text="Valor unitario" FontSize="11" Foreground="#546E7A"/>
                        <TextBox Text="{Binding ValorUnitario, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Margin="0,0,0,8">
                        <TextBlock Text="Vida útil (años)" FontSize="11" Foreground="#546E7A"/>
                        <TextBox Text="{Binding VidaUtilAnios, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="% Valor residual" FontSize="11" Foreground="#546E7A" Margin="0,6,0,0"/>
                        <TextBox Text="{Binding PorcentajeResidual, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Nuevo" Command="{Binding NuevoCommand}" Padding="8,5" Margin="0,0,6,0"/>
                        <Button Content="Editar selección" Command="{Binding SeleccionarParaEditarCommand}" Padding="8,5" Margin="0,0,6,0"/>
                        <Button Content="Eliminar selección" Command="{Binding EliminarSeleccionadoCommand}" Padding="8,5" Margin="0,0,6,0"
                                Background="#C62828" Foreground="White"/>
                        <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="10,5"
                                Background="#1A237E" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
