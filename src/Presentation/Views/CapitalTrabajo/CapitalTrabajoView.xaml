<UserControl x:Class="SistemaAranceles.Presentation.Views.CapitalTrabajo.CapitalTrabajoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vCat="clr-namespace:SistemaAranceles.Presentation.Views.Catalogos"
             Height="Auto" Width="Auto">

    <UserControl.Resources>
        <Style x:Key="BtnAccion" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="BtnEliminar" TargetType="Button" BasedOn="{StaticResource BtnAccion}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Capital de Trabajo"
                   FontSize="18" FontWeight="Bold" Foreground="#1A237E"
                   Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{Binding MensajeExito}" Foreground="#2E7D32" FontWeight="SemiBold"
                       Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeError}" Foreground="#C62828" FontWeight="SemiBold"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <TabControl Grid.Row="2">

            <!-- TAB A: Cargos -->
            <TabItem Header="A. Gastos de Servicio y Adm.">
                <vCat:CatalogoCargosView DataContext="{Binding CatalogoCargos}"/>
            </TabItem>

            <!-- TAB B: Materiales y Suministros -->
            <TabItem Header="B. Materiales y Suministros">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBlock Text="Materiales y Suministros" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="+ Nuevo" Margin="12,0,0,0" Padding="8,3"
                                Command="{Binding AbrirNuevoMaterialCommand}"
                                CommandParameter="MATERIALES_SUMINISTROS"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding MensajeError}" Foreground="#C62828" FontWeight="SemiBold"
                               Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"
                               Margin="0,0,0,4"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding MaterialesSuministros}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Concepto"       Binding="{Binding NombreItem}"   Width="*"/>
                            <DataGridTextColumn Header="Cantidad"       Binding="{Binding Cantidad, StringFormat={}{0:N2}}" Width="80"/>
                            <DataGridTextColumn Header="Valor Unitario" Binding="{Binding PrecioUnitario, StringFormat=C}" Width="110"/>
                            <DataGridTemplateColumn Header="Acciones" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Editar" Style="{StaticResource BtnAccion}"
                                                    Command="{Binding DataContext.AbrirEditarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Eliminar" Style="{StaticResource BtnEliminar}"
                                                    Command="{Binding DataContext.EliminarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" BorderBrush="#1A237E" BorderThickness="1" CornerRadius="4"
                            Margin="0,8,0,0" Padding="10,8"
                            Visibility="{Binding FormMatVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Concepto" FontSize="11"/>
                                <TextBox Text="{Binding FormMatNombre, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Cantidad" FontSize="11"/>
                                <TextBox Text="{Binding FormMatCantidad, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="Valor Unitario (USD)" FontSize="11"/>
                                <TextBox Text="{Binding FormMatPrecio, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Guardar" Padding="8,3" Margin="0,0,6,0"
                                            Background="#1A237E" Foreground="White"
                                            Command="{Binding GuardarMaterialCommand}"/>
                                    <Button Content="Cancelar" Padding="8,3"
                                            Command="{Binding CancelarFormMatCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB C: Aseo y Limpieza -->
            <TabItem Header="C. Aseo y Limpieza">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBlock Text="Suministros de Aseo y Limpieza" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="+ Nuevo" Margin="12,0,0,0" Padding="8,3"
                                Command="{Binding AbrirNuevoMaterialCommand}"
                                CommandParameter="ASEO_LIMPIEZA"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AseoLimpieza}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Concepto"       Binding="{Binding NombreItem}"   Width="*"/>
                            <DataGridTextColumn Header="Cantidad"       Binding="{Binding Cantidad, StringFormat={}{0:N2}}" Width="80"/>
                            <DataGridTextColumn Header="Valor Unitario" Binding="{Binding PrecioUnitario, StringFormat=C}" Width="110"/>
                            <DataGridTemplateColumn Header="Acciones" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Editar" Style="{StaticResource BtnAccion}"
                                                    Command="{Binding DataContext.AbrirEditarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Eliminar" Style="{StaticResource BtnEliminar}"
                                                    Command="{Binding DataContext.EliminarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" BorderBrush="#1A237E" BorderThickness="1" CornerRadius="4"
                            Margin="0,8,0,0" Padding="10,8"
                            Visibility="{Binding FormMatVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Concepto" FontSize="11"/>
                                <TextBox Text="{Binding FormMatNombre, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Cantidad" FontSize="11"/>
                                <TextBox Text="{Binding FormMatCantidad, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="Valor Unitario (USD)" FontSize="11"/>
                                <TextBox Text="{Binding FormMatPrecio, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Guardar" Padding="8,3" Margin="0,0,6,0"
                                            Background="#1A237E" Foreground="White"
                                            Command="{Binding GuardarMaterialCommand}"/>
                                    <Button Content="Cancelar" Padding="8,3"
                                            Command="{Binding CancelarFormMatCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB D: Accesorios -->
            <TabItem Header="D. Accesorios y Materiales">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBlock Text="Accesorios y Materiales" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="+ Nuevo" Margin="12,0,0,0" Padding="8,3"
                                Command="{Binding AbrirNuevoMaterialCommand}"
                                CommandParameter="ACCESORIOS_MATERIALES"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AccesoriosMateriales}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Concepto"       Binding="{Binding NombreItem}"   Width="*"/>
                            <DataGridTextColumn Header="Cantidad"       Binding="{Binding Cantidad, StringFormat={}{0:N2}}" Width="80"/>
                            <DataGridTextColumn Header="Valor Unitario" Binding="{Binding PrecioUnitario, StringFormat=C}" Width="110"/>
                            <DataGridTemplateColumn Header="Acciones" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Editar" Style="{StaticResource BtnAccion}"
                                                    Command="{Binding DataContext.AbrirEditarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Eliminar" Style="{StaticResource BtnEliminar}"
                                                    Command="{Binding DataContext.EliminarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" BorderBrush="#1A237E" BorderThickness="1" CornerRadius="4"
                            Margin="0,8,0,0" Padding="10,8"
                            Visibility="{Binding FormMatVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Concepto" FontSize="11"/>
                                <TextBox Text="{Binding FormMatNombre, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Cantidad" FontSize="11"/>
                                <TextBox Text="{Binding FormMatCantidad, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="Valor Unitario (USD)" FontSize="11"/>
                                <TextBox Text="{Binding FormMatPrecio, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Guardar" Padding="8,3" Margin="0,0,6,0"
                                            Background="#1A237E" Foreground="White"
                                            Command="{Binding GuardarMaterialCommand}"/>
                                    <Button Content="Cancelar" Padding="8,3"
                                            Command="{Binding CancelarFormMatCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
