<UserControl x:Class="SistemaAranceles.Presentation.Views.CapitalTrabajo.CapitalTrabajoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmCat="clr-namespace:SistemaAranceles.Presentation.ViewModels.Catalogos"
             xmlns:vCat="clr-namespace:SistemaAranceles.Presentation.Views.Catalogos"
             xmlns:local="clr-namespace:SistemaAranceles.Presentation.Views.CapitalTrabajo"
             Height="Auto"
        Width="Auto">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                Grid.Row="0"
                Margin="0,0,0,8">
            <TextBlock Text="Capital de Trabajo"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#1A237E"/>
            <Button Content="Importar Hoja 6 (Ejemplo)"
                    Margin="12,0,0,0"
                    Command="{Binding ImportarHoja6EjemploCommand}"
                    CommandParameter="1"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Gastos de Servicio y Administración">
                <vCat:CatalogoCargosView/>
            </TabItem>

            <TabItem Header="Materiales y Suministros">
                <Grid>
                    <DataGrid ItemsSource="{Binding Materiales}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Concepto"
                                    Binding="{Binding NombreItem}"/>
                            <DataGridTextColumn Header="Categoría"
                                    Binding="{Binding Categoria}"/>
                            <DataGridTextColumn Header="Valor Unitario"
                                    Binding="{Binding PrecioUnitario, StringFormat=C}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Suministros de Aseo y Limpieza">
                <Grid>
                    <TextBlock Text="Use la pestaña Materiales y Suministros para ver ítems por categoría."
                            Foreground="#5C6BC0"
                            Margin="8"/>
                </Grid>
            </TabItem>

            <TabItem Header="Accesorios y Materiales">
                <Grid>
                    <TextBlock Text="Use la pestaña Materiales y Suministros para ver ítems por categoría."
                            Foreground="#5C6BC0"
                            Margin="8"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
