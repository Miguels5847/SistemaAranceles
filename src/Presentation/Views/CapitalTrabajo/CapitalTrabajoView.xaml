<UserControl x:Class="SistemaAranceles.Presentation.Views.CapitalTrabajo.CapitalTrabajoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">

    <UserControl.Resources>
        <Style x:Key="BtnAccion" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="BtnPrimario" TargetType="Button" BasedOn="{StaticResource BtnAccion}">
            <Setter Property="Background" Value="#1A237E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="BtnEliminar" TargetType="Button" BasedOn="{StaticResource BtnAccion}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="PanelFormulario" TargetType="Border">
            <Setter Property="BorderBrush" Value="#1A237E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#263238"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Capital de Trabajo por Carrera"
                   FontSize="18" FontWeight="Bold" Foreground="#1A237E"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1" BorderBrush="#D8DCE8" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Carrera" FontSize="11" Foreground="#546E7A"/>
                    <ComboBox ItemsSource="{Binding Carreras}"
                              SelectedItem="{Binding CarreraSeleccionada, Mode=TwoWay}"
                              DisplayMemberPath="Nombre"
                              MinWidth="220" Padding="4,2"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Escenario" FontSize="11" Foreground="#546E7A"/>
                    <ComboBox ItemsSource="{Binding Escenarios}"
                              SelectedItem="{Binding EscenarioSeleccionado, Mode=TwoWay}"
                              DisplayMemberPath="Nombre"
                              MinWidth="220" Padding="4,2"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Período base" FontSize="11" Foreground="#546E7A"/>
                    <TextBlock Text="{Binding PeriodoBaseDisplay}" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Generar materiales por defecto" Padding="10,4" Margin="0,0,6,0"
                            Style="{StaticResource BtnPrimario}"
                            ToolTip="Inserta los materiales y suministros estándar (B/C/D) para la carrera seleccionada. No duplica."
                            Command="{Binding GenerarMaterialesPorDefectoCommand}"/>
                    <Button Content="Refrescar" Padding="10,4"
                            Command="{Binding CargarCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="{Binding MensajeExito}" Foreground="#2E7D32" FontWeight="SemiBold"
                       Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeError}" Foreground="#C62828" FontWeight="SemiBold"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <TabControl Grid.Row="3">

            <TabItem Header="A. Gastos de Servicio y Administracion">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="A. Gastos de Servicio y Administracion"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding GastosServicioAdministracion}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserResizeColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FF" BorderBrush="#C5CAE9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" MinWidth="240"/>
                            <DataGridTextColumn Header="Valor unitario" Binding="{Binding ValorUnitarioDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Valor mensual" Binding="{Binding ValorMensualDisplay}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="{Binding Resumen.SubtotalCargosDisplay, StringFormat=Subtotal A: {0}}"
                               FontWeight="Bold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="B. Materiales y Suministros">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="B. Materiales y Suministros" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="+ Nuevo" Margin="12,0,4,0" Padding="8,3"
                                Command="{Binding AbrirNuevoMaterialCommand}"
                                CommandParameter="MATERIALES_SUMINISTROS"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding MaterialesSuministros}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserResizeColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FF" BorderBrush="#C5CAE9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" MinWidth="240"/>
                            <DataGridTextColumn Header="Valor unitario" Binding="{Binding ValorUnitarioDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Valor mensual" Binding="{Binding ValorMensualDisplay}" Width="130"/>
                            <DataGridTemplateColumn Header="Acciones" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Editar" Style="{StaticResource BtnAccion}"
                                                    Command="{Binding DataContext.AbrirEditarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Eliminar" Style="{StaticResource BtnEliminar}"
                                                    Command="{Binding DataContext.EliminarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource PanelFormulario}"
                            Visibility="{Binding FormMaterialesVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Concepto" FontSize="11"/>
                                <TextBox Text="{Binding FormMatNombre, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Cantidad" FontSize="11"/>
                                <TextBox Text="{Binding FormMatCantidad, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="Valor unitario" FontSize="11"/>
                                <TextBox Text="{Binding FormMatPrecio, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <Button Content="Guardar" Style="{StaticResource BtnPrimario}" Command="{Binding GuardarMaterialCommand}"/>
                                <Button Content="Cancelar" Padding="8,3" Command="{Binding CancelarFormMatCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="C. Suministros de Aseo y Limpieza">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="C. Suministros de Aseo y Limpieza" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="+ Nuevo" Margin="12,0,4,0" Padding="8,3"
                                Command="{Binding AbrirNuevoMaterialCommand}"
                                CommandParameter="ASEO_LIMPIEZA"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AseoLimpieza}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserResizeColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FF" BorderBrush="#C5CAE9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" MinWidth="240"/>
                            <DataGridTextColumn Header="Valor unitario" Binding="{Binding ValorUnitarioDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Valor mensual" Binding="{Binding ValorMensualDisplay}" Width="130"/>
                            <DataGridTemplateColumn Header="Acciones" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Editar" Style="{StaticResource BtnAccion}"
                                                    Command="{Binding DataContext.AbrirEditarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Eliminar" Style="{StaticResource BtnEliminar}"
                                                    Command="{Binding DataContext.EliminarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource PanelFormulario}"
                            Visibility="{Binding FormAseoVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Concepto" FontSize="11"/>
                                <TextBox Text="{Binding FormMatNombre, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Cantidad" FontSize="11"/>
                                <TextBox Text="{Binding FormMatCantidad, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="Valor unitario" FontSize="11"/>
                                <TextBox Text="{Binding FormMatPrecio, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <Button Content="Guardar" Style="{StaticResource BtnPrimario}" Command="{Binding GuardarMaterialCommand}"/>
                                <Button Content="Cancelar" Padding="8,3" Command="{Binding CancelarFormMatCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="D. Accesorios y Materiales">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="D. Accesorios y Materiales" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="+ Nuevo" Margin="12,0,4,0" Padding="8,3"
                                Command="{Binding AbrirNuevoMaterialCommand}"
                                CommandParameter="ACCESORIOS_MATERIALES"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AccesoriosMateriales}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserResizeColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FF" BorderBrush="#C5CAE9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" MinWidth="240"/>
                            <DataGridTextColumn Header="Valor unitario" Binding="{Binding ValorUnitarioDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Valor mensual" Binding="{Binding ValorMensualDisplay}" Width="130"/>
                            <DataGridTemplateColumn Header="Acciones" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Editar" Style="{StaticResource BtnAccion}"
                                                    Command="{Binding DataContext.AbrirEditarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Eliminar" Style="{StaticResource BtnEliminar}"
                                                    Command="{Binding DataContext.EliminarMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource PanelFormulario}"
                            Visibility="{Binding FormAccesoriosVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Concepto" FontSize="11"/>
                                <TextBox Text="{Binding FormMatNombre, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Cantidad" FontSize="11"/>
                                <TextBox Text="{Binding FormMatCantidad, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="Valor unitario" FontSize="11"/>
                                <TextBox Text="{Binding FormMatPrecio, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <Button Content="Guardar" Style="{StaticResource BtnPrimario}" Command="{Binding GuardarMaterialCommand}"/>
                                <Button Content="Cancelar" Padding="8,3" Command="{Binding CancelarFormMatCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="E. Resumen Capital de Trabajo">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CAPITAL DE TRABAJO"
                                   FontSize="18" FontWeight="Bold" TextAlignment="Center"
                                   Foreground="#111827" Margin="0,0,0,10"/>

                        <Border BorderBrush="#263238" BorderThickness="1,1,1,0" Background="#F5F7FB">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CANTIDAD" FontWeight="Bold" TextAlignment="Center" Padding="6,8"/>
                                <TextBlock Grid.Column="1" Text="CONCEPTO" FontWeight="Bold" TextAlignment="Center" Padding="6,8"/>
                                <TextBlock Grid.Column="2" Text="VALOR UNITARIO" FontWeight="Bold" TextAlignment="Center" Padding="6,8"/>
                                <TextBlock Grid.Column="3" Text="VALOR MENSUAL" FontWeight="Bold" TextAlignment="Center" Padding="6,8"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#263238" BorderThickness="1" Background="#FAFAFA" Padding="6,7">
                            <TextBlock Text="GASTOS DE SERVICIO Y ADMINISTRACION" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding GastosServicioAdministracion}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="None" GridLinesVisibility="All"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                                  RowHeight="24" BorderBrush="#263238" BorderThickness="1,0,1,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding CantidadDisplay}" Width="90"/>
                                <DataGridTextColumn Binding="{Binding Concepto}" Width="*" MinWidth="240"/>
                                <DataGridTextColumn Binding="{Binding ValorUnitarioDisplay}" Width="140"/>
                                <DataGridTextColumn Binding="{Binding ValorMensualDisplay}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border BorderBrush="#263238" BorderThickness="1" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="TOTAL" FontWeight="Bold" FontSize="15" Padding="6,5"/>
                                <TextBlock Grid.Column="3" Text="{Binding Resumen.SubtotalCargosDisplay}" FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Right" Padding="6,5"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#263238" BorderThickness="1" Background="#FAFAFA" Padding="6,7">
                            <TextBlock Text="MATERIALES Y SUMINISTROS" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding MaterialesSuministros}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="None" GridLinesVisibility="All"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                                  RowHeight="24" BorderBrush="#263238" BorderThickness="1,0,1,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding CantidadDisplay}" Width="90"/>
                                <DataGridTextColumn Binding="{Binding Concepto}" Width="*" MinWidth="240"/>
                                <DataGridTextColumn Binding="{Binding ValorUnitarioDisplay}" Width="140"/>
                                <DataGridTextColumn Binding="{Binding ValorMensualDisplay}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border BorderBrush="#263238" BorderThickness="1" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="TOTAL" FontWeight="Bold" FontSize="15" Padding="6,5"/>
                                <TextBlock Grid.Column="3" Text="{Binding Resumen.SubtotalMaterialesDisplay}" FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Right" Padding="6,5"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#263238" BorderThickness="1" Background="#FAFAFA" Padding="6,7">
                            <TextBlock Text="SUMINISTROS DE ASEO Y LIMPIEZA" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding AseoLimpieza}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="None" GridLinesVisibility="All"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                                  RowHeight="24" BorderBrush="#263238" BorderThickness="1,0,1,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding CantidadDisplay}" Width="90"/>
                                <DataGridTextColumn Binding="{Binding Concepto}" Width="*" MinWidth="240"/>
                                <DataGridTextColumn Binding="{Binding ValorUnitarioDisplay}" Width="140"/>
                                <DataGridTextColumn Binding="{Binding ValorMensualDisplay}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border BorderBrush="#263238" BorderThickness="1" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="TOTAL" FontWeight="Bold" FontSize="15" Padding="6,5"/>
                                <TextBlock Grid.Column="3" Text="{Binding Resumen.SubtotalAseoDisplay}" FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Right" Padding="6,5"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#263238" BorderThickness="1" Background="#FAFAFA" Padding="6,7">
                            <TextBlock Text="ACCESORIOS Y MATERIALES" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding AccesoriosMateriales}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="None" GridLinesVisibility="All"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                                  RowHeight="24" BorderBrush="#263238" BorderThickness="1,0,1,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding CantidadDisplay}" Width="90"/>
                                <DataGridTextColumn Binding="{Binding Concepto}" Width="*" MinWidth="240"/>
                                <DataGridTextColumn Binding="{Binding ValorUnitarioDisplay}" Width="140"/>
                                <DataGridTextColumn Binding="{Binding ValorMensualDisplay}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border BorderBrush="#263238" BorderThickness="1" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="TOTAL" FontWeight="Bold" FontSize="15" Padding="6,5"/>
                                <TextBlock Grid.Column="3" Text="{Binding Resumen.SubtotalAccesoriosDisplay}" FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Right" Padding="6,5"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#1A237E" BorderThickness="1" Background="#EEF2FF" Padding="10,8" Margin="0,2,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="TOTAL MENSUAL" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Resumen.TotalMensualDisplay}"
                                           FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Resumen.MesesCapitalTrabajo, StringFormat=CAPITAL DE TRABAJO ({0} meses)}"
                                           FontWeight="Bold" FontSize="15" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Resumen.TotalCapitalTrabajoDisplay}"
                                           FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
