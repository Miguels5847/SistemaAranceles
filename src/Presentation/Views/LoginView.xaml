<Window x:Class="SistemaAranceles.Presentation.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Aranceles — Iniciar Sesión"
        Height="420" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FB">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Sistema de Aranceles"
                   FontSize="22" FontWeight="Bold" Foreground="#1A237E"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1" Text="Iniciar Sesión"
                   FontSize="14" Foreground="#5C6BC0"
                   HorizontalAlignment="Center" Margin="0,0,0,24"/>

        <!-- Correo -->
        <TextBlock Grid.Row="2" Text="Correo institucional" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3"
                 Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" Padding="8,6"
                 BorderBrush="#9FA8DA" BorderThickness="1"
                 Margin="0,0,0,16"/>

        <!-- Contraseña -->
        <TextBlock Grid.Row="4" Text="Contraseña" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="5"
                     FontSize="14" Padding="8,6"
                     BorderBrush="#9FA8DA" BorderThickness="1"
                     PasswordChanged="PasswordBox_PasswordChanged"
                     Margin="0,0,0,20"/>

        <StackPanel Grid.Row="6">
            <!-- Error -->
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C62828" FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"
                       Margin="0,0,0,10"/>

            <!-- Botón login -->
            <Button Content="Ingresar"
                    Command="{Binding LoginCommand}"
                    FontSize="14" FontWeight="Bold"
                    Background="#3949AB" Foreground="White"
                    BorderThickness="0" Padding="0,10"
                    Cursor="Hand"/>

            <!-- Cargando -->
            <TextBlock Text="Verificando credenciales..."
                       HorizontalAlignment="Center" Foreground="#5C6BC0"
                       FontSize="12" Margin="0,8,0,0"
                       Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</Window>
