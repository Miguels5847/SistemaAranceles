<UserControl x:Class="SistemaAranceles.Presentation.Views.InversionInicial.InversionInicialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Inversión Inicial Total"
                   FontSize="18" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Text="{Binding MensajeError}" Foreground="#C62828" FontWeight="SemiBold"
                   Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"
                   Margin="0,0,0,8"/>

        <!-- Tabla resumen estilo balance -->
        <Border Grid.Row="2" BorderBrush="#C5CAE9" BorderThickness="1" CornerRadius="6" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- encabezado -->
                    <RowDefinition Height="Auto"/>
                    <!-- A: Activos diferidos -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- B: Activos fijos -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- C: Capital de trabajo -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- D: Imprevistos -->
                    <RowDefinition Height="Auto"/>
                    <!-- Total -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <!-- Encabezado -->
                <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#1A237E" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Componente" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="Subtotal" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="Total" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Activos Diferidos -->
                <TextBlock Grid.Row="1" Grid.Column="1" Text="A. Activos Diferidos (permisos legales)"
                           FontWeight="SemiBold" Foreground="#1A237E" Margin="8,6,0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Permisos municipales y bomberos" Margin="24,2,0,4" Foreground="#546E7A"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Inversion.ActivosDiferidosDisplay, FallbackValue='—'}"
                           HorizontalAlignment="Right" Margin="0,2,8,4" Foreground="#546E7A"/>

                <!-- Activos Fijos -->
                <Border Grid.Row="3" Grid.ColumnSpan="4" Background="#F8F9FF" Height="1" Margin="8,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="B. Activos Fijos"
                           FontWeight="SemiBold" Foreground="#1A237E" Margin="8,6,0,2"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="Muebles y Enseres" Margin="24,2,0,2" Foreground="#546E7A"/>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Inversion.MueblesDisplay, FallbackValue='—'}"
                           HorizontalAlignment="Right" Margin="0,2,8,2" Foreground="#546E7A"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="Laboratorios y Equipos" Margin="24,2,0,2" Foreground="#546E7A"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Inversion.LaboratoriosDisplay, FallbackValue='—'}"
                           HorizontalAlignment="Right" Margin="0,2,8,2" Foreground="#546E7A"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="Equipo de Cómputo" Margin="24,2,0,2" Foreground="#546E7A"/>
                <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding Inversion.EquipoComputoDisplay, FallbackValue='—'}"
                           HorizontalAlignment="Right" Margin="0,2,8,2" Foreground="#546E7A"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="Equipo de Oficina" Margin="24,2,0,2" Foreground="#546E7A"/>
                <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding Inversion.EquipoOficinaDisplay, FallbackValue='—'}"
                           HorizontalAlignment="Right" Margin="0,2,8,4" Foreground="#546E7A"/>
                <TextBlock Grid.Row="8" Grid.Column="3" Text="{Binding Inversion.SubtotalActivosFijosDisplay, FallbackValue='—'}"
                           HorizontalAlignment="Right" Margin="0,2,8,4" FontWeight="SemiBold"/>

                <!-- Capital de Trabajo -->
                <Border Grid.Row="9" Grid.ColumnSpan="4" Background="#F8F9FF" Height="1" Margin="8,0"/>
                <TextBlock Grid.Row="10" Grid.Column="1" Text="C. Capital de Trabajo (2 meses)"
                           FontWeight="SemiBold" Foreground="#1A237E" Margin="8,6,0,2"/>
                <TextBlock Grid.Row="10" Grid.Column="3" Text="{Binding Inversion.CapitalTrabajoDisplay, FallbackValue='—'}"
                           HorizontalAlignment="Right" Margin="0,6,8,2" FontWeight="SemiBold"/>

                <!-- Imprevistos -->
                <Border Grid.Row="11" Grid.ColumnSpan="4" Background="#F8F9FF" Height="1" Margin="8,0"/>
                <TextBlock Grid.Row="12" Grid.Column="1" Text="D. Imprevistos (5%)"
                           FontWeight="SemiBold" Foreground="#1A237E" Margin="8,6,0,6"/>
                <TextBlock Grid.Row="12" Grid.Column="3" Text="{Binding Inversion.ImprevistosDisplay, FallbackValue='—'}"
                           HorizontalAlignment="Right" Margin="0,6,8,6" FontWeight="SemiBold"/>

                <!-- Total -->
                <Border Grid.Row="13" Grid.ColumnSpan="4" Background="#1A237E" Padding="8,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="TOTAL INVERSIÓN INICIAL" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Grid.Column="3" Text="{Binding Inversion.TotalInversionDisplay, FallbackValue='—'}"
                                   Foreground="#FFD54F" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
