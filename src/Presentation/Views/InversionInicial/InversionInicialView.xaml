<UserControl x:Class="SistemaAranceles.Presentation.Views.InversionInicial.InversionInicialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:SistemaAranceles.Presentation.Views.Compartido"
             Height="Auto"
             Width="Auto">
    <UserControl.Resources>
        <DataTemplate x:Key="CategoriaActivoTemplate">
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1"
                               Text="{Binding CategoriaNombre}"
                               Margin="24,5,8,5"
                               Foreground="#455A64"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding ValorDisplay}"
                               HorizontalAlignment="Right"
                               Margin="0,5,8,5"
                               Foreground="#455A64"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Inversión Inicial Total"
                       FontSize="18" FontWeight="Bold" Foreground="#1A237E"/>
            <comp:AyudaModulo Margin="10,0,0,0"
                              Titulo="Inversión Inicial"
                              Ingresar="Los activos y rubros necesarios para arrancar la carrera (equipos, infraestructura, diferidos)."
                              Resultados="El total de inversión inicial y su clasificación, que alimenta la depreciación y el flujo de caja."/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding MensajeError}"
                   Foreground="#C62828"
                   FontWeight="SemiBold"
                   Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="2"
                BorderBrush="#C5CAE9"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0"
                Visibility="{Binding TieneInversion, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Border Background="#1A237E" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Tipo de Inversión" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="Valor" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="Monto total" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="#F8F9FF">
                    <Grid MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="A. Activos Diferidos" FontWeight="SemiBold" Foreground="#1A237E" Margin="8,7,8,7"/>
                        <TextBlock Grid.Column="3" Text="{Binding Inversion.ActivosDiferidosDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,7,8,7"/>
                    </Grid>
                </Border>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <Grid MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Permisos municipales y bomberos" Margin="24,5,8,5" Foreground="#455A64"/>
                        <TextBlock Grid.Column="2" Text="{Binding Inversion.ActivosDiferidosDisplay}" HorizontalAlignment="Right" Margin="0,5,8,5" Foreground="#455A64"/>
                    </Grid>
                </Border>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="#F8F9FF">
                    <Grid MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="B. Activos Fijos" FontWeight="SemiBold" Foreground="#1A237E" Margin="8,7,8,7"/>
                        <TextBlock Grid.Column="3" Text="{Binding Inversion.SubtotalActivosFijosDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,7,8,7"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Inversion.CategoriasActivosFijos}"
                              ItemTemplate="{StaticResource CategoriaActivoTemplate}"/>

                <Border BorderBrush="#B0BEC5" BorderThickness="0,1,0,1" Background="#FAFAFA">
                    <Grid MinHeight="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="TOTAL ACTIVOS" FontWeight="Bold" Foreground="#0D47A1" Margin="8,8,8,8"/>
                        <TextBlock Grid.Column="3" Text="{Binding Inversion.TotalActivosDisplay}" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,8,8,8"/>
                    </Grid>
                </Border>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <Grid MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Inversion.MesesCapitalTrabajo, StringFormat=C. Capital de Trabajo ({0} meses)}"
                                   FontWeight="SemiBold"
                                   Foreground="#1A237E"
                                   Margin="8,7,8,7"/>
                        <TextBlock Grid.Column="2" Text="{Binding Inversion.CapitalTrabajoDisplay}" HorizontalAlignment="Right" Margin="0,7,8,7"/>
                    </Grid>
                </Border>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <Grid MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Inversion.PorcentajeImprevistosInversionDisplay, StringFormat=D. Imprevistos ({0})}"
                                   FontWeight="SemiBold"
                                   Foreground="#1A237E"
                                   Margin="8,7,8,7"/>
                        <TextBlock Grid.Column="2" Text="{Binding Inversion.ImprevistosDisplay}" HorizontalAlignment="Right" Margin="0,7,8,7"/>
                    </Grid>
                </Border>

                <Border Background="#1A237E" Padding="8,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="TOTAL INVERSION INICIAL" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Inversion.TotalInversionDisplay}"
                                   Foreground="#FFD54F"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
