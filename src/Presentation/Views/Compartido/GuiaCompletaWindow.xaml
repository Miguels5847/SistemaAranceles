<Window x:Class="SistemaAranceles.Presentation.Views.Compartido.GuiaCompletaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guía completa — de la carrera al reporte"
        Width="860" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FB">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Guía completa: de la creación de la carrera al reporte final"
                       FontSize="20" FontWeight="Bold" Foreground="#1A237E"/>
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#37474F" Margin="0,6,0,0"
                       Text="Sigue estos 9 pasos en orden (el menú lateral está numerado igual). Los módulos Sueldos, Planta Central, Amortización, Datos Institucionales, Catálogos, Usuarios y Auditoría los configura el administrador: no necesitas tocarlos."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListaPasos">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#C5CAE9" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="0,0,6,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                        Background="#1A237E" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Numero}" Foreground="White" FontWeight="Bold"
                                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="#1A237E"
                                               Text="{Binding Modulo}"/>
                                    <TextBlock FontSize="11" Foreground="#7986CB" Margin="0,1,0,6"
                                               Text="{Binding Ubicacion}"/>

                                    <TextBlock Text="Qué hacer (botón por botón)" FontSize="11.5"
                                               FontWeight="SemiBold" Foreground="#283593"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#263238"
                                               Margin="0,2,0,8" Text="{Binding Acciones}"/>

                                    <TextBlock Text="Por qué importa" FontSize="11.5"
                                               FontWeight="SemiBold" Foreground="#2E7D32"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#37474F"
                                               Margin="0,2,0,8" Text="{Binding PorQue}"/>

                                    <Border Background="#E8F5E9" CornerRadius="6" Padding="8,5">
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#1B5E20">
                                            <Run Text="✔ Este paso está listo cuando: " FontWeight="SemiBold"/><Run Text="{Binding ListoCuando}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
