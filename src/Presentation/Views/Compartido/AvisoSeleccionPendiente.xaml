<UserControl x:Class="SistemaAranceles.Presentation.Views.Compartido.AvisoSeleccionPendiente"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             IsHitTestVisible="False">
    <!-- Estado vacío guiado (KAN-49): se superpone a la zona de contenido y solo aparece
         cuando aún no hay escenario elegido (hereda el DataContext del módulo). -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding EscenarioSeleccionado}" Value="{x:Null}"/>
                        <Condition Binding="{Binding EstaCargando}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75">
        <iconPacks:PackIconMaterial Kind="CursorDefaultClickOutline"
                                    Width="34" Height="34"
                                    Foreground="#7986CB"
                                    HorizontalAlignment="Center"/>
        <TextBlock Text="Selecciona la carrera y el escenario para comenzar"
                   Margin="0,10,0,0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#546E7A"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Los resultados se calculan al elegir un escenario con proyección."
                   Margin="0,4,0,0"
                   FontSize="11"
                   Foreground="#90A4AE"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
