<UserControl x:Class="SistemaAranceles.Presentation.Views.Auditoria.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Audit Log - Acciones Críticas"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1A237E"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                BorderBrush="#C5CAE9"
                BorderThickness="1"
                CornerRadius="6"
                Background="#FAFBFF"
                Padding="12"
                Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal"
                       ItemHeight="54"
                       VerticalAlignment="Top">
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="Usuario (ID)"
                               FontSize="12"
                               Margin="0,0,0,3"/>
                    <TextBox Width="110"
                             Height="28"
                             Text="{Binding UsuarioFiltro, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="Desde"
                               FontSize="12"
                               Margin="0,0,0,3"/>
                    <DatePicker Width="130"
                                Height="28"
                                SelectedDate="{Binding FechaDesde}"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="Hasta"
                               FontSize="12"
                               Margin="0,0,0,3"/>
                    <DatePicker Width="130"
                                Height="28"
                                SelectedDate="{Binding FechaHasta}"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="Módulo"
                               FontSize="12"
                               Margin="0,0,0,3"/>
                    <ComboBox Width="140"
                              Height="28"
                              ItemsSource="{Binding ModulosDisponibles}"
                              SelectedItem="{Binding ModuloFiltro}"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="Acción"
                               FontSize="12"
                               Margin="0,0,0,3"/>
                    <ComboBox Width="150"
                              Height="28"
                              ItemsSource="{Binding AccionesDisponibles}"
                              SelectedItem="{Binding AccionFiltro}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="0,18,0,6">
                    <Button Content="Buscar"
                            Command="{Binding BuscarCommand}"
                            Background="#3949AB"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="12,6"
                            Margin="0,0,8,0"/>
                    <Button Content="Limpiar"
                            Command="{Binding LimpiarFiltrosCommand}"
                            Padding="12,6"
                            BorderBrush="#9FA8DA"
                            BorderThickness="1"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C62828"
                       VerticalAlignment="Center"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Registros}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#C5CAE9"
                  AlternatingRowBackground="#F8F9FF"
                  EnableRowVirtualization="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background"
                            Value="White"/>
                    <Setter Property="Foreground"
                            Value="#1A237E"/>
                    <Setter Property="SnapsToDevicePixels"
                            Value="True"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                Value="True">
                            <Setter Property="Background"
                                    Value="#E8EAF6"/>
                        </Trigger>
                        <Trigger Property="IsSelected"
                                Value="True">
                            <Setter Property="Background"
                                    Value="#C5CAE9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha"
                                    Binding="{Binding EventoEnUtc, StringFormat=\{0:dd/MM/yyyy HH:mm:ss\}}"
                                    Width="170"/>
                <DataGridTextColumn Header="Usuario"
                                    Binding="{Binding EjecutadoPorUsuarioNombre}"
                                    Width="170"/>
                <DataGridTextColumn Header="UsuarioId"
                                    Binding="{Binding EjecutadoPorUsuarioId}"
                                    Width="85"/>
                <DataGridTextColumn Header="Módulo"
                                    Binding="{Binding ModuloNombre}"
                                    Width="120"/>
                <DataGridTextColumn Header="Acción"
                                    Binding="{Binding AccionNombre}"
                                    Width="130"/>
                <DataGridTextColumn Header="Entidad"
                                    Binding="{Binding EntidadNombre}"
                                    Width="120"/>
                <DataGridTextColumn Header="EntidadId"
                                    Binding="{Binding EntidadId}"
                                    Width="100"/>
                <DataGridTextColumn Header="Resumen"
                                    Binding="{Binding ResumenTexto}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Anterior"
                    Command="{Binding PaginaAnteriorCommand}"
                    IsEnabled="{Binding PuedeIrPaginaAnterior}"
                    Padding="10,6"
                    Margin="0,0,8,0"/>

            <Button Grid.Column="1"
                    Content="Siguiente"
                    Command="{Binding PaginaSiguienteCommand}"
                    IsEnabled="{Binding PuedeIrPaginaSiguiente}"
                    Padding="10,6"/>

            <TextBlock Grid.Column="2"
                       Text="{Binding ResumenPaginacion}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#1A237E"/>

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Registros/página"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <ComboBox Width="70"
                          SelectedValue="{Binding TamanoPagina}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="10"
                                  Tag="10"/>
                    <ComboBoxItem Content="25"
                                  Tag="25"
                                  IsSelected="True"/>
                    <ComboBoxItem Content="50"
                                  Tag="50"/>
                    <ComboBoxItem Content="100"
                                  Tag="100"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3"
              Background="#55000000"
              Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="300"
                    Padding="16"
                    CornerRadius="8"
                    Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Consultando auditoría..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1A237E"
                               TextAlignment="Center"
                               Margin="0,0,0,12"/>
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Foreground="#3949AB"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
