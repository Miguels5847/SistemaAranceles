<UserControl x:Class="SistemaAranceles.Presentation.Views.Usuarios.EditarUsuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" MaxWidth="560">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Titulo}"
                       FontSize="20" FontWeight="Bold" Foreground="#1A237E"
                       Margin="0,0,0,20"/>

            <!-- Nombre -->
            <TextBlock Grid.Row="1" Text="Nombre Completo *" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Grid.Row="2" Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13" Padding="8,6" BorderBrush="#9FA8DA"
                     Margin="0,0,0,14"/>

            <!-- Correo -->
            <TextBlock Grid.Row="3" Text="Correo Institucional *" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Grid.Row="4" Text="{Binding CorreoInstitucional, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13" Padding="8,6" BorderBrush="#9FA8DA"
                     Margin="0,0,0,14"/>

            <!-- Contraseña -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Contraseña *" FontWeight="SemiBold"/>
                <TextBlock Text=" (dejar vacío para mantener la actual)" Foreground="#757575" FontSize="11"
                           VerticalAlignment="Center" Margin="4,0,0,0"
                           Visibility="{Binding EsNuevo, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </StackPanel>
            <PasswordBox x:Name="PwdBox" Grid.Row="6"
                         FontSize="13" Padding="8,6" BorderBrush="#9FA8DA"
                         PasswordChanged="PwdBox_PasswordChanged"
                         Margin="0,0,0,14"/>

            <!-- Rol -->
            <TextBlock Grid.Row="7" Text="Rol *" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox Grid.Row="8"
                      ItemsSource="{Binding Roles}"
                      SelectedValuePath="Nombre"
                      DisplayMemberPath="Nombre"
                      SelectedValue="{Binding RolSeleccionado}"
                      FontSize="13" Padding="8,6"
                      Margin="0,0,0,14"/>

            <!-- Estado (solo edición) -->
            <StackPanel Grid.Row="9" Margin="0,0,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EsNuevo}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Estado" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Estados}"
                          SelectedItem="{Binding EstadoSeleccionado}"
                          FontSize="13" Padding="8,6"
                          Margin="0,0,0,14"/>
            </StackPanel>

            <!-- Mensajes y botón -->
            <StackPanel>
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="#C62828" FontSize="12" TextWrapping="Wrap"
                           Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding MensajeExito}"
                           Foreground="#2E7D32" FontSize="12" TextWrapping="Wrap"
                           Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"
                           Margin="0,0,0,8"/>
                <Button Content="Guardar"
                        Command="{Binding GuardarCommand}"
                        FontSize="13" FontWeight="Bold"
                        Background="#3949AB" Foreground="White"
                        BorderThickness="0" Padding="20,8"
                        HorizontalAlignment="Left" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
