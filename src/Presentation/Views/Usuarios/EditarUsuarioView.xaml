<UserControl x:Class="SistemaAranceles.Presentation.Views.Usuarios.EditarUsuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado con botón Volver -->
        <Grid Grid.Row="0"
                Margin="24,16,24,0"
                >
            <Button Content="← Volver"
                    Command="{Binding DataContext.MostrarUsuariosCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Foreground="#0277BD"
                    FontSize="12"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="0"/>
        </Grid>

        <!-- Contenido principal -->
        <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
            <Grid Margin="24"
                  MaxWidth="560">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Titulo}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1A237E"
                           Margin="0,0,0,20"/>

                <!-- Nombre -->
                <TextBlock Grid.Row="1"
                           Text="Nombre Completo *"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox Grid.Row="2"
                         Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         Padding="8,6"
                         BorderBrush="#9FA8DA"
                         IsEnabled="{Binding IsCargandoDatos, Converter={StaticResource InverseBoolConverter}}"
                         Margin="0,0,0,14"/>

                <!-- Correo -->
                <TextBlock Grid.Row="3"
                           Text="Correo Institucional *"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox Grid.Row="4"
                         Text="{Binding CorreoInstitucional, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         Padding="8,6"
                         BorderBrush="#9FA8DA"
                         IsEnabled="{Binding IsCargandoDatos, Converter={StaticResource InverseBoolConverter}}"
                         Margin="0,0,0,14"/>

                <!-- Contraseña -->
                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            Margin="0,0,0,4">
                    <TextBlock Text="Contraseña *"
                               FontWeight="SemiBold"/>
                    <TextBlock Text=" (dejar vacío para mantener la actual)"
                               Foreground="#757575"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"
                               Visibility="{Binding EsNuevo, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </StackPanel>
                <PasswordBox x:Name="PwdBox"
                             Grid.Row="6"
                             FontSize="13"
                             Padding="8,6"
                             BorderBrush="#9FA8DA"
                             IsEnabled="{Binding IsCargandoDatos, Converter={StaticResource InverseBoolConverter}}"
                             PasswordChanged="PwdBox_PasswordChanged"
                             Margin="0,0,0,14"/>

                <!-- Rol -->
                <TextBlock Grid.Row="7"
                           Text="Rol *"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ComboBox Grid.Row="8"
                          ItemsSource="{Binding Roles}"
                          SelectedValuePath="Nombre"
                          DisplayMemberPath="Nombre"
                          SelectedValue="{Binding RolSeleccionado}"
                          FontSize="13"
                          Padding="8,6"
                          IsEnabled="{Binding IsCargandoDatos, Converter={StaticResource InverseBoolConverter}}"
                          Margin="0,0,0,14"/>

                <!-- Estado (solo edición) -->
                <StackPanel Grid.Row="9"
                            Margin="0,0,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsNuevo}"
                                             Value="False">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Estado"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Estados}"
                              SelectedItem="{Binding EstadoSeleccionado}"
                              FontSize="13"
                              Padding="8,6"
                              IsEnabled="{Binding IsCargandoDatos, Converter={StaticResource InverseBoolConverter}}"
                              Margin="0,0,0,14"/>
                </StackPanel>

                <!-- Permisos de Acceso por Módulo (solo edición) -->
                <StackPanel Grid.Row="10"
                            Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsNuevo}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Separator Margin="0,4,0,12"/>

                    <TextBlock Text="Permisos de Acceso por Módulo"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1A237E"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="Estos permisos anulan los del rol base para este usuario específico."
                               FontSize="11"
                               Foreground="#757575"
                               Margin="0,0,0,10"/>

                    <!-- Estado: cargando permisos -->
                    <TextBlock Text="Cargando permisos..."
                               Foreground="#757575"
                               FontSize="12"
                               Visibility="{Binding IsCargandoPermisos, Converter={StaticResource BoolToVisibilityConverter}}"
                               Margin="0,0,0,8"/>

                    <!-- Sin permisos configurados -->
                    <TextBlock Foreground="#9E9E9E"
                               FontSize="12"
                               FontStyle="Italic"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCargandoPermisos}" Value="False"/>
                                            <Condition Binding="{Binding ModulosPermisos.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        No hay permisos configurados en el sistema. Ejecute el SQL de seed de permisos para habilitarlos.
                    </TextBlock>

                    <!-- Lista de módulos con checkboxes -->
                    <ItemsControl ItemsSource="{Binding ModulosPermisos}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCargandoPermisos}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <!-- Cabecera del módulo -->
                                    <Border Background="#E8EAF6"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,0,4">
                                        <TextBlock Text="{Binding ModuloNombre}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="#3949AB"/>
                                    </Border>
                                    <!-- Checkboxes de permisos del módulo -->
                                    <ItemsControl ItemsSource="{Binding Permisos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding TieneAcceso, Mode=TwoWay}"
                                                          Margin="10,2,0,2"
                                                          FontSize="12">
                                                    <CheckBox.Content>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding AccionNombre}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text=" (rol base)"
                                                                       FontSize="10"
                                                                       Foreground="#9E9E9E"
                                                                       VerticalAlignment="Center"
                                                                       Margin="4,0,0,0"
                                                                       Visibility="{Binding EsDeRolBase, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                    </CheckBox.Content>
                                                    <CheckBox.ToolTip>
                                                        <TextBlock Text="{Binding Descripcion}"/>
                                                    </CheckBox.ToolTip>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Mensajes y botón -->
                <StackPanel Grid.Row="11">
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="#C62828"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding MensajeExito}"
                               Foreground="#2E7D32"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal"
                            >
                        <Button Content="Guardar"
                                Command="{Binding GuardarCommand}"
                                FontSize="13"
                                FontWeight="Bold"
                                Background="#3949AB"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="20,8"
                                IsEnabled="{Binding IsCargandoDatos, Converter={StaticResource InverseBoolConverter}}"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay: Cargando datos del usuario -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="#88000000"
                Visibility="{Binding IsCargandoDatos, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Grid>
                <Border Width="320"
                        Padding="20"
                        CornerRadius="12"
                        Background="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="⟳"
                                   FontSize="32"
                                   Foreground="#0277BD"
                                   TextAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="Cargando datos del usuario..."
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"
                                   TextAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="6"
                                     Foreground="#0277BD"
                                     Background="#E1F5FE"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Loading Overlay: Guardando usuario -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="#88000000"
                Visibility="{Binding EstaGuardando, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Grid>
                <Border Width="320"
                        Padding="20"
                        CornerRadius="12"
                        Background="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="⟳"
                                   FontSize="32"
                                   Foreground="#3949AB"
                                   TextAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="Guardando usuario..."
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"
                                   TextAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="6"
                                     Foreground="#3949AB"
                                     Background="#E8EAF6"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>




