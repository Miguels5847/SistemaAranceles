<UserControl x:Class="SistemaAranceles.Presentation.Views.CostosGastos.CostosGastosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#263238"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MatrizRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsEncabezadoGrupo}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#C5CAE9"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding EsTotal}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#EEF2FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelResumen" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FF"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Costos y Gastos"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1A237E"/>
            <TextBlock Text="Inv. Vin. Becas, Costos y Gastos, y Costo de la Carrera"
                       FontSize="12"
                       Foreground="#546E7A"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D8DCE8"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Carrera" FontSize="11" Foreground="#546E7A"/>
                    <ComboBox ItemsSource="{Binding Carreras}"
                              SelectedItem="{Binding CarreraSeleccionada, Mode=TwoWay}"
                              DisplayMemberPath="Nombre"
                              MinWidth="220"
                              Padding="4,2"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Escenario" FontSize="11" Foreground="#546E7A"/>
                    <ComboBox ItemsSource="{Binding Escenarios}"
                              SelectedItem="{Binding EscenarioSeleccionado, Mode=TwoWay}"
                              DisplayMemberPath="NombreDisplay"
                              MinWidth="220"
                              Padding="4,2"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="Refrescar"
                        Padding="10,4"
                        VerticalAlignment="Bottom"
                        Command="{Binding RefrescarCommand}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="{Binding MensajeExito}"
                       Foreground="#2E7D32"
                       FontWeight="SemiBold"
                       Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C62828"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <TabControl Grid.Row="3">
            <TabItem Header="1. Inv. Vin. Becas">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,8">
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Total Inv. Vin. Becas" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding MatrizInvVinBecas.TotalGeneralDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"
                                           Foreground="#1A237E"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Escenario" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding MatrizInvVinBecas.EscenarioNombre, FallbackValue='-'}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <DataGrid x:Name="InvVinBecasGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding FilasInvVinBecas}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowStyle="{StaticResource MatrizRowStyle}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FF"
                              BorderBrush="#C5CAE9"/>
                </Grid>
            </TabItem>

            <TabItem Header="2. Costos y Gastos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Border Style="{StaticResource PanelResumen}">
                                <StackPanel>
                                    <TextBlock Text="Total costos y gastos" FontSize="11" Foreground="#546E7A"/>
                                    <TextBlock Text="{Binding MatrizCostosGastos.TotalGeneralDisplay, FallbackValue='$ 0.00'}"
                                               FontWeight="Bold"
                                               Foreground="#1A237E"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelResumen}">
                                <StackPanel>
                                    <TextBlock Text="Total descontado becas gobierno" FontSize="11" Foreground="#546E7A"/>
                                    <TextBlock Text="{Binding MatrizCostosGastos.TotalGeneralDescontadoDisplay, FallbackValue='$ 0.00'}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="ProyecciÃ³n de Costos y Gastos"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <DataGrid x:Name="CostosGastosGrid"
                                  ItemsSource="{Binding FilasCostosGastos}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowStyle="{StaticResource MatrizRowStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8F9FF"
                                  BorderBrush="#C5CAE9"
                                  MinHeight="220"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="PonderaciÃ³n"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <DataGrid x:Name="PonderacionGrid"
                                  ItemsSource="{Binding FilasPonderacion}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowStyle="{StaticResource MatrizRowStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8F9FF"
                                  BorderBrush="#C5CAE9"
                                  MinHeight="180"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="Descontado presupuesto asignado por el gobierno para becas"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <DataGrid x:Name="DescontadoGrid"
                                  ItemsSource="{Binding FilasDescontadas}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowStyle="{StaticResource MatrizRowStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8F9FF"
                                  BorderBrush="#C5CAE9"
                                  MinHeight="220"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="3. Costo de la Carrera">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Costo total carrera" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding ResultadoCostoCarrera.CostoCarreraCompletaDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"
                                           Foreground="#1A237E"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Arancel sugerido semestre" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding ResultadoCostoCarrera.ArancelSugeridoDisplay, FallbackValue='Pendiente'}"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="MatrÃ­cula sugerida" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding ResultadoCostoCarrera.MatriculaSugeridaDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelResumen}">
                            <StackPanel>
                                <TextBlock Text="Total por semestre" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding ResultadoCostoCarrera.TotalPorSemestreDisplay, FallbackValue='$ 0.00'}"
                                           FontWeight="Bold"
                                           Foreground="#1A237E"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <DataGrid x:Name="CostoCarreraGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding CostoCarreraFilas}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowStyle="{StaticResource MatrizRowStyle}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FF"
                              BorderBrush="#C5CAE9"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
