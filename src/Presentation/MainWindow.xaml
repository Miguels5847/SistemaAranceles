<Window x:Class="SistemaAranceles.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SistemaAranceles.Presentation.ViewModels"
        xmlns:vmU="clr-namespace:SistemaAranceles.Presentation.ViewModels.Usuarios"
        xmlns:vmA="clr-namespace:SistemaAranceles.Presentation.ViewModels.Auditoria"
        xmlns:vmC="clr-namespace:SistemaAranceles.Presentation.ViewModels.Carreras"
        xmlns:vmI="clr-namespace:SistemaAranceles.Presentation.ViewModels.Inflacion"
        xmlns:vmT="clr-namespace:SistemaAranceles.Presentation.ViewModels.TasaRetencion"
        xmlns:vmE="clr-namespace:SistemaAranceles.Presentation.ViewModels.Estudiantes"
        xmlns:vU="clr-namespace:SistemaAranceles.Presentation.Views.Usuarios"
        xmlns:vA="clr-namespace:SistemaAranceles.Presentation.Views.Auditoria"
        xmlns:vC="clr-namespace:SistemaAranceles.Presentation.Views.Carreras"
        xmlns:vI="clr-namespace:SistemaAranceles.Presentation.Views.Inflacion"
        xmlns:vT="clr-namespace:SistemaAranceles.Presentation.Views.TasaRetencion"
        xmlns:vE="clr-namespace:SistemaAranceles.Presentation.Views.Estudiantes"
        Title="Sistema de Aranceles Universitarios"
        Width="1400"
        Height="820"
        MinWidth="1200"
        MinHeight="700"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FB">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vmU:UsuariosViewModel}">
            <vU:UsuariosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmU:EditarUsuarioViewModel}">
            <vU:EditarUsuarioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmA:AuditoriaViewModel}">
            <vA:AuditoriaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmC:CarrerasViewModel}">
            <vC:CarrerasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmI:InflacionViewModel}">
            <vI:InflacionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmT:ConfiguracionRetencionViewModel}">
            <vT:ConfiguracionRetencionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmE:EstudiantesViewModel}">
            <vE:EstudiantesView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#1A237E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header con nombre usuario y COUNTDOWN de sesión -->
                <StackPanel Grid.Row="0"
                            Margin="16,20,16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Aranceles"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding NombreUsuario}"
                                       FontSize="11"
                                       Foreground="#9FA8DA"
                                       TextWrapping="Wrap"/>
                            <Border Background="#283593"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding RolUsuario}"
                                           FontSize="10"
                                           Foreground="#90CAF9"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Countdown de sesión -->
                        <Border Grid.Column="1"
                                Background="#C62828"
                                CornerRadius="4"
                                Padding="10,6"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Sesion"
                                           FontSize="9"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding TiempoRestanteSesion}"
                                           FontSize="14"
                                           Foreground="#FFEB3B"
                                           FontWeight="Bold"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Separator Grid.Row="0"
                           VerticalAlignment="Bottom"
                           Background="#283593"
                           Margin="0"/>

                <!-- Menú -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding MenuItems}"
                              Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Titulo}"
                                    Command="{Binding Comando}"
                                    Visibility="{Binding EsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontSize="13"
                                    Padding="20,10"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter Property="Background"
                                                                    Value="#283593"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Footer sidebar -->
                <TextBlock Grid.Row="2"
                           Text="{Binding Bienvenida}"
                           Foreground="#7986CB"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="16,8,16,16"/>
            </Grid>
        </Border>

        <!-- Área de contenido -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Mensaje de página placeholder -->
            <TextBlock Grid.Row="0"
                       Text="{Binding MensajePagina}"
                       FontSize="14"
                       Foreground="#5C6BC0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="20,12"
                       Visibility="{Binding MensajePagina, Converter={StaticResource StringToVisibilityConverter}}"/>

            <!-- Contenido dinámico -->
            <ContentControl Grid.Row="1"
                            Content="{Binding PaginaActual}"/>
        </Grid>

        <!-- Overlay de bloqueo durante cierre de sesión -->
        <Border Grid.ColumnSpan="2"
                Background="#66000000"
                Visibility="{Binding EstaCerrandoSesion, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="999">
            <Grid>
                <Border Width="320"
                        Padding="20"
                        CornerRadius="10"
                        Background="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding MensajeCierreSesion}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1A237E"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                        <ProgressBar IsIndeterminate="True"
                                     Height="8"
                                     Margin="0,0,0,8"
                                     Foreground="#3949AB"/>

                        <TextBlock Text="Espere un momento..."
                                   FontSize="12"
                                   Foreground="#5C6BC0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
